---
import "../styles/global.css";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <title>Mariana Calle Méndez — Portfolio</title>
  </head>

  <body>
    <Navbar />

    <main>
      <section class="hero">
        <div class="overlay"></div>
        <h1 class="hero-title">MARIANA<br />CALLE<br />MÉNDEZ</h1>
        <p class="hero-subtitle">Mechatronics Engineer</p>
      </section>

      <section class="intro">
        <h2>About Me</h2>
        <p>
         I am a Mechatronics Engineer driven by curiosity and a passion for
         understanding, designing, and building systems that connect the physical
         world with technology. I enjoy approaching problems from different
         perspectives, experimenting with ideas, and turning them into prototypes
         and functional solutions. My experience spans robotics, automation,
         control systems, embedded systems, artificial intelligence, mechanical
         design, and IoT, with a particular interest in robotics, transportation,
         mobility, autonomous systems, and product development.
        </p>
      </section>

      <section class="highlight">
        <h2>My Vision</h2>
        <p>
          I believe engineering is a way of turning curiosity into something tangible.
          By combining creativity, precision, and technology, I aim to design systems
          that are not only functional, but meaningful, sustainable, and connected
          to the people who use them.
        </p>
      </section>
    </main>

    <Footer />
  </body>
</html>
