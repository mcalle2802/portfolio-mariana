---
import "../../styles/global.css";
import Navbar from "../../components/Navbar.astro";
import Footer from "../../components/Footer.astro";

const experience = {
  company:
    "Empresa de Transporte Masivo del Valle de Aburrá Ltda - Metro de Medellín",
  position: "Intern",
  area: "Cable Car Systems Area — Electrical Group",
  location: "Medellín, Colombia",
  period: "2026",
};

const gallery = [
  {
    image: "/experience/metro1.jpeg",
    alt: "Experience at Metro de Medellín",
  },
  {
    image: "/experience/metro2.jpeg",
    alt: "Technical activity at Metro de Medellín",
  },
  {
    image: "/experience/metro3.jpeg",
    alt: "Cable car systems maintenance activity",
  },
  {
    image: "/experience/metro4.jpeg",
    alt: "Programming at Metro de Medellín",
  },
  {
    image: "/experience/metro5.jpeg",
    alt: "Field experience during the internship",
  },
  {
    image: "/experience/metro6.jpeg",
    alt: "Technical activity at Metro de Medellín",
  },
  {
    image: "/experience/metro7.jpeg",
    alt: "Field experience during the internship",
  },
];

/*
  ============================================================
  RECOMMENDATION LETTERS & EMPLOYMENT CERTIFICATION
  Cada PDF debe estar en /public/experience/letters/
  ============================================================
*/
const recommendationLetters = [
  {
    name: "Uriel Darío Jaramillo Castro",
    role: "Profesional 1, Área de Cables Aéreos",
    date: "August 19, 2026",
    file: "/experience/letters/letter-uriel-jaramillo.pdf",
    type: "Recommendation Letter",
  },
  {
    name: "Pedro Buitrago Bustamante",
    role: "Jefe de Cables Aéreos",
    date: "August 5, 2026",
    file: "/experience/letters/letter-pedro-buitrago.pdf",
    type: "Recommendation Letter",
  },
  {
    name: "Clara Inés Arenas Montoya",
    role: "Jefe Gestión del Talento Humano (E)",
    date: "August 26, 2026",
    file: "/experience/letters/employment-certification.pdf",
    type: "Employment Certification",
  },
];
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />

    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0"
    />

    <meta
      name="description"
      content="Professional experience of Mariana Calle Méndez at Metro de Medellín."
    />

    <title>Experience — Mariana Calle</title>
  </head>

  <body>

    <Navbar />

    <main class="experience-bg">

      <div class="experience-shell">

        <!-- =====================================================
             HEADER
        ====================================================== -->

        <section class="experience-header">

        <p class="section-label">
          PROFESSIONAL
        </p>

        <h1>
          EXPERIENCE
        </h1>

        <p class="experience-intro">
          My first professional experience gave me the opportunity
          to work closely with complex transportation systems,
          getting to know their maintenance processes, technical
          equipment, and real world data.
        </p>

        </section>


        <!-- =====================================================
             TIMELINE
        ====================================================== -->

        <section class="experience-timeline">

        <div class="timeline-line"></div>

        <article class="timeline-item">

          <!-- YEAR -->

          <div class="timeline-date">
            <div class="timeline-marker">
              <span></span>
            </div>

            <span>{experience.period}</span>
          </div>

          <!-- EXPERIENCE CARD: stays inside the same timeline item as the year -->

          <div class="experience-card">

            <!-- =================================================
                 CARD HEADER
            ================================================== -->

            <div class="experience-card-header">

              <div class="experience-heading">

                <p class="experience-company">
                  {experience.company}
                </p>

                <h2>
                  {experience.position}
                </h2>

                <p class="experience-area">
                  {experience.area}
                </p>

              </div>

              <p class="experience-location">
                {experience.location}
              </p>

            </div>


            <!-- =================================================
                 ABOUT
            ================================================== -->

            <div class="experience-section">

              <h3>
                About the Experience
              </h3>

              <p>
                During my internship in the Cable Car Systems Area
                at Metro de Medellín, I worked alongside the Electrical
                Group at the Acevedo station on Line K, supporting
                activities related to maintenance methods and time
                optimization.
              </p>

              <p>
                The experience allowed me to connect engineering
                analysis with real maintenance environments, working
                alongside technicians and professionals while
                learning how technical decisions, operational
                conditions, and data interact in a complex
                transportation system.
              </p>

            </div>


            <!-- =================================================
                 01
            ================================================== -->

            <div class="experience-section">

              <h3>
                <span>01</span>
                Understanding the System
              </h3>

              <p>
                One of the first stages of my internship was
                understanding how cable car systems operate and how
                their mechanical, electrical, and electromechanical
                components work together.
              </p>

              <p>
                I participated in technical training and tours of
                different cable car lines, gaining exposure to the
                operation and maintenance of these systems. I also
                learned about different inspection and diagnostic
                methods, including visual inspection, ultrasound,
                vibration analysis, and magnetic particle testing.
              </p>

              <div class="tags">

                <span>
                  Transportation Systems
                </span>

                <span>
                  Electromechanical Systems
                </span>

                <span>
                  Maintenance
                </span>

                <span>
                  Technical Inspection
                </span>

              </div>

            </div>


            <!-- =================================================
                 02
            ================================================== -->

            <div class="experience-section">

              <h3>
                <span>02</span>
                Working in the Field
              </h3>

              <p>
                Working directly in the field was one of the most
                valuable parts of the experience. I accompanied
                maintenance activities and observed how technicians
                approached real equipment, procedures, tools, and
                unexpected real-world conditions.
              </p>

              <p>
                I also participated in night maintenance activities,
                where I observed and recorded execution times while
                considering factors such as access, coordination,
                personnel, tools, operational restrictions, waiting
                times, and additional activities.
              </p>

              <p>
                This experience helped me understand that maintenance
                times are not determined only by the task itself, but
                also by the conditions surrounding its execution.
              </p>

              <div class="tags">

                <span>
                  Field Work
                </span>

                <span>
                  Maintenance Operations
                </span>

                <span>
                  Technical Observation
                </span>

                <span>
                  Process Understanding
                </span>

              </div>

            </div>


            <!-- =================================================
                 03
            ================================================== -->

            <div class="experience-section">

              <h3>
                <span>03</span>
                Maintenance Data Analysis
              </h3>

              <p>
                A central part of my internship project was analyzing
                historical maintenance records to evaluate the
                representativeness of the times used in maintenance
                route sheets.
              </p>

              <p>
                I worked with approximately three years of historical
                maintenance records from SAP and developed a
                Python-based computational tool to automate the
                processing of the data.
              </p>

              <p>
                The process included data cleaning, validation,
                consolidation, identification and treatment of
                outliers, and calculation of statistical indicators
                such as average, median, standard deviation, minimum
                and maximum values, and coefficient of variation.
              </p>

              <div class="tags">

                <span>Python</span>
                <span>SAP Data</span>
                <span>Data Cleaning</span>
                <span>Statistical Analysis</span>
                <span>Process Optimization</span>

              </div>

            </div>


            <!-- =================================================
                 STATISTICS
            ================================================== -->

            <div class="experience-stats">

              <div class="stat">

                <strong>
                  ~3
                </strong>

                <span>
                  Years of historical maintenance data
                </span>

              </div>


              <div class="stat">

                <strong>
                  706
                </strong>

                <span>
                  Initial records analyzed
                </span>

              </div>


              <div class="stat">

                <strong>
                  124
                </strong>

                <span>
                  Records remaining after validation and cleaning
                </span>

              </div>


              <div class="stat">

                <strong>
                  Python
                </strong>

                <span>
                  Computational analysis tool developed
                </span>

              </div>

            </div>


            <!-- =================================================
                 04
            ================================================== -->

            <div class="experience-section">

              <h3>
                <span>04</span>
                From Data to Maintenance Planning
              </h3>

              <p>
                The processed data was used to calculate reference
                times for maintenance operations and compare them
                with the times established in existing route sheets.
              </p>

              <p>
                Rather than treating the calculated values as
                automatic replacements, the results were reviewed
                against field observations and technical knowledge.
                This allowed differences and variability to be
                interpreted within the context of actual maintenance
                conditions.
              </p>

              <p>
                The analysis showed that factors such as equipment
                condition, corrective findings, operational
                restrictions, climate, access, and personnel
                availability can influence the duration of a
                maintenance activity.
              </p>


              <!-- PROCESS -->

              <div class="process-flow">

                <div class="process-step">
                  <strong>01</strong>
                  <span>Historical Data</span>
                </div>

                <div class="process-arrow">
                  →
                </div>

                <div class="process-step">
                  <strong>02</strong>
                  <span>Cleaning &amp; Validation</span>
                </div>

                <div class="process-arrow">
                  →
                </div>

                <div class="process-step">
                  <strong>03</strong>
                  <span>Statistical Analysis</span>
                </div>

                <div class="process-arrow">
                  →
                </div>

                <div class="process-step">
                  <strong>04</strong>
                  <span>Field Validation</span>
                </div>

                <div class="process-arrow">
                  →
                </div>

                <div class="process-step">
                  <strong>05</strong>
                  <span>Planning Support</span>
                </div>

              </div>

            </div>


            <!-- =================================================
                 05
            ================================================== -->

            <div class="experience-section learning-section">

              <h3>
                <span>05</span>
                What I Learned
              </h3>

              <p>
                This experience changed the way I understand
                engineering systems. Working with real transportation
                infrastructure showed me that engineering is not only
                about designing individual components, but also about
                understanding how people, equipment, procedures, data,
                and operational constraints interact.
              </p>

              <p>
                I learned to move between the field and the data:
                observing a physical system, understanding the work
                behind its maintenance, analyzing the information
                generated by that work, and using the results to
                support better decisions.
              </p>

              <blockquote>
                From data to the field, and from the field back to
                the data.
              </blockquote>

            </div>


            <!-- =================================================
                 06 — RECOMMENDATION LETTERS
            ================================================== -->

            <div class="experience-section">

              <h3>
                <span>06</span>
                References &amp; Certification
              </h3>

              <p>
                Letters written by the professionals I worked
                alongside during my internship, together with the
                official certification of my employment period.
              </p>

              <div class="letters-list">

                {
                  recommendationLetters.map((letter) => (
                    <a
                      class="letter-item"
                      href={letter.file}
                      target="_blank"
                      rel="noopener noreferrer"
                    >
                      <span class="letter-icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24" width="18" height="18">
                          <path
                            fill="currentColor"
                            d="M6 2h9l5 5v13a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2zm8 1.5V8h4.5L14 3.5zM8 13h8v1.5H8V13zm0 3h8v1.5H8V16zm0-6h4v1.5H8V10z"
                          />
                        </svg>
                      </span>

                      <span class="letter-info">
                        <span class="letter-name">
                          {letter.name}
                          <span class="letter-type">
                            {letter.type}
                          </span>
                        </span>

                        <span class="letter-role">
                          {letter.role} · {letter.date}
                        </span>
                      </span>

                      <span class="letter-cta">
                        View PDF ↗
                      </span>
                    </a>
                  ))
                }

              </div>

            </div>


            <!-- =================================================
                 GALLERY
            ================================================== -->

            <div class="experience-gallery-section">

              <h3>
                Project Gallery
              </h3>


              <div class="gallery-container">

                <div class="gallery-slider">

                  {
                    gallery.map((item, i) => (
                      <img
                        src={item.image}
                        alt={item.alt}
                        class:list={{
                          active: i === 0
                        }}
                        loading={
                          i === 0
                            ? "eager"
                            : "lazy"
                        }
                      />
                    ))
                  }

                </div>


                <button
                  class="gallery-btn prev"
                  type="button"
                  aria-label="Previous image"
                >
                  ❮
                </button>


                <button
                  class="gallery-btn next"
                  type="button"
                  aria-label="Next image"
                >
                  ❯
                </button>


                <div class="gallery-counter">

                  <span id="gallery-current">
                    1
                  </span>

                  /

                  <span>
                    {gallery.length}
                  </span>

                </div>

              </div>

            </div>

          </div>

        </article>

      </section>

    </main>


    <!-- =======================================================
         LIGHTBOX
    ======================================================== -->

    <div
      id="lightbox"
      class="lightbox"
      aria-hidden="true"
    >

      <button
        class="close"
        type="button"
        aria-label="Close image viewer"
      >
        &times;
      </button>


      <button
        class="lightbox-nav prev"
        type="button"
        aria-label="Previous image"
      >
        ❮
      </button>


      <img
        id="lightbox-img"
        class="lightbox-content"
        src=""
        alt=""
      />


      <button
        class="lightbox-nav next"
        type="button"
        aria-label="Next image"
      >
        ❯
      </button>


      <div class="lightbox-counter">

        <span id="lightbox-current">
          1
        </span>

        /

        <span>
          {gallery.length}
        </span>

      </div>

    </div>


    <Footer />


    <!-- =======================================================
         GALLERY SCRIPT
    ======================================================== -->

    <script>
      const images =
        Array.from(
          document.querySelectorAll<HTMLImageElement>(
            ".gallery-slider img"
          )
        );

      const nextBtn =
        document.querySelector<HTMLButtonElement>(
          ".gallery-btn.next"
        );

      const prevBtn =
        document.querySelector<HTMLButtonElement>(
          ".gallery-btn.prev"
        );

      const lightbox =
        document.getElementById("lightbox");

      const lightboxImg =
        document.getElementById(
          "lightbox-img"
        ) as HTMLImageElement | null;

      const closeBtn =
        document.querySelector<HTMLButtonElement>(
          ".lightbox .close"
        );

      const nextLightbox =
        document.querySelector<HTMLButtonElement>(
          ".lightbox-nav.next"
        );

      const prevLightbox =
        document.querySelector<HTMLButtonElement>(
          ".lightbox-nav.prev"
        );

      const galleryCurrent =
        document.getElementById(
          "gallery-current"
        );

      const lightboxCurrent =
        document.getElementById(
          "lightbox-current"
        );

      let index = 0;

      /* =====================================================
         SHOW IMAGE
      ====================================================== */

      function showImage(newIndex: number) {
        if (!images.length) {
          return;
        }

        index =
          (newIndex + images.length) %
          images.length;

        images.forEach(
          (img, i) => {
            img.classList.toggle(
              "active",
              i === index
            );
          }
        );

        if (galleryCurrent) {
          galleryCurrent.textContent =
            String(index + 1);
        }
      }

      /* =====================================================
         NEXT / PREVIOUS
      ====================================================== */

      function nextImage() {
        showImage(index + 1);
      }

      function previousImage() {
        showImage(index - 1);
      }

      nextBtn?.addEventListener(
        "click",
        nextImage
      );

      prevBtn?.addEventListener(
        "click",
        previousImage
      );

      /* =====================================================
         OPEN LIGHTBOX
      ====================================================== */

      function openLightbox(imageIndex: number) {
        if (
          !lightbox ||
          !lightboxImg ||
          !images[imageIndex]
        ) {
          return;
        }

        index = imageIndex;

        lightboxImg.src =
          images[index].src;

        lightboxImg.alt =
          images[index].alt;

        if (lightboxCurrent) {
          lightboxCurrent.textContent =
            String(index + 1);
        }

        lightbox.classList.add("open");

        lightbox.setAttribute(
          "aria-hidden",
          "false"
        );

        document.body.style.overflow =
          "hidden";
      }

      /* =====================================================
         CLOSE LIGHTBOX
      ====================================================== */

      function closeLightbox() {
        if (!lightbox) {
          return;
        }

        lightbox.classList.remove("open");

        lightbox.setAttribute(
          "aria-hidden",
          "true"
        );

        document.body.style.overflow =
          "";
      }

      /* =====================================================
         UPDATE LIGHTBOX
      ====================================================== */

      function updateLightbox(direction: number) {
        showImage(
          index + direction
        );

        if (!lightboxImg || !images[index]) {
          return;
        }

        lightboxImg.src =
          images[index].src;

        lightboxImg.alt =
          images[index].alt;

        if (lightboxCurrent) {
          lightboxCurrent.textContent =
            String(index + 1);
        }
      }

      /* =====================================================
         IMAGE CLICK
      ====================================================== */

      images.forEach(
        (img, i) => {
          img.addEventListener(
            "click",
            () => {
              openLightbox(i);
            }
          );
        }
      );

      /* =====================================================
         LIGHTBOX BUTTONS
      ====================================================== */

      nextLightbox?.addEventListener(
        "click",
        () => {
          updateLightbox(1);
        }
      );

      prevLightbox?.addEventListener(
        "click",
        () => {
          updateLightbox(-1);
        }
      );

      closeBtn?.addEventListener(
        "click",
        closeLightbox
      );

      /* =====================================================
         KEYBOARD
      ====================================================== */

      document.addEventListener(
        "keydown",
        (event) => {
          if (
            lightbox?.classList.contains(
              "open"
            )
          ) {
            if (
              event.key ===
              "ArrowRight"
            ) {
              event.preventDefault();
              updateLightbox(1);
            }

            if (
              event.key ===
              "ArrowLeft"
            ) {
              event.preventDefault();
              updateLightbox(-1);
            }

            if (
              event.key ===
              "Escape"
            ) {
              event.preventDefault();
              closeLightbox();
            }

            return;
          }

          if (
            event.key ===
            "ArrowRight"
          ) {
            nextImage();
          }

          if (
            event.key ===
            "ArrowLeft"
          ) {
            previousImage();
          }
        }
      );

      /* =====================================================
         CLICK OUTSIDE LIGHTBOX
      ====================================================== */

      lightbox?.addEventListener(
        "click",
        (event) => {
          if (
            event.target ===
            lightbox
          ) {
            closeLightbox();
          }
        }
      );

      showImage(0);
    </script>

  </body>
</html>


<style>
/* =========================================================
   EXPERIENCE PAGE
   Visual style aligned with Projects / Hobbies
   ========================================================= */

.experience-bg {
  width: 100%;
  min-height: 100vh;
  margin: 0;
  padding: 3rem 0 5rem;
  background-image: url("/textures/paper-texture.png");
  background-size: cover;
  background-position: center;
  background-attachment: fixed;
  background-color: transparent;
  box-sizing: border-box;
}

/*
   Large outer section: this is the single white/translucent
   container that visually groups the header and timeline.
   The paper texture remains visible around it.
*/
.experience-shell {
  width: min(1200px, calc(100% - 2rem));
  margin: 1rem auto 0;
  padding: 2rem;
  background: rgba(255, 255, 255, 0.78);
  border: 1px solid rgba(0, 0, 0, 0.05);
  border-radius: 16px;
  box-shadow: 0 4px 25px rgba(0, 0, 0, 0.08);
  backdrop-filter: blur(4px);
  box-sizing: border-box;
}

/* =========================================================
   HEADER
   ========================================================= */

.experience-header {
  width: min(900px, 100%);
  margin: 0 auto 2rem;
  padding: 3rem 2rem;

  text-align: center;

  background: rgba(255, 255, 255, 0.9);
  border: 1px solid rgba(0, 0, 0, 0.05);
  border-radius: 12px;
  box-shadow: 0 4px 15px rgba(0, 0, 0, 0.05);
}

.section-label {
  margin: 0 0 0.8rem;
  color: var(--color-accent);
  font-size: 0.75rem;
  font-weight: 700;
  letter-spacing: 0.18em;
}

.experience-header h1 {
  margin: 0;
  color: var(--color-deep);
  font-size: clamp(3rem, 7vw, 5.5rem);
  line-height: 0.95;
}

.experience-intro {
  width: min(700px, 100%);
  margin: 1.5rem auto 0;
  color: var(--color-text);
  font-size: 1rem;
  line-height: 1.6;
  text-align: center;
}

/* =========================================================
   TIMELINE OUTER SECTION
   This is the large section that contains the complete
   timeline and keeps the experience card inside it.
   ========================================================= */

.experience-timeline {
  position: relative;
  width: 100%;
  margin: 0 auto;
  padding: 3rem 2rem 4rem;

  background: rgba(255, 255, 255, 0.85);
  border: 1px solid rgba(0, 0, 0, 0.05);
  border-radius: 12px;
  box-shadow: 0 4px 20px rgba(0, 0, 0, 0.05);

  box-sizing: border-box;
  overflow: hidden;
}

/* Vertical timeline line */
.timeline-line {
  position: absolute;
  top: 4.5rem;
  bottom: 4rem;
  left: 3.2rem;
  width: 2px;
  background: var(--color-accent);
  opacity: 0.35;
}

/* =========================================================
   TIMELINE ITEM
   ========================================================= */

.timeline-item {
  position: relative;
  display: grid;
  grid-template-columns: 90px minmax(0, 1fr);
  gap: 2rem;
  width: 100%;
  min-width: 0;
  box-sizing: border-box;
}

/* =========================================================
   DATE / MARKER
   ========================================================= */

.timeline-date {
  position: relative;
  min-width: 0;
  padding: 0.5rem 0 0 3rem;
}

.timeline-date > span {
  display: inline-block;
  color: var(--color-accent);
  font-size: 0.85rem;
  font-weight: 700;
  letter-spacing: 0.08em;
}

.timeline-marker {
  position: absolute;
  left: 0;
  top: 0;
  width: 2.5rem;
  height: 2.5rem;

  display: flex;
  align-items: center;
  justify-content: center;

  border: 2px solid var(--color-accent);
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.95);
  z-index: 2;
}

.timeline-marker span {
  width: 0.7rem;
  height: 0.7rem;
  border-radius: 50%;
  background: var(--color-accent);
}

/* =========================================================
   EXPERIENCE CARD
   ========================================================= */

.experience-card {
  width: 100%;
  min-width: 0;
  max-width: 100%;
  box-sizing: border-box;

  overflow: hidden;

  background: rgba(255, 255, 255, 0.9);
  border: 1px solid rgba(0, 0, 0, 0.1);
  border-radius: 12px;
  padding: 2.5rem;

  box-shadow: 0 4px 20px rgba(0, 0, 0, 0.05);
  backdrop-filter: blur(4px);
}

/* =========================================================
   CARD HEADER
   ========================================================= */

.experience-card-header {
  min-width: 0;
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 2rem;
  padding-bottom: 2rem;
  border-bottom: 1px solid rgba(0, 0, 0, 0.1);
}

.experience-heading {
  min-width: 0;
  max-width: 100%;
}

.experience-company {
  margin: 0 0 0.4rem;
  color: var(--color-accent);
  font-size: 0.85rem;
  font-weight: 700;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  overflow-wrap: anywhere;
}

.experience-card-header h2 {
