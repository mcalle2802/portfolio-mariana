---
import "../../../styles/global.css";
import Navbar from "../../../components/Navbar.astro";
import Footer from "../../../components/Footer.astro";

const systemOverview = [
  { label: "Controlador", value: "Raspberry Pi Pico" },
  { label: "Plataforma", value: "ROS2 + Gazebo" },
  { label: "Estructura", value: "Acrílico cortado en láser, tapa impresa en 3D, separadores de latón mecanizados" },
  { label: "Sensores", value: "Encoders en cada rueda" },
  { label: "Software", value: "Solid Edge, ROS2, Gazebo" },
];

/*
  ============================================================
  GALLERY
  Mismo componente de carrusel + lightbox que scara.astro,
  con soporte de imagen y video. Ajusta nombres y cantidad de
  archivos a lo que tengas en /public/projects/robot/.
  ============================================================
*/
const gallery = [
  { type: "image", src: "/projects/carro/carro1.jpeg", alt: "Differential Drive Robot 1" },
  { type: "image", src: "/projects/carro/carro2.jpeg", alt: "Differential Drive Robot 2" },
  { type: "image", src: "/projects/carro/carro3.jpeg", alt: "Differential Drive Robot 3" },
  { type: "image", src: "/projects/carro/carro4.jpeg", alt: "Differential Drive Robot 4" },
  { type: "image", src: "/projects/carro/carro5.jpeg", alt: "Differential Drive Robot 5" },
  { type: "image", src: "/projects/carro/carro6.jpeg", alt: "Differential Drive Robot 6" },
  { type: "image", src: "/projects/carro/carro7.jpeg", alt: "Differential Drive Robot 7" },
  { type: "image", src: "/projects/carro/carro8.jpeg", alt: "Differential Drive Robot 8" },
  { type: "image", src: "/projects/carro/carro9.jpeg", alt: "Differential Drive Robot 9" },
  { type: "image", src: "/projects/carro/carro10.jpeg", alt: "Differential Drive Robot 10" },
  { type: "image", src: "/projects/carro/carro11.jpeg", alt: "Differential Drive Robot 11" },
  { type: "image", src: "/projects/carro/carro12.jpeg", alt: "Differential Drive Robot 12" },
  { type: "image", src: "/projects/carro/carro13.jpeg", alt: "Differential Drive Robot 13" },
  { type: "image", src: "/projects/carro/carro14.jpeg", alt: "Differential Drive Robot 14" },
  { type: "image", src: "/projects/carro/carro15.jpeg", alt: "Differential Drive Robot 15" },
  { type: "image", src: "/projects/carro/carro16.jpeg", alt: "Differential Drive Robot 16" },
];
---

<html lang="es">
  <head>
    <meta charset="UTF-8" />

    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0"
    />

    <meta
      name="description"
      content="Robot móvil de tracción diferencial — proyecto de diseño mecánico, fabricación y navegación con ROS2/Gazebo de Mariana Calle Méndez."
    />

    <title>Robot móvil de Tracción Diferencial — Mariana Calle</title>
  </head>

  <body>

    <Navbar />

    <main class="experience-bg">

      <div class="experience-shell">

        <!-- =====================================================
             HEADER
        ====================================================== -->

        <section class="experience-header">

          <h1>
            ROBOT MÓVIL DE TRACCIÓN DIFERENCIAL
          </h1>

          <p class="experience-intro">
            Un robot móvil compacto de tracción diferencial,
            construido desde cero, que conecta la simulación en
            ROS2 con la navegación real por puntos de referencia.
          </p>

        </section>


        <!-- HERO IMAGE -->

        <section class="experience-timeline hero-section">

          <div class="hero-image-wrap">

            <img
              src="/projects/car.jpeg"
              alt="Robot de Tracción Diferencial"
            />

          </div>

        </section>


        <!-- =====================================================
             MAIN CONTENT CARD
        ====================================================== -->

        <section class="experience-timeline">

          <div class="experience-card project-card">

            <!-- =================================================
                 01 · INTRODUCTION
            ================================================== -->

            <div class="experience-section">

              <p class="section-kicker">
                01 · INTRODUCCIÓN
              </p>

              <h2>
                Información del Proyecto
              </h2>

              <div class="hardware-grid">

                <div class="hardware-item">
                  <span class="hardware-label">Fecha del proyecto</span>
                  <span class="hardware-value">2024</span>
                </div>

                <div class="hardware-item">
                  <span class="hardware-label">Tipo de proyecto</span>
                  <span class="hardware-value">Proyecto en equipo</span>
                </div>

                <div class="hardware-item">
                  <span class="hardware-label">Mi rol</span>
                  <span class="hardware-value">Diseño Mecánico, Fabricación, Ensamble e Integración ROS2</span>
                </div>

              </div>

            </div>


            <!-- =================================================
                 02 · THE CHALLENGE
            ================================================== -->

            <div class="experience-section">

              <p class="section-kicker">
                02 · EL RETO
              </p>

              <h2>
                La Idea
              </h2>

              <p>
                El objetivo de este proyecto era diseñar y construir
                un <strong>robot móvil de tracción diferencial</strong>
                capaz de navegar de forma autónoma entre puntos
                predefinidos. Queríamos desarrollar una plataforma
                compacta y funcional que sirviera como base para
                explorar la robótica móvil, combinando diseño
                mecánico, electrónica y navegación robótica.
              </p>

              <p>
                Antes de definir el diseño final, exploramos
                distintos enfoques mecánicos y discutimos cómo
                combinar sus ventajas. Queríamos una estructura
                estable, compacta y fácil de ensamblar, que a la vez
                ofreciera suficiente espacio para los componentes
                electrónicos y los sistemas de control.
              </p>

              <p>
                Otra parte importante del reto fue conectar el robot
                físico con una representación virtual. Al incorporar
                <strong>ROS2</strong> y <strong>Gazebo</strong>,
                buscábamos configurar y probar el robot en un
                entorno simulado mientras desarrollábamos las
                capacidades de navegación que luego se usarían en el
                prototipo real.
              </p>

            </div>


            <!-- =================================================
                 03 · MY CONTRIBUTION
            ================================================== -->

            <div class="experience-section">

              <p class="section-kicker">
                03 · MI APORTE
              </p>

              <h2>
                Diseño Mecánico e Integración
              </h2>

              <p>
                Mi responsabilidad principal fue el diseño mecánico
                completo y el ensamble del robot móvil. Desarrollé el
                chasis y la distribución de componentes en <em>Solid
                Edge</em>, asegurando que la estructura cumpliera con
                las dimensiones requeridas mientras ofrecía suficiente
                espacio, estabilidad y soporte para todos los
                componentes electrónicos.
              </p>

              <p>
                Diseñé los soportes del motor y de la Raspberry Pi,
                así como la tapa superior protectora que albergaba la
                electrónica de control y comunicación. También
                preparé los planos técnicos y las vistas explosionadas
                para planear cómo encajarían las piezas individuales
                y simplificar el proceso de fabricación y ensamble.
              </p>

              <p>
                Mi trabajo se extendió más allá del diseño CAD hacia
                la construcción física del robot. Participé en la
                fabricación de su tapa impresa en 3D, las plataformas
                de acrílico cortadas en láser y los separadores de
                latón mecanizados, y ensamblé la estructura mecánica
                completa, integrando los componentes electrónicos al
                chasis. También participé directamente en la
                integración de software, configurando el robot en
                <strong>ROS2</strong> y <strong>Gazebo</strong> y
                trabajando en sus capacidades de navegación — una
                oportunidad para conectar el robot físico con su
                representación virtual y entender cómo se integran el
                diseño mecánico, la electrónica y el software de
                robótica en un sistema móvil.
              </p>

              <div class="tags">
                <span>Solid Edge</span>
                <span>Diseño del Chasis</span>
                <span>Planos Técnicos</span>
                <span>ROS2</span>
                <span>Gazebo</span>
              </div>

            </div>


            <!-- =================================================
                 04 · FROM DESIGN TO REALITY
            ================================================== -->

            <div class="experience-section">

              <p class="section-kicker">
                04 · DEL DISEÑO A LA REALIDAD
              </p>

              <h2>
                Dándole Vida al Robot
              </h2>

              <p>
                Con el diseño mecánico terminado, el siguiente paso
                era convertir el modelo CAD en un robot físico. La
                estructura se fabricó combinando plataformas de
                <strong>acrílico cortado en láser</strong>,
                componentes <strong>impresos en 3D</strong> y
                <strong>separadores de latón mecanizados</strong>.
                Cada pieza se preparó y ensambló para crear una
                plataforma compacta y estable que pudiera albergar
                todos los componentes electrónicos.
              </p>

              <p>
                Una vez lista la estructura mecánica, integramos la
                electrónica y unimos los distintos subsistemas. En
                paralelo, trabajamos en configurar el robot en ROS2
                y crear su representación virtual en Gazebo —
                configurando el modelo del robot y preparando el
                entorno de simulación para probar su movimiento y
                navegación.
              </p>

              <p>
                Una de las partes más interesantes de este proceso
                fue trabajar en ambos entornos a la vez, asegurando
                que la configuración virtual y el robot físico
                pudieran realizar las mismas tareas de navegación.
              </p>

              <div class="tags">
                <span>Impresión 3D</span>
                <span>Corte Láser</span>
                <span>Mecanizado</span>
              </div>

              <div class="hardware-grid">
                {
                  systemOverview.map((item) => (
                    <div class="hardware-item">
                      <span class="hardware-label">{item.label}</span>
                      <span class="hardware-value">{item.value}</span>
                    </div>
                  ))
                }
              </div>

            </div>


            <!-- GALLERY -->

            <div class="experience-gallery-section">

              <h3>
                Galería del Proyecto
              </h3>

              <div class="gallery-container">

                <div class="gallery-slider">

                  {
                    gallery.map((item, i) => (
                      item.type === "video" ? (
                        <video
                          src={item.src}
                          class:list={{ active: i === 0 }}
                          muted
                          loop
                          playsinline
                          preload="metadata"
                        />
                      ) : (
                        <img
                          src={item.src}
                          alt={item.alt}
                          class:list={{ active: i === 0 }}
                          loading={i === 0 ? "eager" : "lazy"}
                        />
                      )
                    ))
                  }

                </div>


                <button
                  class="gallery-btn prev"
                  type="button"
                  aria-label="Elemento anterior"
                >
                  ❮
                </button>


                <button
                  class="gallery-btn next"
                  type="button"
                  aria-label="Siguiente elemento"
                >
                  ❯
                </button>


                <div class="gallery-counter">

                  <span id="gallery-current">
                    1
                  </span>

                  /

                  <span>
                    {gallery.length}
                  </span>

                </div>

              </div>

            </div>


            <!-- =================================================
                 05 · RESULTS
            ================================================== -->

            <div class="experience-section learning-section">

              <p class="section-kicker">
                05 · RESULTADOS
              </p>

              <h2>
                El Resultado
              </h2>

              <p>
                El robot final demostró con éxito movimiento autónomo
                punto a punto, tanto en el prototipo físico como en
                su simulación en Gazebo. Pudo navegar entre
                posiciones predefinidas, demostrando la integración
                entre el modelo virtual y el sistema real.
              </p>

              <p>
                La configuración de navegación nos permitió definir
                distintas trayectorias para el robot. Sin embargo,
                por restricciones de tiempo, elegimos una ruta más
                simple para la demostración final, priorizando
                lograr un resultado confiable y funcional.
              </p>

              <p>
                Este proyecto reunió diseño mecánico, fabricación,
                electrónica y software de robótica en una plataforma
                móvil funcional. Para mí, uno de los aspectos más
                gratificantes fue ver el sistema completo operar en
                ambos entornos y entender cómo la simulación virtual
                puede apoyar el desarrollo y las pruebas de un robot
                real.
              </p>

              <blockquote>
                Ver el sistema completo operar tanto en el mundo
                virtual como en el real fue la parte más
                gratificante de este proyecto.
              </blockquote>

            </div>


            <!-- BACK LINK -->

            <div class="back-link-wrap">
              <a href="/es/projects" class="back-link-pill">
                <span>←</span>
                Volver a Proyectos
              </a>
            </div>

          </div>

        </section>

      </div>

    </main>


    <!-- =======================================================
         LIGHTBOX
    ======================================================== -->

    <div
      id="lightbox"
      class="lightbox"
      aria-hidden="true"
    >

      <button
        class="close"
        type="button"
        aria-label="Cerrar visor"
      >
        &times;
      </button>


      <button
        class="lightbox-nav prev"
        type="button"
        aria-label="Elemento anterior"
      >
        ❮
      </button>


      <img
        id="lightbox-img"
        class="lightbox-content"
        src=""
        alt=""
      />

      <video
        id="lightbox-video"
        class="lightbox-content"
        controls
        playsinline
      />


      <button
        class="lightbox-nav next"
        type="button"
        aria-label="Siguiente elemento"
      >
        ❯
      </button>


      <div class="lightbox-counter">

        <span id="lightbox-current">
          1
        </span>

        /

        <span>
          {gallery.length}
        </span>

      </div>

    </div>


    <Footer />


    <!-- =======================================================
         GALLERY SCRIPT
    ======================================================== -->

    <script>
      const items =
        Array.from(
          document.querySelectorAll<HTMLImageElement | HTMLVideoElement>(
            ".gallery-slider img, .gallery-slider video"
          )
        );

      const nextBtn =
        document.querySelector<HTMLButtonElement>(
          ".gallery-btn.next"
        );

      const prevBtn =
        document.querySelector<HTMLButtonElement>(
          ".gallery-btn.prev"
        );

      const lightbox =
        document.getElementById("lightbox");

      const lightboxImg =
        document.getElementById(
          "lightbox-img"
        ) as HTMLImageElement | null;

      const lightboxVideo =
        document.getElementById(
          "lightbox-video"
        ) as HTMLVideoElement | null;

      const closeBtn =
        document.querySelector<HTMLButtonElement>(
          ".lightbox .close"
        );

      const nextLightbox =
        document.querySelector<HTMLButtonElement>(
          ".lightbox-nav.next"
        );

      const prevLightbox =
        document.querySelector<HTMLButtonElement>(
          ".lightbox-nav.prev"
        );

      const galleryCurrent =
        document.getElementById(
          "gallery-current"
        );

      const lightboxCurrent =
        document.getElementById(
          "lightbox-current"
        );

      let index = 0;

      /* =====================================================
         SHOW ITEM
      ====================================================== */

      function showItem(newIndex: number) {
        if (!items.length) {
          return;
        }

        index =
          (newIndex + items.length) %
          items.length;

        items.forEach(
          (item, i) => {
            const isActive = i === index;

            item.classList.toggle(
              "active",
              isActive
            );

            if (item.tagName === "VIDEO") {
              const video = item as HTMLVideoElement;

              if (isActive) {
                video.play().catch(() => {});
              } else {
                video.pause();
                video.currentTime = 0;
              }
            }
          }
        );

        if (galleryCurrent) {
          galleryCurrent.textContent =
            String(index + 1);
        }
      }

      /* =====================================================
         NEXT / PREVIOUS
      ====================================================== */

      function nextItem() {
        showItem(index + 1);
      }

      function previousItem() {
        showItem(index - 1);
      }

      nextBtn?.addEventListener(
        "click",
        nextItem
      );

      prevBtn?.addEventListener(
        "click",
        previousItem
      );

      /* =====================================================
         LIGHTBOX
      ====================================================== */

      function renderLightbox() {
        if (
          !lightboxImg ||
          !lightboxVideo ||
          !items[index]
        ) {
          return;
        }

        const current = items[index];

        if (current.tagName === "VIDEO") {
          lightboxVideo.src = current.getAttribute("src") ?? "";
          lightboxVideo.style.display = "block";
          lightboxVideo.play().catch(() => {});

          lightboxImg.style.display = "none";
        } else {
          lightboxImg.src = (current as HTMLImageElement).src;
          lightboxImg.alt = (current as HTMLImageElement).alt;
          lightboxImg.style.display = "block";

          lightboxVideo.pause();
          lightboxVideo.style.display = "none";
        }

        if (lightboxCurrent) {
          lightboxCurrent.textContent =
            String(index + 1);
        }
      }

      function openLightbox(itemIndex: number) {
        if (
          !lightbox ||
          !items[itemIndex]
        ) {
          return;
        }

        index = itemIndex;

        renderLightbox();

        lightbox.classList.add("open");

        lightbox.setAttribute(
          "aria-hidden",
          "false"
        );

        document.body.style.overflow =
          "hidden";
      }

      function closeLightbox() {
        if (!lightbox) {
          return;
        }

        lightboxVideo?.pause();

        lightbox.classList.remove("open");

        lightbox.setAttribute(
          "aria-hidden",
          "true"
        );

        document.body.style.overflow =
          "";
      }

      function updateLightbox(direction: number) {
        lightboxVideo?.pause();

        showItem(
          index + direction
        );

        renderLightbox();
      }

      items.forEach(
        (item, i) => {
          item.addEventListener(
            "click",
            () => {
              openLightbox(i);
            }
          );
        }
      );

      nextLightbox?.addEventListener(
        "click",
        () => {
          updateLightbox(1);
        }
      );

      prevLightbox?.addEventListener(
        "click",
        () => {
          updateLightbox(-1);
        }
      );

      closeBtn?.addEventListener(
        "click",
        closeLightbox
      );

      document.addEventListener(
        "keydown",
        (event) => {
          if (
            lightbox?.classList.contains(
              "open"
            )
          ) {
            if (
              event.key ===
              "ArrowRight"
            ) {
              event.preventDefault();
              updateLightbox(1);
            }

            if (
              event.key ===
              "ArrowLeft"
            ) {
              event.preventDefault();
              updateLightbox(-1);
            }

            if (
              event.key ===
              "Escape"
            ) {
              event.preventDefault();
              closeLightbox();
            }

            return;
          }

          if (
            event.key ===
            "ArrowRight"
          ) {
            nextItem();
          }

          if (
            event.key ===
            "ArrowLeft"
          ) {
            previousItem();
          }
        }
      );

      lightbox?.addEventListener(
        "click",
        (event) => {
          if (
            event.target ===
            lightbox
          ) {
            closeLightbox();
          }
        }
      );

      showItem(0);
    </script>

  </body>
</html>


<style>
/* =========================================================
   Mismas clases base que scara.astro / experience.astro.
   ========================================================= */

.experience-bg {
  width: 100%;
  min-height: 100vh;
  margin: 0;
  padding: 3rem 0 5rem;
  background-image: url("/textures/paper-texture.png");
  background-size: cover;
  background-position: center;
  background-attachment: fixed;
  background-color: transparent;
  box-sizing: border-box;
  overflow-x: hidden;
}

.experience-shell {
  width: 100%;
  max-width: 1200px;
  margin: 1rem auto 0;
  padding: 2rem;
  background: rgba(255, 255, 255, 0.78);
  border: 1px solid rgba(0, 0, 0, 0.05);
  border-radius: 16px;
  box-shadow: 0 4px 25px rgba(0, 0, 0, 0.08);
  backdrop-filter: blur(4px);
  box-sizing: border-box;
}

.experience-shell .experience-header {
  width: 100%;
  max-width: 950px;
  margin: 0 auto 2rem;
  padding: 3rem 2.5rem;
  text-align: center;
  background: rgba(255, 255, 255, 0.9);
  border: 1px solid rgba(0, 0, 0, 0.05);
  border-radius: 12px;
  box-shadow: 0 4px 15px rgba(0, 0, 0, 0.05);
  box-sizing: border-box;
  overflow: hidden;
}

.experience-header h1 {
  margin: 0;
  color: var(--color-deep);
  font-size: clamp(2.3rem, 6.5vw, 4.6rem);
  line-height: 1.05;
  letter-spacing: -0.01em;
  overflow-wrap: break-word;
}

.experience-intro {
  width: min(700px, 100%);
  margin: 1.5rem auto 0;
  color: var(--color-text);
  font-size: 1rem;
  line-height: 1.6;
  text-align: center;
}

.experience-shell .experience-timeline {
  width: 100%;
  margin: 0 auto 2rem;
  padding: 3rem 2rem 4rem;
  background: rgba(255, 255, 255, 0.85);
  border: 1px solid rgba(0, 0, 0, 0.05);
  border-radius: 12px;
  box-shadow: 0 4px 20px rgba(0, 0, 0, 0.05);
  box-sizing: border-box;
  overflow: hidden;
}

.experience-shell .experience-timeline:last-child {
  margin-bottom: 0;
}

.experience-card {
  width: 100%;
  min-width: 0;
  max-width: 100%;
  box-sizing: border-box;
  overflow: hidden;
  background: rgba(255, 255, 255, 0.9);
  border: 1px solid rgba(0, 0, 0, 0.1);
  border-radius: 12px;
  padding: 2.5rem;
  box-shadow: 0 4px 20px rgba(0, 0, 0, 0.05);
  backdrop-filter: blur(4px);
}

/* HERO IMAGE */

.hero-section {
  padding: 0 !important;
  background: transparent !important;
  border: none !important;
  box-shadow: none !important;
  overflow: visible !important;
}

.hero-image-wrap {
  position: relative;
  width: 100%;
  aspect-ratio: 16 / 7;
  border-radius: 14px;
  overflow: hidden;
  box-shadow: 0 10px 30px rgba(0, 0, 0, 0.18);
}

.hero-image-wrap img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
  filter: saturate(1.05);
}

/* SECTIONS */

.experience-section {
  width: 100%;
  min-width: 0;
  padding: 2.75rem 0;
  border-bottom: 1px solid rgba(0, 0, 0, 0.08);
}

.experience-section:last-of-type {
  border-bottom: none;
}

.section-kicker {
  margin: 0 0 0.6rem;
  color: var(--color-accent);
  font-size: 0.75rem;
  font-weight: 700;
  letter-spacing: 0.14em;
  text-transform: uppercase;
}

.experience-section h2 {
  margin: 0 0 1.2rem;
  color: var(--color-deep);
  font-size: clamp(1.4rem, 3.2vw, 2.1rem);
  font-weight: 700;
  line-height: 1.2;
  overflow-wrap: anywhere;
}

.experience-section p {
  width: 100%;
  max-width: 100%;
  min-width: 0;
  margin: 0 0 1rem;
  color: var(--color-text);
  font-size: 0.98rem;
  line-height: 1.6;
  text-align: justify;
  overflow-wrap: anywhere;
}

.experience-section p:last-of-type {
  margin-bottom: 0;
}

.learning-section blockquote {
  margin: 1.5rem 0 0;
  padding: 1.2rem 1.5rem;
  border-left: 3px solid var(--color-accent);
  background: rgba(255, 255, 255, 0.5);
  color: var(--color-deep);
  font-size: 1.05rem;
  font-style: italic;
  line-height: 1.6;
