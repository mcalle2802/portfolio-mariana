---
import "../../../styles/global.css";
import Navbar from "../../../components/Navbar.astro";
import Footer from "../../../components/Footer.astro";

const hardware = [
  { label: "Controlador", value: "Raspberry Pi Pico" },
  { label: "Driver", value: "Puente H doble L298N" },
  { label: "Motores", value: "Motorreductores DC (12 V, 200 RPM) con encoders" },
  { label: "Actuador", value: "Etapa lineal para el movimiento del eje Z" },
  { label: "Sensores", value: "Finales de carrera en cada articulación" },
  { label: "Software", value: "Solid Edge Siemens, MATLAB, Simulink, MicroPython" },
];

/*
  ============================================================
  GALLERY
  14 fotos + 2 videos. Mismo componente de carrusel + lightbox
  que experience.astro, extendido para soportar video.
  ============================================================
*/
const gallery = [
  { type: "image", src: "/projects/scara/scara1.jpeg", alt: "SCARA 1" },
  { type: "image", src: "/projects/scara/scara2.jpeg", alt: "SCARA 2" },
  { type: "image", src: "/projects/scara/scara3.jpeg", alt: "SCARA 3" },
  { type: "image", src: "/projects/scara/scara4.jpeg", alt: "SCARA 4" },
  { type: "image", src: "/projects/scara/scara5.jpeg", alt: "SCARA 5" },
  { type: "image", src: "/projects/scara/scara6.jpeg", alt: "SCARA 6" },
  { type: "image", src: "/projects/scara/scara7.jpeg", alt: "SCARA 7" },
  { type: "image", src: "/projects/scara/scara8.jpeg", alt: "SCARA 8" },
  { type: "image", src: "/projects/scara/scara9.jpeg", alt: "SCARA 9" },
  { type: "image", src: "/projects/scara/scara10.jpeg", alt: "SCARA 10" },
  { type: "image", src: "/projects/scara/scara11.jpeg", alt: "SCARA 11" },
  { type: "image", src: "/projects/scara/scara12.jpeg", alt: "SCARA 12" },
  { type: "image", src: "/projects/scara/scara13.jpeg", alt: "SCARA 13" },
  { type: "image", src: "/projects/scara/scara14.jpeg", alt: "SCARA 14" },
  { type: "video", src: "/projects/scara/video1.mp4", alt: "SCARA video 1" },
  { type: "video", src: "/projects/scara/video2.mp4", alt: "SCARA video 2" },
];
---

<html lang="es">
  <head>
    <meta charset="UTF-8" />

    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0"
    />

    <meta
      name="description"
      content="Robot SCARA de soldadura — proyecto de diseño mecánico, control y cinemática de Mariana Calle Méndez."
    />

    <title>Robot SCARA de Soldadura — Mariana Calle</title>
  </head>

  <body>

    <Navbar />

    <main class="experience-bg">

      <div class="experience-shell">

        <!-- =====================================================
             01 · INTRODUCTION
        ====================================================== -->

        <section class="experience-header">

          <h1>
            ROBOT SCARA
          </h1>

          <p class="experience-intro">
            Un brazo robótico de 3 grados de libertad diseñado y
            construido para una aplicación de soldadura MIG simulada.
          </p>

        </section>


        <!-- HERO IMAGE -->

        <section class="experience-timeline hero-section">

          <div class="hero-image-wrap">

            <img
              src="/projects/scara.jpeg"
              alt="Robot SCARA"
            />

          </div>

        </section>


        <!-- =====================================================
             MAIN CONTENT CARD
        ====================================================== -->

        <section class="experience-timeline">

          <div class="experience-card project-card">

            <!-- =================================================
                 01 · INTRODUCTION
            ================================================== -->

            <div class="experience-section">

              <p class="section-kicker">
                01 · INTRODUCCIÓN
              </p>

              <h2>
                Información del Proyecto
              </h2>

              <div class="hardware-grid">

                <div class="hardware-item">
                  <span class="hardware-label">Fecha del proyecto</span>
                  <span class="hardware-value">2024</span>
                </div>

                <div class="hardware-item">
                  <span class="hardware-label">Tipo de proyecto</span>
                  <span class="hardware-value">Proyecto en equipo</span>
                </div>

                <div class="hardware-item">
                  <span class="hardware-label">Mi rol</span>
                  <span class="hardware-value">Diseño Mecánico, Ensamble e Integración</span>
                </div>

              </div>

            </div>


            <!-- =================================================
                 02 · THE CHALLENGE
            ================================================== -->

            <div class="experience-section">

              <p class="section-kicker">
                02 · EL RETO
              </p>

              <h2>
                La Idea
              </h2>

              <p>
                El reto consistía en diseñar y construir un brazo
                robótico SCARA para una <strong>aplicación de
                soldadura MIG simulada</strong>. El robot debía
                cumplir con requisitos específicos de altura y
                alcance, incorporando <strong>tres grados de
                libertad</strong> — dos articulaciones rotacionales
                y una traslacional.
              </p>

              <p>
                Antes de empezar el diseño, quise entender qué había
                funcionado bien en proyectos anteriores y qué retos
                debía anticipar. Hablé con estudiantes de semestres
                anteriores para pedir su consejo, y también consulté
                a Julián, uno de los técnicos de laboratorio de la
                universidad, para discutir posibles enfoques de
                diseño. Juntos priorizamos la <strong>rigidez
                estructural</strong> desde el principio y
                desarrollamos un boceto preliminar que se convirtió
                en el punto de partida de todo el diseño — incluyendo
                su sugerencia de adaptar un mecanismo de seguro
                eléctrico de carro para el efector final de
                soldadura, una idea que terminamos incorporando al
                prototipo.
              </p>

            </div>


            <!-- =================================================
                 03 · MY CONTRIBUTION
            ================================================== -->

            <div class="experience-section">

              <p class="section-kicker">
                03 · MI APORTE
              </p>

              <h2>
                Diseño Mecánico
              </h2>

              <p>
                Mi responsabilidad principal fue el diseño mecánico
                completo y el ensamble del robot SCARA, que
                desarrollé desde cero en <em>Solid Edge Siemens</em>.
                Definí sus dimensiones, geometría y espacio de
                trabajo, y diseñé los eslabones, articulaciones,
                soportes de motor, conexiones y mecanismos de
                ensamble, priorizando siempre la estabilidad
                estructural, la rigidez y la correcta integración
                entre las partes.
              </p>

              <p>
                Una parte importante de este proceso fue entender
                cómo la geometría del robot afectaría su movimiento:
                trabajé en los cálculos de <strong>cinemática
                directa</strong> y los usé para guiar el diseño
                mecánico, asegurando que el brazo pudiera alcanzar
                las posiciones requeridas para su tarea.
              </p>

              <div class="tags">
                <span>Solid Edge</span>
                <span>Diseño Mecánico</span>
                <span>Cinemática Directa</span>
              </div>

            </div>


            <!-- =================================================
                 04 · FROM DESIGN TO REALITY
            ================================================== -->

            <div class="experience-section">

              <p class="section-kicker">
                04 · DEL DISEÑO A LA REALIDAD
              </p>

              <h2>
                Fabricación y Ensamble
              </h2>

              <p>
                Participé directamente en la fabricación y el
                ensamble de la estructura mecánica. Usé
                <strong>mecanizado CNC</strong> para fabricar los
                eslabones y soportes de motor, un <strong>torno</strong>
                para producir los componentes de las articulaciones,
                e <strong>impresión 3D</strong> para crear los
                soportes de los finales de carrera que definían el
                espacio de trabajo del robot.
              </p>

              <p>
                El mecanismo de seguro eléctrico de carro que
                habíamos bocetado antes fue adaptado e incorporado
                al efector final de soldadura, convirtiendo una pieza
                existente en una solución práctica para el proyecto.
                Haber planeado cuidadosamente la estructura y
                preparado cada componente de antemano hizo que el
                ensamble final fuera mucho más sencillo, y el
                prototipo resultante funcionó muy bien.
              </p>

              <div class="tags">
                <span>Mecanizado CNC</span>
                <span>Torno</span>
                <span>Impresión 3D</span>
              </div>

            </div>


            <!-- GALLERY — fotos del proceso -->

            <div class="experience-gallery-section">

              <h3>
                Galería del Proyecto
              </h3>

              <div class="gallery-container">

                <div class="gallery-slider">

                  {
                    gallery.map((item, i) => (
                      item.type === "video" ? (
                        <video
                          src={item.src}
                          class:list={{ active: i === 0 }}
                          muted
                          loop
                          playsinline
                          preload="metadata"
                        />
                      ) : (
                        <img
                          src={item.src}
                          alt={item.alt}
                          class:list={{ active: i === 0 }}
                          loading={i === 0 ? "eager" : "lazy"}
                        />
                      )
                    ))
                  }

                </div>


                <button
                  class="gallery-btn prev"
                  type="button"
                  aria-label="Elemento anterior"
                >
                  ❮
                </button>


                <button
                  class="gallery-btn next"
                  type="button"
                  aria-label="Siguiente elemento"
                >
                  ❯
                </button>


                <div class="gallery-counter">

                  <span id="gallery-current">
                    1
                  </span>

                  /

                  <span>
                    {gallery.length}
                  </span>

                </div>

              </div>

            </div>


            <!-- =================================================
                 05 · SYSTEM INTEGRATION
            ================================================== -->

            <div class="experience-section">

              <p class="section-kicker">
                05 · INTEGRACIÓN DEL SISTEMA
              </p>

              <h2>
                Control y Gemelo Virtual
              </h2>

              <p>
                El control del robot se implementó usando un
                microcontrolador <strong>Raspberry Pi Pico</strong>.
                Dos <strong>motores DC</strong> impulsaban las
                articulaciones rotacionales, mientras que un
                <strong>servomotor</strong> controlaba el movimiento
                vertical a lo largo del eje Z, y los <strong>finales
                de carrera</strong> definían los límites del espacio
                de trabajo para mantener el sistema seguro. Cada
                articulación usaba un <strong>controlador
                proporcional (P)</strong>, ajustado a partir de la
                función de transferencia de su motor, para seguir
                las trayectorias de soldadura programadas de forma
                suave y precisa.
              </p>

              <p>
                Junto al prototipo físico, la cinemática directa e
                inversa se desarrolló analíticamente usando la
                convención de Denavit–Hartenberg y se validó en
                MATLAB, y se construyó un <strong>gemelo digital</strong>
                en MATLAB/Simulink para reflejar el comportamiento
                del robot. Esto nos permitió probar trayectorias y
                ganancias de control de forma virtual antes de
                ejecutarlas en el brazo físico, manteniendo el
                movimiento simulado y el físico estrechamente
                coordinados durante todo el desarrollo.
              </p>

              <div class="code-card">

                <div class="code-card-label">
                  MicroPython
                </div>

                <pre><code># Proportional Control Example
from machine import Pin, PWM
import time

pwm_motor = PWM(Pin(15))
pwm_motor.freq(1000)

kp = 0.4
target_angle = 45
current_angle = 0

while True:
    error = target_angle - current_angle
    control_signal = int(min(max(abs(kp * error), 0), 1023))
    pwm_motor.duty_u16(control_signal)
    # update simulated angle
    current_angle += 0.1 * error
    time.sleep(0.05)
</code></pre>

              </div>

              <div class="hardware-grid">
                {
                  hardware.map((item) => (
                    <div class="hardware-item">
                      <span class="hardware-label">{item.label}</span>
                      <span class="hardware-value">{item.value}</span>
                    </div>
                  ))
                }
              </div>

            </div>


            <!-- =================================================
                 06 · RESULTS
            ================================================== -->

            <div class="experience-section learning-section">

              <p class="section-kicker">
                06 · RESULTADOS
              </p>

              <h2>
                El Resultado
              </h2>

              <p>
                El robot alcanzó exitosamente las posiciones
                predefinidas y siguió físicamente las trayectorias
                programadas requeridas para simular el proceso de
                soldadura MIG, ajustando su eje Z para reproducir
                distintas alturas de costura. Los controladores
                proporcionales mantuvieron su movimiento suave, y el
                desempeño físico coincidió de cerca con el
                comportamiento predicho por el gemelo virtual.
              </p>

              <blockquote>
                Una idea que empezó como un boceto preliminar se
                convirtió en un robot completamente ensamblado,
                capaz de cumplir la tarea para la que fue diseñado.
              </blockquote>

            </div>


            <!-- BACK LINK -->

            <div class="back-link-wrap">
              <a href="/es/projects" class="back-link-pill">
                <span>←</span>
                Volver a Proyectos
              </a>
            </div>

          </div>

        </section>

      </div>

    </main>


    <!-- =======================================================
         LIGHTBOX
    ======================================================== -->

    <div
      id="lightbox"
      class="lightbox"
      aria-hidden="true"
    >

      <button
        class="close"
        type="button"
        aria-label="Cerrar visor"
      >
        &times;
      </button>


      <button
        class="lightbox-nav prev"
        type="button"
        aria-label="Elemento anterior"
      >
        ❮
      </button>


      <img
        id="lightbox-img"
        class="lightbox-content"
        src=""
        alt=""
      />

      <video
        id="lightbox-video"
        class="lightbox-content"
        controls
        playsinline
      />


      <button
        class="lightbox-nav next"
        type="button"
        aria-label="Siguiente elemento"
      >
        ❯
      </button>


      <div class="lightbox-counter">

        <span id="lightbox-current">
          1
        </span>

        /

        <span>
          {gallery.length}
        </span>

      </div>

    </div>


    <Footer />


    <!-- =======================================================
         GALLERY SCRIPT
    ======================================================== -->

    <script>
      const items =
        Array.from(
          document.querySelectorAll<HTMLImageElement | HTMLVideoElement>(
            ".gallery-slider img, .gallery-slider video"
          )
        );

      const nextBtn =
        document.querySelector<HTMLButtonElement>(
          ".gallery-btn.next"
        );

      const prevBtn =
        document.querySelector<HTMLButtonElement>(
          ".gallery-btn.prev"
        );

      const lightbox =
        document.getElementById("lightbox");

      const lightboxImg =
        document.getElementById(
          "lightbox-img"
        ) as HTMLImageElement | null;

      const lightboxVideo =
        document.getElementById(
          "lightbox-video"
        ) as HTMLVideoElement | null;

      const closeBtn =
        document.querySelector<HTMLButtonElement>(
          ".lightbox .close"
        );

      const nextLightbox =
        document.querySelector<HTMLButtonElement>(
          ".lightbox-nav.next"
        );

      const prevLightbox =
        document.querySelector<HTMLButtonElement>(
          ".lightbox-nav.prev"
        );

      const galleryCurrent =
        document.getElementById(
          "gallery-current"
        );

      const lightboxCurrent =
        document.getElementById(
          "lightbox-current"
        );

      let index = 0;

      /* =====================================================
         SHOW ITEM
      ====================================================== */

      function showItem(newIndex: number) {
        if (!items.length) {
          return;
        }

        index =
          (newIndex + items.length) %
          items.length;

        items.forEach(
          (item, i) => {
            const isActive = i === index;

            item.classList.toggle(
              "active",
              isActive
            );

            if (item.tagName === "VIDEO") {
              const video = item as HTMLVideoElement;

              if (isActive) {
                video.play().catch(() => {});
              } else {
                video.pause();
                video.currentTime = 0;
              }
            }
          }
        );

        if (galleryCurrent) {
          galleryCurrent.textContent =
            String(index + 1);
        }
      }

      /* =====================================================
         NEXT / PREVIOUS
      ====================================================== */

      function nextItem() {
        showItem(index + 1);
      }

      function previousItem() {
        showItem(index - 1);
      }

      nextBtn?.addEventListener(
        "click",
        nextItem
      );

      prevBtn?.addEventListener(
        "click",
        previousItem
      );

      /* =====================================================
         LIGHTBOX
      ====================================================== */

      function renderLightbox() {
        if (
          !lightboxImg ||
          !lightboxVideo ||
          !items[index]
        ) {
          return;
        }

        const current = items[index];

        if (current.tagName === "VIDEO") {
          lightboxVideo.src = current.getAttribute("src") ?? "";
          lightboxVideo.style.display = "block";
          lightboxVideo.play().catch(() => {});

          lightboxImg.style.display = "none";
        } else {
          lightboxImg.src = (current as HTMLImageElement).src;
          lightboxImg.alt = (current as HTMLImageElement).alt;
          lightboxImg.style.display = "block";

          lightboxVideo.pause();
          lightboxVideo.style.display = "none";
        }

        if (lightboxCurrent) {
          lightboxCurrent.textContent =
            String(index + 1);
        }
      }

      function openLightbox(itemIndex: number) {
        if (
          !lightbox ||
          !items[itemIndex]
        ) {
          return;
        }

        index = itemIndex;

        renderLightbox();

        lightbox.classList.add("open");

        lightbox.setAttribute(
          "aria-hidden",
          "false"
        );

        document.body.style.overflow =
          "hidden";
      }

      function closeLightbox() {
        if (!lightbox) {
          return;
        }

        lightboxVideo?.pause();

        lightbox.classList.remove("open");

        lightbox.setAttribute(
          "aria-hidden",
          "true"
        );

        document.body.style.overflow =
          "";
      }

      function updateLightbox(direction: number) {
        lightboxVideo?.pause();

        showItem(
          index + direction
        );

        renderLightbox();
      }

      items.forEach(
        (item, i) => {
          item.addEventListener(
            "click",
            () => {
              openLightbox(i);
            }
          );
        }
      );

      nextLightbox?.addEventListener(
        "click",
        () => {
          updateLightbox(1);
        }
      );

      prevLightbox?.addEventListener(
        "click",
        () => {
          updateLightbox(-1);
        }
      );

      closeBtn?.addEventListener(
        "click",
        closeLightbox
      );

      document.addEventListener(
        "keydown",
        (event) => {
          if (
            lightbox?.classList.contains(
              "open"
            )
          ) {
            if (
              event.key ===
              "ArrowRight"
            ) {
              event.preventDefault();
              updateLightbox(1);
            }

            if (
              event.key ===
              "ArrowLeft"
            ) {
              event.preventDefault();
              updateLightbox(-1);
            }

            if (
              event.key ===
              "Escape"
            ) {
              event.preventDefault();
              closeLightbox();
            }

            return;
          }

          if (
            event.key ===
            "ArrowRight"
          ) {
            nextItem();
          }

          if (
            event.key ===
            "ArrowLeft"
          ) {
            previousItem();
          }
        }
      );

      lightbox?.addEventListener(
        "click",
        (event) => {
          if (
            event.target ===
            lightbox
          ) {
            closeLightbox();
          }
        }
      );

      showItem(0);
    </script>

  </body>
</html>


<style>
/* =========================================================
   Mismas clases base que experience.astro.
   ========================================================= */

.experience-bg {
  width: 100%;
  min-height: 100vh;
  margin: 0;
  padding: 3rem 0 5rem;
  background-image: url("/textures/paper-texture.png");
  background-size: cover;
  background-position: center;
  background-attachment: fixed;
  background-color: transparent;
  box-sizing: border-box;
  overflow-x: hidden;
}

.experience-shell {
  width: 100%;
  max-width: 1200px;
  margin: 1rem auto 0;
  padding: 2rem;
  background: rgba(255, 255, 255, 0.78);
  border: 1px solid rgba(0, 0, 0, 0.05);
  border-radius: 16px;
  box-shadow: 0 4px 25px rgba(0, 0, 0, 0.08);
  backdrop-filter: blur(4px);
  box-sizing: border-box;
}

/* HEADER */

.experience-shell .experience-header {
  width: 100%;
  max-width: 950px;
  margin: 0 auto 2rem;
  padding: 3rem 2.5rem;
  text-align: center;
  background: rgba(255, 255, 255, 0.9);
  border: 1px solid rgba(0, 0, 0, 0.05);
  border-radius: 12px;
  box-shadow: 0 4px 15px rgba(0, 0, 0, 0.05);
  box-sizing: border-box;
  overflow: hidden;
}

.section-label {
  margin: 0 0 0.8rem;
  color: var(--color-accent);
  font-size: 0.75rem;
  font-weight: 700;
  letter-spacing: 0.18em;
}

.experience-header h1 {
  margin: 0;
  color: var(--color-deep);
  font-size: clamp(2.3rem, 6.5vw, 4.6rem);
  line-height: 1.05;
  letter-spacing: -0.01em;
  overflow-wrap: break-word;
}

.experience-intro {
  width: min(700px, 100%);
  margin: 1.5rem auto 0;
  color: var(--color-text);
  font-size: 1rem;
  line-height: 1.6;
  text-align: center;
}

/* TIMELINE WRAPPER */

.experience-shell .experience-timeline {
  width: 100%;
  margin: 0 auto 2rem;
  padding: 3rem 2rem 4rem;
  background: rgba(255, 255, 255, 0.85);
  border: 1px solid rgba(0, 0, 0, 0.05);
  border-radius: 12px;
  box-shadow: 0 4px 20px rgba(0, 0, 0, 0.05);
  box-sizing: border-box;
  overflow: hidden;
}

.experience-shell .experience-timeline:last-child {
  margin-bottom: 0;
}

.experience-card {
  width: 100%;
  min-width: 0;
  max-width: 100%;
  box-sizing: border-box;
  overflow: hidden;
  background: rgba(255, 255, 255, 0.9);
  border: 1px solid rgba(0, 0, 0, 0.1);
  border-radius: 12px;
  padding: 2.5rem;
  box-shadow: 0 4px 20px rgba(0, 0, 0, 0.05);
  backdrop-filter: blur(4px);
}

/* HERO IMAGE */

.hero-section {
  padding: 0 !important;
  background: transparent !important;
  border: none !important;
  box-shadow: none !important;
  overflow: visible !important;
}

.hero-image-wrap {
  position: relative;
  width: 100%;
  aspect-ratio: 16 / 7;
  border-radius: 14px;
  overflow: hidden;
  box-shadow: 0 10px 30px rgba(0, 0, 0, 0.18);
}

.hero-image-wrap img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
  filter: saturate(1.05);
}

/* =========================================================
   SECTIONS — kicker "NN · LABEL" + título grande
   ========================================================= */

.experience-section {
  width: 100%;
  min-width: 0;
  padding: 2.75rem 0;
  border-bottom: 1px solid rgba(0, 0, 0, 0.08);
}

.experience-section:last-of-type {
  border-bottom: none;
}

.section-kicker {
  margin: 0 0 0.6rem;
  color: var(--color-accent);
  font-size: 0.75rem;
  font-weight: 700;
  letter-spacing: 0.14em;
  text-transform: uppercase;
}

.experience-section h2 {
  margin: 0 0 1.2rem;
  color: var(--color-deep);
  font-size: clamp(1.4rem, 3.2vw, 2.1rem);
  font-weight: 700;
  line-height: 1.2;
  overflow-wrap: anywhere;
}

.experience-gallery-section h3 {
