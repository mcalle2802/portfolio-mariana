---
import "../../../styles/global.css";
import Navbar from "../../../components/Navbar.astro";
import Footer from "../../../components/Footer.astro";

const systemOverview = [
  { label: "Microcontrolador", value: "ESP32" },
  { label: "Protocolo", value: "MQTT" },
  { label: "Backend", value: "Node.js, PHP, MySQL (vía MAMP)" },
  { label: "Admin. de Base de Datos", value: "phpMyAdmin" },
  { label: "Visualización", value: "Grafana" },
  { label: "Diseño de PCB", value: "KiCad" },
];

/*
  ============================================================
  GALLERY
  13 fotos, mismo componente de carrusel + lightbox que
  scara.astro / robot.astro.
  ============================================================
*/
const gallery = [
  { type: "image", src: "/projects/iot/iot1.jpeg", alt: "Smart Home IoT System 1" },
  { type: "image", src: "/projects/iot/iot2.jpeg", alt: "Smart Home IoT System 2" },
  { type: "image", src: "/projects/iot/iot3.jpeg", alt: "Smart Home IoT System 3" },
  { type: "image", src: "/projects/iot/iot4.jpeg", alt: "Smart Home IoT System 4" },
  { type: "image", src: "/projects/iot/iot5.jpeg", alt: "Smart Home IoT System 5" },
  { type: "image", src: "/projects/iot/iot6.jpeg", alt: "Smart Home IoT System 6" },
  { type: "image", src: "/projects/iot/iot7.jpeg", alt: "Smart Home IoT System 7" },
  { type: "image", src: "/projects/iot/iot8.jpeg", alt: "Smart Home IoT System 8" },
  { type: "image", src: "/projects/iot/iot9.jpeg", alt: "Smart Home IoT System 9" },
  { type: "image", src: "/projects/iot/iot10.jpeg", alt: "Smart Home IoT System 10" },
  { type: "image", src: "/projects/iot/iot11.jpeg", alt: "Smart Home IoT System 11" },
  { type: "image", src: "/projects/iot/iot12.jpeg", alt: "Smart Home IoT System 12" },
  { type: "image", src: "/projects/iot/iot13.jpeg", alt: "Smart Home IoT System 13" },
];
---

<html lang="es">
  <head>
    <meta charset="UTF-8" />

    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0"
    />

    <meta
      name="description"
      content="Sistema IoT de casa inteligente — proyecto de backend, integración MQTT y visualización de datos de Mariana Calle Méndez."
    />

    <title>Sistema IoT de Casa Inteligente — Mariana Calle</title>
  </head>

  <body>

    <Navbar />

    <main class="experience-bg">

      <div class="experience-shell">

        <!-- =====================================================
             HEADER
        ====================================================== -->

        <section class="experience-header">

          <h1>
            SISTEMA IOT DE CASA INTELIGENTE
          </h1>

          <p class="experience-intro">
            Un ecosistema de hogar conectado que une luces, cortinas
            y una impresora 3D a través de MQTT, un backend en
            Node.js/PHP, y dashboards de Grafana en tiempo real.
          </p>

        </section>


        <!-- HERO IMAGE -->

        <section class="experience-timeline hero-section">

          <div class="hero-image-wrap">

            <img
              src="/projects/iot.jpeg"
              alt="Sistema IoT de Casa Inteligente"
            />

          </div>

        </section>


        <!-- =====================================================
             MAIN CONTENT CARD
        ====================================================== -->

        <section class="experience-timeline">

          <div class="experience-card project-card">

            <!-- =================================================
                 01 · INTRODUCTION
            ================================================== -->

            <div class="experience-section">

              <p class="section-kicker">
                01 · INTRODUCCIÓN
              </p>

              <h2>
                Información del Proyecto
              </h2>

              <div class="hardware-grid">

                <div class="hardware-item">
                  <span class="hardware-label">Fecha del proyecto</span>
                  <span class="hardware-value">2025</span>
                </div>

                <div class="hardware-item">
                  <span class="hardware-label">Tipo de proyecto</span>
                  <span class="hardware-value">Proyecto en equipo</span>
                </div>

                <div class="hardware-item">
                  <span class="hardware-label">Mi rol</span>
                  <span class="hardware-value">Desarrollo Backend, Integración MQTT y Visualización de Datos</span>
                </div>

              </div>

            </div>


            <!-- =================================================
                 02 · THE CHALLENGE
            ================================================== -->

            <div class="experience-section">

              <p class="section-kicker">
                02 · EL RETO
              </p>

              <h2>
                La Idea
              </h2>

              <p>
                El objetivo de este proyecto era desarrollar un
                <strong>ecosistema de hogar conectado</strong> que
                reuniera distintos dispositivos domésticos a través
                de una plataforma IoT centralizada. La idea era hacer
                más cómodas las interacciones cotidianas, permitiendo
                a los usuarios controlar dispositivos de forma
                remota, automatizar ciertas tareas y monitorear datos
                ambientales en tiempo real.
              </p>

              <p>
                El sistema se diseñó alrededor de un microcontrolador
                <strong>ESP32</strong>, usando <strong>MQTT</strong>
                como protocolo de comunicación para conectar el
                hardware con la plataforma de software. Exploramos la
                integración de distintos dispositivos, incluyendo
                iluminación LED, cortinas blackout motorizadas y una
                impresora 3D, considerando también asistentes de voz
                como una forma adicional de interactuar con el
                sistema.
              </p>

              <p>
                Más allá de controlar dispositivos individuales,
                queríamos crear una plataforma que pudiera recolectar
                y mostrar información del hogar, conectando hardware,
                servicios de backend y visualización de datos en un
                solo ecosistema integrado.
              </p>

            </div>


            <!-- =================================================
                 03 · MY CONTRIBUTION
            ================================================== -->

            <div class="experience-section">

              <p class="section-kicker">
                03 · MI APORTE
              </p>

              <h2>
                Backend y Visualización de Datos
              </h2>

              <p>
                Mi responsabilidad principal fue el desarrollo y las
                pruebas de los componentes de software que conectaban
                las distintas partes del sistema de casa inteligente.
                Trabajé principalmente en el backend, implementando
                la comunicación entre <strong>Node.js</strong>,
                <strong>PHP</strong> y <strong>MySQL</strong>, y
                administrando la base de datos a través de
                <em>phpMyAdmin</em>.
              </p>

              <p>
                También configuré la comunicación por <strong>MQTT</strong>
                desde el backend, permitiendo el intercambio de datos
                entre la plataforma de software y los dispositivos
                conectados. Para probar estas integraciones, trabajé
                con un servidor local de <em>MAMP</em>, verificando la
                comunicación y asegurando que los distintos servicios
                pudieran funcionar juntos.
              </p>

              <p>
                En cuanto a la visualización, configuré y diseñé
                dashboards de <strong>Grafana</strong> para mostrar la
                información recolectada en tiempo real. Esto dio una
                forma clara de monitorear los datos del sistema e
                hizo más fácil de entender la información generada por
                los dispositivos conectados.
              </p>

              <p>
                También colaboré con el equipo durante el proceso
                inicial de diseño del PCB en <strong>KiCad</strong>.
                Aunque mi enfoque principal era el desarrollo de
                software, esto me dio la oportunidad de participar en
                el diseño general del sistema y entender cómo debían
                trabajar juntos los componentes de hardware y
                software.
              </p>

              <div class="tags">
                <span>Node.js</span>
                <span>PHP</span>
                <span>MySQL</span>
                <span>MQTT</span>
                <span>Grafana</span>
                <span>KiCad</span>
              </div>

            </div>


            <!-- =================================================
                 04 · FROM DESIGN TO REALITY
            ================================================== -->

            <div class="experience-section">

              <p class="section-kicker">
                04 · DEL DISEÑO A LA REALIDAD
              </p>

              <h2>
                Dándole Vida al Sistema
              </h2>

              <p>
                El proceso de desarrollo comenzó con el diseño
                colaborativo de la tarjeta electrónica en
                <strong>KiCad</strong>, que estableció la base de
                hardware del proyecto. Mientras el equipo trabajaba
                en el diseño electrónico, me enfoqué en desarrollar
                la infraestructura de software responsable de
                manejar y mostrar los datos del sistema.
              </p>

              <p>
                Implementé la comunicación entre Node.js, PHP y
                MySQL, usando un servidor local de MAMP para
                desarrollar y probar los servicios de backend.
                También configuré la comunicación por MQTT desde el
                backend, estableciendo la estructura de mensajería
                necesaria para intercambiar información dentro de la
                plataforma IoT.
              </p>

              <p>
                Una vez listos los componentes del backend, me
                enfoqué en la visualización de datos. Configuré
                Grafana y diseñé dashboards para mostrar la
                información entrante en tiempo real, facilitando el
                monitoreo de los datos recolectados por el sistema.
                A lo largo del proceso, realicé pruebas para
                verificar la comunicación entre los distintos
                servicios y asegurar que los datos pudieran
                almacenarse, recuperarse y visualizarse
                correctamente.
              </p>

              <div class="hardware-grid">
                {
                  systemOverview.map((item) => (
                    <div class="hardware-item">
                      <span class="hardware-label">{item.label}</span>
                      <span class="hardware-value">{item.value}</span>
                    </div>
                  ))
                }
              </div>

            </div>


            <!-- GALLERY -->

            <div class="experience-gallery-section">

              <h3>
                Galería del Proyecto
              </h3>

              <div class="gallery-container">

                <div class="gallery-slider">

                  {
                    gallery.map((item, i) => (
                      item.type === "video" ? (
                        <video
                          src={item.src}
                          class:list={{ active: i === 0 }}
                          muted
                          loop
                          playsinline
                          preload="metadata"
                        />
                      ) : (
                        <img
                          src={item.src}
                          alt={item.alt}
                          class:list={{ active: i === 0 }}
                          loading={i === 0 ? "eager" : "lazy"}
                        />
                      )
                    ))
                  }

                </div>


                <button
                  class="gallery-btn prev"
                  type="button"
                  aria-label="Elemento anterior"
                >
                  ❮
                </button>


                <button
                  class="gallery-btn next"
                  type="button"
                  aria-label="Siguiente elemento"
                >
                  ❯
                </button>


                <div class="gallery-counter">

                  <span id="gallery-current">
                    1
                  </span>

                  /

                  <span>
                    {gallery.length}
                  </span>

                </div>

              </div>

            </div>


            <!-- =================================================
                 05 · RESULTS
            ================================================== -->

            <div class="experience-section learning-section">

              <p class="section-kicker">
                05 · RESULTADOS
              </p>

              <h2>
                El Resultado
              </h2>

              <p>
                El proyecto dio como resultado una infraestructura de
                software funcional para una plataforma IoT de casa
                inteligente. El backend conectaba Node.js, PHP y
                MySQL, mientras que MQTT proporcionaba la capa de
                comunicación para intercambiar información. Los
                dashboards de Grafana permitieron visualizar los
                datos del sistema en tiempo real.
              </p>

              <p>
                A través del proceso de desarrollo y pruebas,
                sentamos las bases para conectar dispositivos de
                hardware con servicios de backend y monitorear su
                información a través de una plataforma centralizada.
              </p>

              <p>
                Para mí, este proyecto fue una oportunidad de
                explorar un lado distinto de la ingeniería
                mecatrónica, trabajando con infraestructura de
                servidores, protocolos de comunicación, bases de
                datos y visualización de datos para entender cómo el
                software puede conectar y dar soporte a sistemas
                físicos.
              </p>

              <blockquote>
                Una oportunidad de explorar un lado distinto de la
                ingeniería mecatrónica — donde el software se
                convierte en la capa que conecta y sostiene a los
                sistemas físicos.
              </blockquote>

            </div>


            <!-- BACK LINK -->

            <div class="back-link-wrap">
              <a href="/es/projects" class="back-link-pill">
                <span>←</span>
                Volver a Proyectos
              </a>
            </div>

          </div>

        </section>

      </div>

    </main>


    <!-- =======================================================
         LIGHTBOX
    ======================================================== -->

    <div
      id="lightbox"
      class="lightbox"
      aria-hidden="true"
    >

      <button
        class="close"
        type="button"
        aria-label="Cerrar visor"
      >
        &times;
      </button>


      <button
        class="lightbox-nav prev"
        type="button"
        aria-label="Elemento anterior"
      >
        ❮
      </button>


      <img
        id="lightbox-img"
        class="lightbox-content"
        src=""
        alt=""
      />

      <video
        id="lightbox-video"
        class="lightbox-content"
        controls
        playsinline
      />


      <button
        class="lightbox-nav next"
        type="button"
        aria-label="Siguiente elemento"
      >
        ❯
      </button>


      <div class="lightbox-counter">

        <span id="lightbox-current">
          1
        </span>

        /

        <span>
          {gallery.length}
        </span>

      </div>

    </div>


    <Footer />


    <!-- =======================================================
         GALLERY SCRIPT
    ======================================================== -->

    <script>
      const items =
        Array.from(
          document.querySelectorAll<HTMLImageElement | HTMLVideoElement>(
            ".gallery-slider img, .gallery-slider video"
          )
        );

      const nextBtn =
        document.querySelector<HTMLButtonElement>(
          ".gallery-btn.next"
        );

      const prevBtn =
        document.querySelector<HTMLButtonElement>(
          ".gallery-btn.prev"
        );

      const lightbox =
        document.getElementById("lightbox");

      const lightboxImg =
        document.getElementById(
          "lightbox-img"
        ) as HTMLImageElement | null;

      const lightboxVideo =
        document.getElementById(
          "lightbox-video"
        ) as HTMLVideoElement | null;

      const closeBtn =
        document.querySelector<HTMLButtonElement>(
          ".lightbox .close"
        );

      const nextLightbox =
        document.querySelector<HTMLButtonElement>(
          ".lightbox-nav.next"
        );

      const prevLightbox =
        document.querySelector<HTMLButtonElement>(
          ".lightbox-nav.prev"
        );

      const galleryCurrent =
        document.getElementById(
          "gallery-current"
        );

      const lightboxCurrent =
        document.getElementById(
          "lightbox-current"
        );

      let index = 0;

      /* =====================================================
         SHOW ITEM
      ====================================================== */

      function showItem(newIndex: number) {
        if (!items.length) {
          return;
        }

        index =
          (newIndex + items.length) %
          items.length;

        items.forEach(
          (item, i) => {
            const isActive = i === index;

            item.classList.toggle(
              "active",
              isActive
            );

            if (item.tagName === "VIDEO") {
              const video = item as HTMLVideoElement;

              if (isActive) {
                video.play().catch(() => {});
              } else {
                video.pause();
                video.currentTime = 0;
              }
            }
          }
        );

        if (galleryCurrent) {
          galleryCurrent.textContent =
            String(index + 1);
        }
      }

      /* =====================================================
         NEXT / PREVIOUS
      ====================================================== */

      function nextItem() {
        showItem(index + 1);
      }

      function previousItem() {
        showItem(index - 1);
      }

      nextBtn?.addEventListener(
        "click",
        nextItem
      );

      prevBtn?.addEventListener(
        "click",
        previousItem
      );

      /* =====================================================
         LIGHTBOX
      ====================================================== */

      function renderLightbox() {
        if (
          !lightboxImg ||
          !lightboxVideo ||
          !items[index]
        ) {
          return;
        }

        const current = items[index];

        if (current.tagName === "VIDEO") {
          lightboxVideo.src = current.getAttribute("src") ?? "";
          lightboxVideo.style.display = "block";
          lightboxVideo.play().catch(() => {});

          lightboxImg.style.display = "none";
        } else {
          lightboxImg.src = (current as HTMLImageElement).src;
          lightboxImg.alt = (current as HTMLImageElement).alt;
          lightboxImg.style.display = "block";

          lightboxVideo.pause();
          lightboxVideo.style.display = "none";
        }

        if (lightboxCurrent) {
          lightboxCurrent.textContent =
            String(index + 1);
        }
      }

      function openLightbox(itemIndex: number) {
        if (
          !lightbox ||
          !items[itemIndex]
        ) {
          return;
        }

        index = itemIndex;

        renderLightbox();

        lightbox.classList.add("open");

        lightbox.setAttribute(
          "aria-hidden",
          "false"
        );

        document.body.style.overflow =
          "hidden";
      }

      function closeLightbox() {
        if (!lightbox) {
          return;
        }

        lightboxVideo?.pause();

        lightbox.classList.remove("open");

        lightbox.setAttribute(
          "aria-hidden",
          "true"
        );

        document.body.style.overflow =
          "";
      }

      function updateLightbox(direction: number) {
        lightboxVideo?.pause();

        showItem(
          index + direction
        );

        renderLightbox();
      }

      items.forEach(
        (item, i) => {
          item.addEventListener(
            "click",
            () => {
              openLightbox(i);
            }
          );
        }
      );

      nextLightbox?.addEventListener(
        "click",
        () => {
          updateLightbox(1);
        }
      );

      prevLightbox?.addEventListener(
        "click",
        () => {
          updateLightbox(-1);
        }
      );

      closeBtn?.addEventListener(
        "click",
        closeLightbox
      );

      document.addEventListener(
        "keydown",
        (event) => {
          if (
            lightbox?.classList.contains(
              "open"
            )
          ) {
            if (
              event.key ===
              "ArrowRight"
            ) {
              event.preventDefault();
              updateLightbox(1);
            }

            if (
              event.key ===
              "ArrowLeft"
            ) {
              event.preventDefault();
              updateLightbox(-1);
            }

            if (
              event.key ===
              "Escape"
            ) {
              event.preventDefault();
              closeLightbox();
            }

            return;
          }

          if (
            event.key ===
            "ArrowRight"
          ) {
            nextItem();
          }

          if (
            event.key ===
            "ArrowLeft"
          ) {
            previousItem();
          }
        }
      );

      lightbox?.addEventListener(
        "click",
        (event) => {
          if (
            event.target ===
            lightbox
          ) {
            closeLightbox();
          }
        }
      );

      showItem(0);
    </script>

  </body>
</html>


<style>
/* =========================================================
   Mismas clases base que scara.astro / robot.astro.
   ========================================================= */

.experience-bg {
  width: 100%;
  min-height: 100vh;
  margin: 0;
  padding: 3rem 0 5rem;
  background-image: url("/textures/paper-texture.png");
  background-size: cover;
  background-position: center;
  background-attachment: fixed;
  background-color: transparent;
  box-sizing: border-box;
  overflow-x: hidden;
}

.experience-shell {
  width: 100%;
  max-width: 1200px;
  margin: 1rem auto 0;
  padding: 2rem;
  background: rgba(255, 255, 255, 0.78);
  border: 1px solid rgba(0, 0, 0, 0.05);
  border-radius: 16px;
  box-shadow: 0 4px 25px rgba(0, 0, 0, 0.08);
  backdrop-filter: blur(4px);
  box-sizing: border-box;
}

.experience-shell .experience-header {
  width: 100%;
  max-width: 950px;
  margin: 0 auto 2rem;
  padding: 3rem 2.5rem;
  text-align: center;
  background: rgba(255, 255, 255, 0.9);
  border: 1px solid rgba(0, 0, 0, 0.05);
  border-radius: 12px;
  box-shadow: 0 4px 15px rgba(0, 0, 0, 0.05);
  box-sizing: border-box;
  overflow: hidden;
}

.experience-header h1 {
  margin: 0;
  color: var(--color-deep);
  font-size: clamp(2.3rem, 6.5vw, 4.6rem);
  line-height: 1.05;
  letter-spacing: -0.01em;
  overflow-wrap: break-word;
}

.experience-intro {
  width: min(700px, 100%);
  margin: 1.5rem auto 0;
  color: var(--color-text);
  font-size: 1rem;
  line-height: 1.6;
  text-align: center;
}

.experience-shell .experience-timeline {
  width: 100%;
  margin: 0 auto 2rem;
  padding: 3rem 2rem 4rem;
  background: rgba(255, 255, 255, 0.85);
  border: 1px solid rgba(0, 0, 0, 0.05);
  border-radius: 12px;
  box-shadow: 0 4px 20px rgba(0, 0, 0, 0.05);
  box-sizing: border-box;
  overflow: hidden;
}

.experience-shell .experience-timeline:last-child {
  margin-bottom: 0;
}

.experience-card {
  width: 100%;
  min-width: 0;
  max-width: 100%;
  box-sizing: border-box;
  overflow: hidden;
  background: rgba(255, 255, 255, 0.9);
  border: 1px solid rgba(0, 0, 0, 0.1);
  border-radius: 12px;
  padding: 2.5rem;
  box-shadow: 0 4px 20px rgba(0, 0, 0, 0.05);
  backdrop-filter: blur(4px);
}

/* HERO IMAGE */

.hero-section {
  padding: 0 !important;
  background: transparent !important;
  border: none !important;
  box-shadow: none !important;
  overflow: visible !important;
}

.hero-image-wrap {
  position: relative;
  width: 100%;
  aspect-ratio: 16 / 7;
  border-radius: 14px;
  overflow: hidden;
  box-shadow: 0 10px 30px rgba(0, 0, 0, 0.18);
}

.hero-image-wrap img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
  filter: saturate(1.05);
}

/* SECTIONS */

.experience-section {
  width: 100%;
  min-width: 0;
  padding: 2.75rem 0;
  border-bottom: 1px solid rgba(0, 0, 0, 0.08);
}

.experience-section:last-of-type {
  border-bottom: none;
}

.section-kicker {
  margin: 0 0 0.6rem;
  color: var(--color-accent);
  font-size: 0.75rem;
  font-weight: 700;
  letter-spacing: 0.14em;
  text-transform: uppercase;
}

.experience-section h2 {
  margin: 0 0 1.2rem;
  color: var(--color-deep);
  font-size: clamp(1.4rem, 3.2vw, 2.1rem);
  font-weight: 700;
  line-height: 1.2;
  overflow-wrap: anywhere;
}

.experience-section p {
  width: 100%;
  max-width: 100%;
  min-width: 0;
  margin: 0 0 1rem;
  color: var(--color-text);
  font-size: 0.98rem;
  line-height: 1.6;
  text-align: justify;
  overflow-wrap: anywhere;
}

.experience-section p:last-of-type {
  margin-bottom: 0;
}

.learning-section blockquote {
  margin: 1.5rem 0 0;
  padding: 1.2rem 1.5rem;
  border-left: 3px solid var(--color-accent);
  background: rgba(255, 255, 255, 0.5);
  color: var(--color-deep);
  font-size: 1.05rem;
  font-style: italic;
  line-height: 1.6;
}

/* TAGS */

.tags {
  display: flex;
  flex-wrap: wrap;
  gap: 0.55rem;
  width: 100%;
  margin-top: 1.5rem;
}

.tags span {
  max-width: 100%;
  padding: 0.4rem 0.75rem;
  border: 1px solid rgba(0, 0, 0, 0.12);
  border-radius: 999px;
  background: rgba(255, 255, 255, 0.6);
  color: var(--color-deep);
  font-size: 0.75rem;
