    <!-- =======================================================

         LIGHTBOX

    ======================================================== -->



    <div

      id="lightbox"

      class="lightbox"

      aria-hidden="true"

    >



      <button

        class="close"

        type="button"

        aria-label="Cerrar visor"

      >

        &times;

      </button>





      <button

        class="lightbox-nav prev"

        type="button"

        aria-label="Elemento anterior"

      >

        ❮

      </button>





      <img

        id="lightbox-img"

        class="lightbox-content"

        src=""

        alt=""

      />



      <video

        id="lightbox-video"

        class="lightbox-content"

        controls

        playsinline

      />





      <button

        class="lightbox-nav next"

        type="button"

        aria-label="Elemento siguiente"

      >

        ❯

      </button>





      <div class="lightbox-counter">



        <span id="lightbox-current">

          1

        </span>



        /



        <span>

          {gallery.length}

        </span>



      </div>



    </div>





    <Footer />





    <!-- =======================================================

         GALLERY SCRIPT

    ======================================================== -->



    <script>

      const items =

        Array.from(

          document.querySelectorAll<HTMLImageElement | HTMLVideoElement>(

            ".gallery-slider img, .gallery-slider video"

          )

        );



      const nextBtn =

        document.querySelector<HTMLButtonElement>(

          ".gallery-btn.next"

        );



      const prevBtn =

        document.querySelector<HTMLButtonElement>(

          ".gallery-btn.prev"

        );



      const lightbox =

        document.getElementById("lightbox");



      const lightboxImg =

        document.getElementById(

          "lightbox-img"

        ) as HTMLImageElement | null;



      const lightboxVideo =

        document.getElementById(

          "lightbox-video"

        ) as HTMLVideoElement | null;



      const closeBtn =

        document.querySelector<HTMLButtonElement>(

          ".lightbox .close"

        );



      const nextLightbox =

        document.querySelector<HTMLButtonElement>(

          ".lightbox-nav.next"

        );



      const prevLightbox =

        document.querySelector<HTMLButtonElement>(

          ".lightbox-nav.prev"

        );



      const galleryCurrent =

        document.getElementById(

          "gallery-current"

        );



      const lightboxCurrent =

        document.getElementById(

          "lightbox-current"

        );



      let index = 0;



      /* =====================================================

         SHOW ITEM

      ====================================================== */



      function showItem(newIndex: number) {

        if (!items.length) {

          return;

        }



        index =

          (newIndex + items.length) %

          items.length;



        items.forEach(

          (item, i) => {

            const isActive = i === index;



            item.classList.toggle(

              "active",

              isActive

            );



            if (item.tagName === "VIDEO") {

              const video = item as HTMLVideoElement;



              if (isActive) {

                video.play().catch(() => {});

              } else {

                video.pause();

                video.currentTime = 0;

              }

            }

          }

        );



        if (galleryCurrent) {

          galleryCurrent.textContent =

            String(index + 1);

        }

      }



      /* =====================================================

         NEXT / PREVIOUS

      ====================================================== */



      function nextItem() {

        showItem(index + 1);

      }



      function previousItem() {

        showItem(index - 1);

      }



      nextBtn?.addEventListener(

        "click",

        nextItem

      );



      prevBtn?.addEventListener(

        "click",

        previousItem

      );



      /* =====================================================

         LIGHTBOX

      ====================================================== */



      function renderLightbox() {

        if (

          !lightboxImg ||

          !lightboxVideo ||

          !items[index]

        ) {

          return;

        }



        const current = items[index];



        if (current.tagName === "VIDEO") {

          lightboxVideo.src = current.getAttribute("src") ?? "";

          lightboxVideo.style.display = "block";

          lightboxVideo.play().catch(() => {});



          lightboxImg.style.display = "none";

        } else {

          lightboxImg.src = (current as HTMLImageElement).src;

          lightboxImg.alt = (current as HTMLImageElement).alt;

          lightboxImg.style.display = "block";



          lightboxVideo.pause();

          lightboxVideo.style.display = "none";

        }



        if (lightboxCurrent) {

          lightboxCurrent.textContent =

            String(index + 1);

        }

      }



      function openLightbox(itemIndex: number) {

        if (

          !lightbox ||

          !items[itemIndex]

        ) {

          return;

        }



        index = itemIndex;



        renderLightbox();



        lightbox.classList.add("open");



        lightbox.setAttribute(

          "aria-hidden",

          "false"

        );



        document.body.style.overflow =

          "hidden";

      }



      function closeLightbox() {

        if (!lightbox) {

          return;

        }



        lightboxVideo?.pause();



        lightbox.classList.remove("open");



        lightbox.setAttribute(

          "aria-hidden",

          "true"

        );



        document.body.style.overflow =

          "";

      }



      function updateLightbox(direction: number) {

        lightboxVideo?.pause();



        showItem(

          index + direction

        );



        renderLightbox();

      }



      items.forEach(

        (item, i) => {

          item.addEventListener(

            "click",

            () => {

              openLightbox(i);

            }

          );

        }

      );



      nextLightbox?.addEventListener(

        "click",

        () => {

          updateLightbox(1);

        }

      );



      prevLightbox?.addEventListener(

        "click",

        () => {

          updateLightbox(-1);

        }

      );



      closeBtn?.addEventListener(

        "click",

        closeLightbox

      );



      document.addEventListener(

        "keydown",

        (event) => {

          if (

            lightbox?.classList.contains(

              "open"

            )

          ) {

            if (

              event.key ===

              "ArrowRight"

            ) {

              event.preventDefault();

              updateLightbox(1);

            }



            if (

              event.key ===

              "ArrowLeft"

            ) {

              event.preventDefault();

              updateLightbox(-1);

            }



            if (

              event.key ===

              "Escape"

            ) {

              event.preventDefault();

              closeLightbox();

            }



            return;

          }



          if (

            event.key ===

            "ArrowRight"

          ) {

            nextItem();

          }



          if (

            event.key ===

            "ArrowLeft"

          ) {

            previousItem();

          }

        }

      );



      lightbox?.addEventListener(

        "click",

        (event) => {

          if (

            event.target ===

            lightbox

          ) {

            closeLightbox();

          }

        }

      );



      showItem(0);

    </script>



  </body>

</html>





