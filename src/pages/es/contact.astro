---
import "../../styles/global.css";
import Navbar from "../../components/Navbar.astro";
import Footer from "../../components/Footer.astro";
---

<html lang="es">
  <head>
    <meta charset="UTF-8" />

    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0"
    />

    <meta
      name="description"
      content="Ponte en contacto con Mariana Calle Méndez."
    />

    <title>Contacto — Mariana Calle</title>
  </head>

  <body>
    <Navbar />

    <main class="experience-bg">

      <div class="experience-shell">

        <!-- =====================================================
             HEADER
        ====================================================== -->

        <section class="experience-header">

          <p class="section-label">
            PONTE EN CONTACTO
          </p>

          <h1>
            CONECTEMOS
          </h1>

          <p class="experience-intro">
            Siempre estoy abierta a colaboraciones, ideas, o
            simplemente una charla amistosa sobre robótica.
          </p>

        </section>


        <!-- =====================================================
             CONTACT CARD
        ====================================================== -->

        <section class="experience-timeline">

          <div class="experience-card contact-card">

            <form
              name="contact"
              method="POST"
              data-netlify="true"
              class="contact-form"
            >

              <div class="form-field">
                <label for="name">Nombre</label>
                <input
                  id="name"
                  type="text"
                  name="name"
                  placeholder="Tu nombre"
                  required
                />
              </div>

              <div class="form-field">
                <label for="email">Correo</label>
                <input
                  id="email"
                  type="email"
                  name="email"
                  placeholder="Tu correo"
                  required
                />
              </div>

              <div class="form-field">
                <label for="message">Mensaje</label>
                <textarea
                  id="message"
                  name="message"
                  rows="6"
                  placeholder="Tu mensaje"
                  required
                ></textarea>
              </div>

              <button type="submit">
                Enviar mensaje
              </button>

            </form>


            <div class="contact-divider">
              <span>o contáctame directamente</span>
            </div>


            <div class="social-links">

              <a href="mailto:mcalle28@gmail.com">
                <span class="social-icon" aria-hidden="true">✉️</span>
                Correo
              </a>

              <a
                href="https://www.linkedin.com/in/mariana-calle-244024384"
                target="_blank"
                rel="noopener noreferrer"
              >
                <span class="social-icon" aria-hidden="true">🔗</span>
                LinkedIn
              </a>

              <a
                href="https://github.com/mcalle2802"
                target="_blank"
                rel="noopener noreferrer"
              >
                <span class="social-icon" aria-hidden="true">💻</span>
                GitHub
              </a>

            </div>

          </div>

        </section>

      </div>

    </main>

    <Footer />
  </body>
</html>


<style>
/* =========================================================
   Mismas clases y mismos valores que experience.astro /
   certifications.astro / projects.astro / hobbies.astro,
   para conservar exactamente la misma estética y el mismo
   centrado.
   ========================================================= */

.experience-bg {
  width: 100%;
  min-height: 100vh;
  margin: 0;
  padding: 3rem 0 5rem;
  background-image: url("/textures/paper-texture.png");
  background-size: cover;
  background-position: center;
  background-attachment: fixed;
  background-color: transparent;
  box-sizing: border-box;
  overflow-x: hidden;
}

.experience-shell {
  width: 100%;
  max-width: 1200px;
  margin: 1rem auto 0;
  padding: 2rem;
  background: rgba(255, 255, 255, 0.78);
  border: 1px solid rgba(0, 0, 0, 0.05);
  border-radius: 16px;
  box-shadow: 0 4px 25px rgba(0, 0, 0, 0.08);
  backdrop-filter: blur(4px);
  box-sizing: border-box;
}

/* =========================================================
   HEADER
   ========================================================= */

.experience-shell .experience-header {
  width: 100%;
  max-width: 950px;
  margin: 0 auto 2rem;
  padding: 3rem 2.5rem;

  text-align: center;

  background: rgba(255, 255, 255, 0.9);
  border: 1px solid rgba(0, 0, 0, 0.05);
  border-radius: 12px;
  box-shadow: 0 4px 15px rgba(0, 0, 0, 0.05);

  box-sizing: border-box;
  overflow: hidden;
}

.section-label {
  margin: 0 0 0.8rem;
  color: var(--color-accent);
  font-size: 0.75rem;
  font-weight: 700;
  letter-spacing: 0.18em;
}

.experience-header h1 {
  margin: 0;
  color: var(--color-deep);
  font-size: clamp(2.3rem, 6.5vw, 4.6rem);
  line-height: 1.05;
  letter-spacing: -0.01em;
  overflow-wrap: break-word;
}

.experience-intro {
  width: min(700px, 100%);
  margin: 1.5rem auto 0;
  color: var(--color-text);
  font-size: 1rem;
  line-height: 1.6;
  text-align: center;
}

/* =========================================================
   TIMELINE / CARD WRAPPER
   ========================================================= */

.experience-shell .experience-timeline {
  width: 100%;
  margin: 0 auto;
  padding: 3rem 2rem 4rem;

  background: rgba(255, 255, 255, 0.85);
  border: 1px solid rgba(0, 0, 0, 0.05);
  border-radius: 12px;
  box-shadow: 0 4px 20px rgba(0, 0, 0, 0.05);

  box-sizing: border-box;
  overflow: hidden;
}

.experience-card {
  width: 100%;
  min-width: 0;
  max-width: 100%;
  box-sizing: border-box;

  overflow: hidden;

  background: rgba(255, 255, 255, 0.9);
  border: 1px solid rgba(0, 0, 0, 0.1);
  border-radius: 12px;
  padding: 2.5rem;

  box-shadow: 0 4px 20px rgba(0, 0, 0, 0.05);
  backdrop-filter: blur(4px);
}

/* =========================================================
   CONTACT FORM
   ========================================================= */

.contact-card {
  max-width: 600px;
  margin: 0 auto;
}

.contact-form {
  display: flex;
  flex-direction: column;
  gap: 1.25rem;
}

.form-field {
  display: flex;
  flex-direction: column;
  gap: 0.4rem;
}

.form-field label {
  color: var(--color-deep);
  font-size: 0.78rem;
  font-weight: 700;
  letter-spacing: 0.04em;
  text-transform: uppercase;
}

input,
textarea {
  padding: 0.8rem 1rem;
  border: 1px solid rgba(0, 0, 0, 0.12);
  border-radius: 8px;
  background: rgba(255, 255, 255, 0.7);
  color: var(--color-deep);
  font-family: var(--font-body);
  font-size: 0.95rem;

  box-sizing: border-box;
  transition: border-color 0.2s ease, box-shadow 0.2s ease;
}

input::placeholder,
textarea::placeholder {
  color: var(--color-text);
  opacity: 0.6;
}

input:focus,
textarea:focus {
  outline: none;
  border-color: var(--color-accent);
  box-shadow: 0 0 0 3px rgba(185, 60, 26, 0.12);
}

textarea {
  resize: vertical;
  min-height: 140px;
}

button[type="submit"] {
  align-self: flex-start;

  padding: 0.85rem 1.75rem;

  background: var(--color-accent);
  color: var(--color-bg);
  border: none;
  border-radius: 8px;

  font-family: var(--font-body);
  font-size: 0.9rem;
  font-weight: 700;
  letter-spacing: 0.02em;

  cursor: pointer;
  transition: background-color 0.25s ease, transform 0.25s ease;
}

button[type="submit"]:hover {
  background-color: var(--color-deep);
  transform: translateY(-2px);
}

/* =========================================================
   DIVIDER + SOCIAL LINKS
   ========================================================= */

.contact-divider {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;

  margin: 2.25rem 0 1.75rem;
}

.contact-divider::before,
.contact-divider::after {
  content: "";
  flex: 1;
  height: 1px;
  background: rgba(0, 0, 0, 0.1);
}

.contact-divider span {
  padding: 0 1rem;
  color: var(--color-text);
  font-size: 0.75rem;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  white-space: nowrap;
}

.social-links {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 1.5rem;
}

.social-links a {
  display: inline-flex;
  align-items: center;
  gap: 0.5rem;

  padding: 0.6rem 1.1rem;

  border: 1px solid rgba(0, 0, 0, 0.1);
  border-radius: 999px;
  background: rgba(255, 255, 255, 0.6);

  color: var(--color-deep);
  font-size: 0.85rem;
  font-weight: 600;
  text-decoration: none;

  transition: border-color 0.25s ease, color 0.25s ease, transform 0.25s ease;
}

.social-links a:hover {
  border-color: var(--color-accent);
  color: var(--color-accent);
  transform: translateY(-2px);
}

.social-icon {
  font-size: 1rem;
}

/* =========================================================
   RESPONSIVE
   ========================================================= */

@media (max-width: 900px) {

  .experience-bg {
    background-attachment: scroll;
    padding: 2rem 0 4rem;
  }

  .experience-shell {
    width: calc(100% - 1.5rem);
    padding: 1.5rem;
  }

  .experience-shell .experience-timeline {
    padding: 2.5rem 1.5rem 3rem;
  }

  .experience-card {
    padding: 1.8rem;
  }

}

@media (max-width: 700px) {

  .experience-bg {
    padding: 1rem 0 3rem;
  }

  .experience-shell {
    width: calc(100% - 1rem);
    padding: 1rem;
    border-radius: 12px;
  }

  .experience-shell .experience-header {
    width: 100%;
    margin-bottom: 1rem;
    padding: 2.5rem 1.25rem;
  }

  .experience-header h1 {
    font-size: clamp(2rem, 11vw, 3.2rem);
  }

  .experience-shell .experience-timeline {
    width: 100%;
    padding: 1.5rem 1rem 2.5rem;
  }

  .experience-card {
    width: 100%;
    padding: 1.4rem;
  }

  .social-links {
    gap: 0.75rem;
  }

}

@media (max-width: 500px) {

  .experience-shell {
    width: calc(100% - 0.75rem);
    padding: 0.75rem;
  }

  .experience-shell .experience-header {
    width: 100%;
    padding: 2.25rem 1rem;
  }

  .experience-shell .experience-timeline {
    width: 100%;
    padding: 1.25rem 0.85rem 2rem;
  }

  .experience-card {
    padding: 1.15rem;
  }

  button[type="submit"] {
    width: 100%;
    text-align: center;
  }

  .social-links {
    flex-direction: column;
    align-items: stretch;
  }

  .social-links a {
    justify-content: center;
  }

}
</style>