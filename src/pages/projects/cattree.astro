---
import "../../styles/global.css";
import Navbar from "../../components/Navbar.astro";
import Footer from "../../components/Footer.astro";

/*
  ============================================================
  GALLERY
  TODO: confirma la cantidad y los nombres reales de los
  archivos en /public/projects/cattree/ — estos son un
  placeholder siguiendo el mismo patrón que carro/ e iot/.
  ============================================================
*/
const gallery = [
  { type: "image", src: "/projects/cattree/cattree1.jpeg", alt: "Cat Tree Gym 1" },
  { type: "image", src: "/projects/cattree/cattree2.jpeg", alt: "Cat Tree Gym 2" },
  { type: "image", src: "/projects/cattree/cattree3.jpeg", alt: "Cat Tree Gym 3" },
  { type: "image", src: "/projects/cattree/cattree4.jpeg", alt: "Cat Tree Gym 4" },
  { type: "image", src: "/projects/cattree/cattree5.jpeg", alt: "Cat Tree Gym 5" },
  { type: "image", src: "/projects/cattree/cattree6.jpeg", alt: "Cat Tree Gym 6" },
  { type: "image", src: "/projects/cattree/cattree7.jpeg", alt: "Cat Tree Gym 7" },
  { type: "image", src: "/projects/cattree/cattree8.jpeg", alt: "Cat Tree Gym 8" },
  { type: "image", src: "/projects/cattree/cattree9.jpeg", alt: "Cat Tree Gym 9" },
  { type: "image", src: "/projects/cattree/cattree10.jpeg", alt: "Cat Tree Gym 10" },
  { type: "image", src: "/projects/cattree/cattree11.jpeg", alt: "Cat Tree Gym 11" },
  { type: "image", src: "/projects/cattree/cattree12.jpeg", alt: "Cat Tree Gym 12" },
  { type: "image", src: "/projects/cattree/cattree13.jpeg", alt: "Cat Tree Gym 13" },
  { type: "image", src: "/projects/cattree/cattree14.jpeg", alt: "Cat Tree Gym 14" },
  { type: "image", src: "/projects/cattree/cattree15.jpeg", alt: "Cat Tree Gym 15" },
];
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />

    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0"
    />

    <meta
      name="description"
      content="Cat Tree Gym — concept development, mechanical design and manufacturing project by Mariana Calle Méndez."
    />

    <title>Cat Tree Gym — Mariana Calle</title>
  </head>

  <body>

    <Navbar />

    <main class="experience-bg">

      <div class="experience-shell">

        <!-- =====================================================
             HEADER
        ====================================================== -->

        <section class="experience-header">

          <h1>
            CAT TREE GYM
          </h1>

          <p class="experience-intro">
            A custom three-level cat tree, designed and built from
            scratch to turn a personal concern into a small gym for
            a very specific user — my cat.
          </p>

        </section>


        <!-- HERO IMAGE -->

        <section class="experience-timeline hero-section">

          <div class="hero-image-wrap">

            <img
              src="/projects/cattree.jpeg"
              alt="Cat Tree Gym"
            />

          </div>

        </section>


        <!-- =====================================================
             MAIN CONTENT CARD
        ====================================================== -->

        <section class="experience-timeline">

          <div class="experience-card project-card">

            <!-- =================================================
                 01 · INTRODUCTION
            ================================================== -->

            <div class="experience-section">

              <p class="section-kicker">
                01 · INTRODUCTION
              </p>

              <h2>
                Project Info
              </h2>

              <div class="hardware-grid">

                <div class="hardware-item">
                  <span class="hardware-label">Project date</span>
                  <span class="hardware-value">TBD</span>
                </div>

                <div class="hardware-item">
                  <span class="hardware-label">Project type</span>
                  <span class="hardware-value">Personal project</span>
                </div>

                <div class="hardware-item">
                  <span class="hardware-label">My role</span>
                  <span class="hardware-value">Concept Development, Mechanical Design &amp; Manufacturing</span>
                </div>

              </div>

            </div>


            <!-- =================================================
                 02 · THE CHALLENGE
            ================================================== -->

            <div class="experience-section">

              <p class="section-kicker">
                02 · THE CHALLENGE
              </p>

              <h2>
                The Idea
              </h2>

              <p>
                This project started with a personal motivation: I
                noticed that one of my cats was gaining weight, and I
                wanted to find a way to encourage him to be more
                physically active.
              </p>

              <p>
                Rather than simply buying a conventional cat tree, I
                decided to design a structure that could work as a
                <strong>small gym</strong> for him. The idea was to
                create a multi-level environment where he could
                climb, jump, scratch and rest, combining exercise
                with play and exploration.
              </p>

              <p>
                I wanted the structure to offer different challenges
                while remaining comfortable and safe for everyday
                use. This led to the concept of a
                <strong>three-level cat tree</strong> with additional
                climbing elements, designed to encourage movement and
                make better use of vertical space.
              </p>

            </div>


            <!-- =================================================
                 03 · MY CONTRIBUTION
            ================================================== -->

            <div class="experience-section">

              <p class="section-kicker">
                03 · MY CONTRIBUTION
              </p>

              <h2>
                Mechanical Design
              </h2>

              <p>
                I was responsible for the concept development and
                complete mechanical design of the cat tree. Using
                <em>Solid Edge</em>, I modeled the structure at full
                scale, defining the dimensions, platform arrangement,
                support positions and connections between the
                different components.
              </p>

              <p>
                I focused on creating a stable structure that could
                withstand the dynamic movements of a cat, considering
                how its weight would be distributed across the
                different levels. I also designed the modular side
                elements to add height and create additional
                opportunities for climbing and jumping.
              </p>

              <p>
                Another important part of my work was preparing the
                design for manufacturing. I developed the components
                for <strong>CNC machining</strong>, paying attention
                to dimensions, joints and assembly details to achieve
                accurate parts and a clean final result. Beyond the
                design stage, I operated the CNC machine myself under
                the supervision of Julián, one of the university's
                laboratory technicians — hands-on experience
                translating my CAD models into physical components.
              </p>

              <div class="tags">
                <span>Solid Edge</span>
                <span>Concept Development</span>
                <span>CNC Machining</span>
              </div>

            </div>


            <!-- =================================================
                 04 · FROM DESIGN TO REALITY
            ================================================== -->

            <div class="experience-section">

              <p class="section-kicker">
                04 · FROM DESIGN TO REALITY
              </p>

              <h2>
                Bringing It to Life
              </h2>

              <p>
                Once the design was completed, I moved on to
                manufacturing and assembly. The platforms and base
                structure were made from <strong>triplex wood</strong>,
                while <strong>PVC tubes</strong> were used as
                structural supports and scratching posts. I wrapped
                the tubes with <strong>natural rope</strong> to create
                surfaces suitable for scratching and climbing.
              </p>

              <p>
                I carried out the CNC machining of the wooden
                components under Julián's supervision. During the
                construction and assembly process, I also received
                support from Sebastián, another university laboratory
                technician. Together, we worked on fitting the
                different components and assembling the structure.
              </p>

              <p>
                To improve the durability of the wood, I applied a
                natural protective coating made from beeswax and
                mineral oil. I also sanded the surfaces and softened
                the edges to make the structure more comfortable and
                suitable for everyday use. The final assembly brought
                together the different platforms, supports and
                climbing elements into a multi-level structure
                designed specifically around my cat's needs.
              </p>

              <div class="tags">
                <span>Triplex Wood</span>
                <span>PVC</span>
                <span>Natural Rope</span>
                <span>Beeswax Finish</span>
              </div>

            </div>


            <!-- GALLERY -->

            <div class="experience-gallery-section">

              <h3>
                Project Gallery
              </h3>

              <div class="gallery-container">

                <div class="gallery-slider">

                  {
                    gallery.map((item, i) => (
                      item.type === "video" ? (
                        <video
                          src={item.src}
                          class:list={{ active: i === 0 }}
                          muted
                          loop
                          playsinline
                          preload="metadata"
                        />
                      ) : (
                        <img
                          src={item.src}
                          alt={item.alt}
                          class:list={{ active: i === 0 }}
                          loading={i === 0 ? "eager" : "lazy"}
                        />
                      )
                    ))
                  }

                </div>


                <button
                  class="gallery-btn prev"
                  type="button"
                  aria-label="Previous item"
                >
                  ❮
                </button>


                <button
                  class="gallery-btn next"
                  type="button"
                  aria-label="Next item"
                >
                  ❯
                </button>


                <div class="gallery-counter">

                  <span id="gallery-current">
                    1
                  </span>

                  /

                  <span>
                    {gallery.length}
                  </span>

                </div>

              </div>

            </div>


            <!-- =================================================
                 05 · RESULTS
            ================================================== -->

            <div class="experience-section learning-section">

              <p class="section-kicker">
                05 · RESULTS
              </p>

              <h2>
                The Outcome
              </h2>

              <p>
                The result was a custom-built cat tree that became
                more than just a resting place. My cat quickly
                adapted to the structure, using it to climb, scratch,
                jump, play and relax throughout the day.
              </p>

              <p>
                The project transformed a personal concern into a
                practical design solution, combining mechanical
                design, manufacturing and material selection with a
                clear everyday purpose.
              </p>

              <p>
                For me, it was a rewarding opportunity to apply
                engineering outside an academic setting and create
                something directly useful. It also reminded me that
                good design starts with understanding the needs of
                the user, even when that user happens to have four
                paws.
              </p>

              <blockquote>
                Good design starts with understanding the needs of
                the user — even when that user happens to have four
                paws.
              </blockquote>

            </div>


            <!-- BACK LINK -->

            <div class="back-link-wrap">
              <a href="/projects" class="back-link-pill">
                <span>←</span>
                Back to Projects
              </a>
            </div>

          </div>

        </section>

      </div>

    </main>


    <!-- =======================================================
         LIGHTBOX
    ======================================================== -->

    <div
      id="lightbox"
      class="lightbox"
      aria-hidden="true"
    >

      <button
        class="close"
        type="button"
        aria-label="Close viewer"
      >
        &times;
      </button>


      <button
        class="lightbox-nav prev"
        type="button"
        aria-label="Previous item"
      >
        ❮
      </button>


      <img
        id="lightbox-img"
        class="lightbox-content"
        src=""
        alt=""
      />

      <video
        id="lightbox-video"
        class="lightbox-content"
        controls
        playsinline
      />


      <button
        class="lightbox-nav next"
        type="button"
        aria-label="Next item"
      >
        ❯
      </button>


      <div class="lightbox-counter">

        <span id="lightbox-current">
          1
        </span>

        /

        <span>
          {gallery.length}
        </span>

      </div>

    </div>


    <Footer />


    <!-- =======================================================
         GALLERY SCRIPT
    ======================================================== -->

    <script>
      const items =
        Array.from(
          document.querySelectorAll<HTMLImageElement | HTMLVideoElement>(
            ".gallery-slider img, .gallery-slider video"
          )
        );

      const nextBtn =
        document.querySelector<HTMLButtonElement>(
          ".gallery-btn.next"
        );

      const prevBtn =
        document.querySelector<HTMLButtonElement>(
          ".gallery-btn.prev"
        );

      const lightbox =
        document.getElementById("lightbox");

      const lightboxImg =
        document.getElementById(
          "lightbox-img"
        ) as HTMLImageElement | null;

      const lightboxVideo =
        document.getElementById(
          "lightbox-video"
        ) as HTMLVideoElement | null;

      const closeBtn =
        document.querySelector<HTMLButtonElement>(
          ".lightbox .close"
        );

      const nextLightbox =
        document.querySelector<HTMLButtonElement>(
          ".lightbox-nav.next"
        );

      const prevLightbox =
        document.querySelector<HTMLButtonElement>(
          ".lightbox-nav.prev"
        );

      const galleryCurrent =
        document.getElementById(
          "gallery-current"
        );

      const lightboxCurrent =
        document.getElementById(
          "lightbox-current"
        );

      let index = 0;

      /* =====================================================
         SHOW ITEM
      ====================================================== */

      function showItem(newIndex: number) {
        if (!items.length) {
          return;
        }

        index =
          (newIndex + items.length) %
          items.length;

        items.forEach(
          (item, i) => {
            const isActive = i === index;

            item.classList.toggle(
              "active",
              isActive
            );

            if (item.tagName === "VIDEO") {
              const video = item as HTMLVideoElement;

              if (isActive) {
                video.play().catch(() => {});
              } else {
                video.pause();
                video.currentTime = 0;
              }
            }
          }
        );

        if (galleryCurrent) {
          galleryCurrent.textContent =
            String(index + 1);
        }
      }

      /* =====================================================
         NEXT / PREVIOUS
      ====================================================== */

      function nextItem() {
        showItem(index + 1);
      }

      function previousItem() {
        showItem(index - 1);
      }

      nextBtn?.addEventListener(
        "click",
        nextItem
      );

      prevBtn?.addEventListener(
        "click",
        previousItem
      );

      /* =====================================================
         LIGHTBOX
      ====================================================== */

      function renderLightbox() {
        if (
          !lightboxImg ||
          !lightboxVideo ||
          !items[index]
        ) {
          return;
        }

        const current = items[index];

        if (current.tagName === "VIDEO") {
          lightboxVideo.src = current.getAttribute("src") ?? "";
          lightboxVideo.style.display = "block";
          lightboxVideo.play().catch(() => {});

          lightboxImg.style.display = "none";
        } else {
          lightboxImg.src = (current as HTMLImageElement).src;
          lightboxImg.alt = (current as HTMLImageElement).alt;
          lightboxImg.style.display = "block";

          lightboxVideo.pause();
          lightboxVideo.style.display = "none";
        }

        if (lightboxCurrent) {
          lightboxCurrent.textContent =
            String(index + 1);
        }
      }

      function openLightbox(itemIndex: number) {
        if (
          !lightbox ||
          !items[itemIndex]
        ) {
          return;
        }

        index = itemIndex;

        renderLightbox();

        lightbox.classList.add("open");

        lightbox.setAttribute(
          "aria-hidden",
          "false"
        );

        document.body.style.overflow =
          "hidden";
      }

      function closeLightbox() {
        if (!lightbox) {
          return;
        }

        lightboxVideo?.pause();

        lightbox.classList.remove("open");

        lightbox.setAttribute(
          "aria-hidden",
          "true"
        );

        document.body.style.overflow =
          "";
      }

      function updateLightbox(direction: number) {
        lightboxVideo?.pause();

        showItem(
          index + direction
        );

        renderLightbox();
      }

      items.forEach(
        (item, i) => {
          item.addEventListener(
            "click",
            () => {
              openLightbox(i);
            }
          );
        }
      );

      nextLightbox?.addEventListener(
        "click",
        () => {
          updateLightbox(1);
        }
      );

      prevLightbox?.addEventListener(
        "click",
        () => {
          updateLightbox(-1);
        }
      );

      closeBtn?.addEventListener(
        "click",
        closeLightbox
      );

      document.addEventListener(
        "keydown",
        (event) => {
          if (
            lightbox?.classList.contains(
              "open"
            )
          ) {
            if (
              event.key ===
              "ArrowRight"
            ) {
              event.preventDefault();
              updateLightbox(1);
            }

            if (
              event.key ===
              "ArrowLeft"
            ) {
              event.preventDefault();
              updateLightbox(-1);
            }

            if (
              event.key ===
              "Escape"
            ) {
              event.preventDefault();
              closeLightbox();
            }

            return;
          }

          if (
            event.key ===
            "ArrowRight"
          ) {
            nextItem();
          }

          if (
            event.key ===
            "ArrowLeft"
          ) {
            previousItem();
          }
        }
      );

      lightbox?.addEventListener(
        "click",
        (event) => {
          if (
            event.target ===
            lightbox
          ) {
            closeLightbox();
          }
        }
      );

      showItem(0);
    </script>

  </body>
</html>


<style>
/* =========================================================
   Mismas clases base que scara.astro / robot.astro / iot.astro.
   ========================================================= */

.experience-bg {
  width: 100%;
  min-height: 100vh;
  margin: 0;
  padding: 3rem 0 5rem;
  background-image: url("/textures/paper-texture.png");
  background-size: cover;
  background-position: center;
  background-attachment: fixed;
  background-color: transparent;
  box-sizing: border-box;
  overflow-x: hidden;
}

.experience-shell {
  width: 100%;
  max-width: 1200px;
  margin: 1rem auto 0;
  padding: 2rem;
  background: rgba(255, 255, 255, 0.78);
  border: 1px solid rgba(0, 0, 0, 0.05);
  border-radius: 16px;
  box-shadow: 0 4px 25px rgba(0, 0, 0, 0.08);
  backdrop-filter: blur(4px);
  box-sizing: border-box;
}

.experience-shell .experience-header {
  width: 100%;
  max-width: 950px;
  margin: 0 auto 2rem;
  padding: 3rem 2.5rem;
  text-align: center;
  background: rgba(255, 255, 255, 0.9);
  border: 1px solid rgba(0, 0, 0, 0.05);
  border-radius: 12px;
  box-shadow: 0 4px 15px rgba(0, 0, 0, 0.05);
  box-sizing: border-box;
  overflow: hidden;
}

.experience-header h1 {
  margin: 0;
  color: var(--color-deep);
  font-size: clamp(2.3rem, 6.5vw, 4.6rem);
  line-height: 1.05;
  letter-spacing: -0.01em;
  overflow-wrap: break-word;
}

.experience-intro {
  width: min(700px, 100%);
  margin: 1.5rem auto 0;
  color: var(--color-text);
  font-size: 1rem;
  line-height: 1.6;
  text-align: center;
}

.experience-shell .experience-timeline {
  width: 100%;
  margin: 0 auto 2rem;
  padding: 3rem 2rem 4rem;
  background: rgba(255, 255, 255, 0.85);
  border: 1px solid rgba(0, 0, 0, 0.05);
  border-radius: 12px;
  box-shadow: 0 4px 20px rgba(0, 0, 0, 0.05);
  box-sizing: border-box;
  overflow: hidden;
}

.experience-shell .experience-timeline:last-child {
  margin-bottom: 0;
}

.experience-card {
  width: 100%;
  min-width: 0;
  max-width: 100%;
  box-sizing: border-box;
  overflow: hidden;
  background: rgba(255, 255, 255, 0.9);
  border: 1px solid rgba(0, 0, 0, 0.1);
  border-radius: 12px;
  padding: 2.5rem;
  box-shadow: 0 4px 20px rgba(0, 0, 0, 0.05);
  backdrop-filter: blur(4px);
}

/* HERO IMAGE */

.hero-section {
  padding: 0 !important;
  background: transparent !important;
  border: none !important;
  box-shadow: none !important;
  overflow: visible !important;
}

.hero-image-wrap {
  position: relative;
  width: 100%;
  aspect-ratio: 16 / 7;
  border-radius: 14px;
  overflow: hidden;
  box-shadow: 0 10px 30px rgba(0, 0, 0, 0.18);
}

.hero-image-wrap img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
  filter: saturate(1.05);
}

/* SECTIONS */

.experience-section {
  width: 100%;
  min-width: 0;
  padding: 2.75rem 0;
  border-bottom: 1px solid rgba(0, 0, 0, 0.08);
}

.experience-section:last-of-type {
  border-bottom: none;
}

.section-kicker {
  margin: 0 0 0.6rem;
  color: var(--color-accent);
  font-size: 0.75rem;
  font-weight: 700;
  letter-spacing: 0.14em;
  text-transform: uppercase;
}

.experience-section h2 {
  margin: 0 0 1.2rem;
  color: var(--color-deep);
  font-size: clamp(1.4rem, 3.2vw, 2.1rem);
  font-weight: 700;
  line-height: 1.2;
  overflow-wrap: anywhere;
}

.experience-section p {
  width: 100%;
  max-width: 100%;
  min-width: 0;
  margin: 0 0 1rem;
  color: var(--color-text);
  font-size: 0.98rem;
  line-height: 1.6;
  text-align: justify;
  overflow-wrap: anywhere;
}

.experience-section p:last-of-type {
  margin-bottom: 0;
}

.learning-section blockquote {
  margin: 1.5rem 0 0;
  padding: 1.2rem 1.5rem;
  border-left: 3px solid var(--color-accent);
  background: rgba(255, 255, 255, 0.5);
  color: var(--color-deep);
  font-size: 1.05rem;
  font-style: italic;
  line-height: 1.6;
}

/* TAGS */

.tags {
  display: flex;
  flex-wrap: wrap;
  gap: 0.55rem;
  width: 100%;
  margin-top: 1.5rem;
}

.tags span {
  max-width: 100%;
  padding: 0.4rem 0.75rem;
  border: 1px solid rgba(0, 0, 0, 0.12);
  border-radius: 999px;
  background: rgba(255, 255, 255, 0.6);
  color: var(--color-deep);
  font-size: 0.75rem;
  font-weight: 600;
  overflow-wrap: anywhere;
}

/* HARDWARE / SYSTEM GRID */

.hardware-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(190px, 1fr));
  gap: 0.85rem;
  margin-top: 1.5rem;
}

.hardware-item {
  display: flex;
  flex-direction: column;
  gap: 0.3rem;
  padding: 1rem 1.1rem;
  border-radius: 10px;
  background: rgba(255, 255, 255, 0.55);
  border: 1px solid rgba(0, 0, 0, 0.08);
}

.hardware-label {
  color: var(--color-accent);
  font-size: 0.68rem;
  font-weight: 700;
  letter-spacing: 0.08em;
  text-transform: uppercase;
}

.hardware-value {
  color: var(--color-deep);
  font-size: 0.88rem;
  font-weight: 600;
  line-height: 1.35;
}

/* BACK LINK */

.back-link-wrap {
  text-align: center;
  margin-top: 2.5rem;
}

.back-link-pill {
  display: inline-flex;
  align-items: center;
  gap: 0.6rem;
  padding: 0.7rem 1.3rem;
  border: 1px solid var(--color-accent);
  border-radius: 999px;
  color: var(--color-accent);
  font-size: 0.8rem;
  font-weight: 700;
  letter-spacing: 0.04em;
  text-decoration: none;
  transition: background 0.25s ease, color 0.25s ease, transform 0.25s ease;
}

.back-link-pill:hover {
  background: var(--color-accent);
  color: var(--color-bg);
  transform: translateX(-3px);
}

/* GALLERY */

.experience-gallery-section {
  width: 100%;
  min-width: 0;
  padding: 2.75rem 0;
  border-bottom: 1px solid rgba(0, 0, 0, 0.08);
}

.experience-gallery-section h3 {
  margin: 0 0 1.2rem;
  color: var(--color-deep);
  font-size: clamp(1.15rem, 2.5vw, 1.45rem);
  font-weight: 700;
  line-height: 1.3;
}

.gallery-container {
  position: relative;
  width: 100%;
  max-width: 900px;
  margin: 1.5rem auto 0;
  overflow: hidden;
  border-radius: 10px;
  background: rgba(0, 0, 0, 0.08);
}

.gallery-slider {
  position: relative;
  width: 100%;
  max-width: 100%;
  min-width: 0;
  aspect-ratio: 16 / 10;
  overflow: hidden;
