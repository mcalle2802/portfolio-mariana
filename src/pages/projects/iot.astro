---
import "../../styles/global.css";
import Navbar from "../../components/Navbar.astro";
import Footer from "../../components/Footer.astro";

const systemOverview = [
  { label: "Microcontroller", value: "ESP32" },
  { label: "Protocol", value: "MQTT" },
  { label: "Backend", value: "Node.js, PHP, MySQL (via MAMP)" },
  { label: "Database Admin", value: "phpMyAdmin" },
  { label: "Visualization", value: "Grafana" },
  { label: "PCB Design", value: "KiCad" },
];

/*
  ============================================================
  GALLERY
  13 fotos, mismo componente de carrusel + lightbox que
  scara.astro / robot.astro.
  ============================================================
*/
const gallery = [
  { type: "image", src: "/projects/iot/iot1.jpeg", alt: "Smart Home IoT System 1" },
  { type: "image", src: "/projects/iot/iot2.jpeg", alt: "Smart Home IoT System 2" },
  { type: "image", src: "/projects/iot/iot3.jpeg", alt: "Smart Home IoT System 3" },
  { type: "image", src: "/projects/iot/iot4.jpeg", alt: "Smart Home IoT System 4" },
  { type: "image", src: "/projects/iot/iot5.jpeg", alt: "Smart Home IoT System 5" },
  { type: "image", src: "/projects/iot/iot6.jpeg", alt: "Smart Home IoT System 6" },
  { type: "image", src: "/projects/iot/iot7.jpeg", alt: "Smart Home IoT System 7" },
  { type: "image", src: "/projects/iot/iot8.jpeg", alt: "Smart Home IoT System 8" },
  { type: "image", src: "/projects/iot/iot9.jpeg", alt: "Smart Home IoT System 9" },
  { type: "image", src: "/projects/iot/iot10.jpeg", alt: "Smart Home IoT System 10" },
  { type: "image", src: "/projects/iot/iot11.jpeg", alt: "Smart Home IoT System 11" },
  { type: "image", src: "/projects/iot/iot12.jpeg", alt: "Smart Home IoT System 12" },
  { type: "image", src: "/projects/iot/iot13.jpeg", alt: "Smart Home IoT System 13" },
];
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />

    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0"
    />

    <meta
      name="description"
      content="Smart Home IoT System — backend, MQTT integration and data visualization project by Mariana Calle Méndez."
    />

    <title>Smart Home IoT System — Mariana Calle</title>
  </head>

  <body>

    <Navbar />

    <main class="experience-bg">

      <div class="experience-shell">

        <!-- =====================================================
             HEADER
        ====================================================== -->

        <section class="experience-header">

          <h1>
            SMART HOME IOT SYSTEM
          </h1>

          <p class="experience-intro">
            A connected home ecosystem bringing lighting, curtains
            and a 3D printer together through MQTT, a Node.js/PHP
            backend, and real-time Grafana dashboards.
          </p>

        </section>


        <!-- HERO IMAGE -->

        <section class="experience-timeline hero-section">

          <div class="hero-image-wrap">

            <img
              src="/projects/iot.jpeg"
              alt="Smart Home IoT System"
            />

          </div>

        </section>


        <!-- =====================================================
             MAIN CONTENT CARD
        ====================================================== -->

        <section class="experience-timeline">

          <div class="experience-card project-card">

            <!-- =================================================
                 01 · INTRODUCTION
            ================================================== -->

            <div class="experience-section">

              <p class="section-kicker">
                01 · INTRODUCTION
              </p>

              <h2>
                Project Info
              </h2>

              <div class="hardware-grid">

                <div class="hardware-item">
                  <span class="hardware-label">Project date</span>
                  <span class="hardware-value">2025</span>
                </div>

                <div class="hardware-item">
                  <span class="hardware-label">Project type</span>
                  <span class="hardware-value">Team project</span>
                </div>

                <div class="hardware-item">
                  <span class="hardware-label">My role</span>
                  <span class="hardware-value">Backend Development, MQTT Integration &amp; Data Visualization</span>
                </div>

              </div>

            </div>


            <!-- =================================================
                 02 · THE CHALLENGE
            ================================================== -->

            <div class="experience-section">

              <p class="section-kicker">
                02 · THE CHALLENGE
              </p>

              <h2>
                The Idea
              </h2>

              <p>
                The goal of this project was to develop a
                <strong>connected home ecosystem</strong> that could
                bring different household devices together through a
                centralized IoT platform. The idea was to make
                everyday interactions more convenient by enabling
                users to control devices remotely, automate certain
                tasks and monitor environmental data in real time.
              </p>

              <p>
                The system was designed around an <strong>ESP32</strong>
                microcontroller, using <strong>MQTT</strong> as the
                communication protocol to connect the hardware with
                the software platform. We explored the integration
                of different devices, including LED lighting,
                motorized blackout curtains and a 3D printer, while
                also considering voice assistants as an additional
                way to interact with the system.
              </p>

              <p>
                Beyond controlling individual devices, we wanted to
                create a platform that could collect and display
                information from the home, connecting hardware,
                backend services and data visualization into one
                integrated ecosystem.
              </p>

            </div>


            <!-- =================================================
                 03 · MY CONTRIBUTION
            ================================================== -->

            <div class="experience-section">

              <p class="section-kicker">
                03 · MY CONTRIBUTION
              </p>

              <h2>
                Backend &amp; Data Visualization
              </h2>

              <p>
                My main responsibility was the development and
                testing of the software components that connected
                the different parts of the smart home system. I
                worked primarily on the backend, implementing
                communication between <strong>Node.js</strong>,
                <strong>PHP</strong> and <strong>MySQL</strong>, and
                managing the database through <em>phpMyAdmin</em>.
              </p>

              <p>
                I also configured <strong>MQTT</strong> communication
                from the backend, enabling data exchange between the
                software platform and the connected devices. To test
                these integrations, I worked with a local <em>MAMP</em>
                server, checking the communication and ensuring that
                the different services could work together.
              </p>

              <p>
                On the visualization side, I configured and designed
                <strong>Grafana</strong> dashboards to display the
                collected information in real time. This provided a
                clear way to monitor the system's data and made the
                information generated by the connected devices
                easier to understand.
              </p>

              <p>
                I also collaborated with the team during the initial
                PCB design process in <strong>KiCad</strong>. Although
                my main focus was software development, this gave me
                the opportunity to participate in the broader system
                design and understand how the hardware and software
                components needed to work together.
              </p>

              <div class="tags">
                <span>Node.js</span>
                <span>PHP</span>
                <span>MySQL</span>
                <span>MQTT</span>
                <span>Grafana</span>
                <span>KiCad</span>
              </div>

            </div>


            <!-- =================================================
                 04 · FROM DESIGN TO REALITY
            ================================================== -->

            <div class="experience-section">

              <p class="section-kicker">
                04 · FROM DESIGN TO REALITY
              </p>

              <h2>
                Bringing It to Life
              </h2>

              <p>
                The development process began with the collaborative
                design of the electronic board in <strong>KiCad</strong>,
                which established the hardware foundation for the
                project. While the team worked on the electronic
                design, I focused on developing the software
                infrastructure responsible for handling and
                displaying the system's data.
              </p>

              <p>
                I implemented the communication between Node.js, PHP
                and MySQL, using a local MAMP server to develop and
                test the backend services. I also configured MQTT
                communication from the backend, establishing the
                messaging structure needed for exchanging information
                within the IoT platform.
              </p>

              <p>
                Once the backend components were in place, I focused
                on data visualization. I configured Grafana and
                designed dashboards to display incoming information
                in real time, making it easier to monitor the data
                collected by the system. Throughout the process, I
                carried out tests to verify communication between the
                different services and ensure that the data could be
                properly stored, retrieved and visualized.
              </p>

              <div class="hardware-grid">
                {
                  systemOverview.map((item) => (
                    <div class="hardware-item">
                      <span class="hardware-label">{item.label}</span>
                      <span class="hardware-value">{item.value}</span>
                    </div>
                  ))
                }
              </div>

            </div>


            <!-- GALLERY -->

            <div class="experience-gallery-section">

              <h3>
                Project Gallery
              </h3>

              <div class="gallery-container">

                <div class="gallery-slider">

                  {
                    gallery.map((item, i) => (
                      item.type === "video" ? (
                        <video
                          src={item.src}
                          class:list={{ active: i === 0 }}
                          muted
                          loop
                          playsinline
                          preload="metadata"
                        />
                      ) : (
                        <img
                          src={item.src}
                          alt={item.alt}
                          class:list={{ active: i === 0 }}
                          loading={i === 0 ? "eager" : "lazy"}
                        />
                      )
                    ))
                  }

                </div>


                <button
                  class="gallery-btn prev"
                  type="button"
                  aria-label="Previous item"
                >
                  ❮
                </button>


                <button
                  class="gallery-btn next"
                  type="button"
                  aria-label="Next item"
                >
                  ❯
                </button>


                <div class="gallery-counter">

                  <span id="gallery-current">
                    1
                  </span>

                  /

                  <span>
                    {gallery.length}
                  </span>

                </div>

              </div>

            </div>


            <!-- =================================================
                 05 · RESULTS
            ================================================== -->

            <div class="experience-section learning-section">

              <p class="section-kicker">
                05 · RESULTS
              </p>

              <h2>
                The Outcome
              </h2>

              <p>
                The project resulted in a working software
                infrastructure for a smart home IoT platform. The
                backend connected Node.js, PHP and MySQL, while MQTT
                provided the communication layer for exchanging
                information. Grafana dashboards made it possible to
                visualize system data in real time.
              </p>

              <p>
                Through the development and testing process, we
                established the foundations for connecting hardware
                devices with backend services and monitoring their
                information through a centralized platform.
              </p>

              <p>
                For me, this project was an opportunity to explore a
                different side of mechatronics engineering, working
                with server infrastructure, communication protocols,
                databases and data visualization to understand how
                software can connect and support physical systems.
              </p>

              <blockquote>
                A chance to explore a different side of mechatronics
                engineering — where software becomes the layer that
                connects and supports physical systems.
              </blockquote>

            </div>


            <!-- BACK LINK -->

            <div class="back-link-wrap">
              <a href="/projects" class="back-link-pill">
                <span>←</span>
                Back to Projects
              </a>
            </div>

          </div>

        </section>

      </div>

    </main>


    <!-- =======================================================
         LIGHTBOX
    ======================================================== -->

    <div
      id="lightbox"
      class="lightbox"
      aria-hidden="true"
    >

      <button
        class="close"
        type="button"
        aria-label="Close viewer"
      >
        &times;
      </button>


      <button
        class="lightbox-nav prev"
        type="button"
        aria-label="Previous item"
      >
        ❮
      </button>


      <img
        id="lightbox-img"
        class="lightbox-content"
        src=""
        alt=""
      />

      <video
        id="lightbox-video"
        class="lightbox-content"
        controls
        playsinline
      />


      <button
        class="lightbox-nav next"
        type="button"
        aria-label="Next item"
      >
        ❯
      </button>


      <div class="lightbox-counter">

        <span id="lightbox-current">
          1
        </span>

        /

        <span>
          {gallery.length}
        </span>

      </div>

    </div>


    <Footer />


    <!-- =======================================================
         GALLERY SCRIPT
    ======================================================== -->

    <script>
      const items =
        Array.from(
          document.querySelectorAll<HTMLImageElement | HTMLVideoElement>(
            ".gallery-slider img, .gallery-slider video"
          )
        );

      const nextBtn =
        document.querySelector<HTMLButtonElement>(
          ".gallery-btn.next"
        );

      const prevBtn =
        document.querySelector<HTMLButtonElement>(
          ".gallery-btn.prev"
        );

      const lightbox =
        document.getElementById("lightbox");

      const lightboxImg =
        document.getElementById(
          "lightbox-img"
        ) as HTMLImageElement | null;

      const lightboxVideo =
        document.getElementById(
          "lightbox-video"
        ) as HTMLVideoElement | null;

      const closeBtn =
        document.querySelector<HTMLButtonElement>(
          ".lightbox .close"
        );

      const nextLightbox =
        document.querySelector<HTMLButtonElement>(
          ".lightbox-nav.next"
        );

      const prevLightbox =
        document.querySelector<HTMLButtonElement>(
          ".lightbox-nav.prev"
        );

      const galleryCurrent =
        document.getElementById(
          "gallery-current"
        );

      const lightboxCurrent =
        document.getElementById(
          "lightbox-current"
        );

      let index = 0;

      /* =====================================================
         SHOW ITEM
      ====================================================== */

      function showItem(newIndex: number) {
        if (!items.length) {
          return;
        }

        index =
          (newIndex + items.length) %
          items.length;

        items.forEach(
          (item, i) => {
            const isActive = i === index;

            item.classList.toggle(
              "active",
              isActive
            );

            if (item.tagName === "VIDEO") {
              const video = item as HTMLVideoElement;

              if (isActive) {
                video.play().catch(() => {});
              } else {
                video.pause();
                video.currentTime = 0;
              }
            }
          }
        );

        if (galleryCurrent) {
          galleryCurrent.textContent =
            String(index + 1);
        }
      }

      /* =====================================================
         NEXT / PREVIOUS
      ====================================================== */

      function nextItem() {
        showItem(index + 1);
      }

      function previousItem() {
        showItem(index - 1);
      }

      nextBtn?.addEventListener(
        "click",
        nextItem
      );

      prevBtn?.addEventListener(
        "click",
        previousItem
      );

      /* =====================================================
         LIGHTBOX
      ====================================================== */

      function renderLightbox() {
        if (
          !lightboxImg ||
          !lightboxVideo ||
          !items[index]
        ) {
          return;
        }

        const current = items[index];

        if (current.tagName === "VIDEO") {
          lightboxVideo.src = current.getAttribute("src") ?? "";
          lightboxVideo.style.display = "block";
          lightboxVideo.play().catch(() => {});

          lightboxImg.style.display = "none";
        } else {
          lightboxImg.src = (current as HTMLImageElement).src;
          lightboxImg.alt = (current as HTMLImageElement).alt;
          lightboxImg.style.display = "block";

          lightboxVideo.pause();
          lightboxVideo.style.display = "none";
        }

        if (lightboxCurrent) {
          lightboxCurrent.textContent =
            String(index + 1);
        }
      }

      function openLightbox(itemIndex: number) {
        if (
          !lightbox ||
          !items[itemIndex]
        ) {
          return;
        }

        index = itemIndex;

        renderLightbox();

        lightbox.classList.add("open");

        lightbox.setAttribute(
          "aria-hidden",
          "false"
        );

        document.body.style.overflow =
          "hidden";
      }

      function closeLightbox() {
        if (!lightbox) {
          return;
        }

        lightboxVideo?.pause();

        lightbox.classList.remove("open");

        lightbox.setAttribute(
          "aria-hidden",
          "true"
        );

        document.body.style.overflow =
          "";
      }

      function updateLightbox(direction: number) {
        lightboxVideo?.pause();

        showItem(
          index + direction
        );

        renderLightbox();
      }

      items.forEach(
        (item, i) => {
          item.addEventListener(
            "click",
            () => {
              openLightbox(i);
            }
          );
        }
      );

      nextLightbox?.addEventListener(
        "click",
        () => {
          updateLightbox(1);
        }
      );

      prevLightbox?.addEventListener(
        "click",
        () => {
          updateLightbox(-1);
        }
      );

      closeBtn?.addEventListener(
        "click",
        closeLightbox
      );

      document.addEventListener(
        "keydown",
        (event) => {
          if (
            lightbox?.classList.contains(
              "open"
            )
          ) {
            if (
              event.key ===
              "ArrowRight"
            ) {
              event.preventDefault();
              updateLightbox(1);
            }

            if (
              event.key ===
              "ArrowLeft"
            ) {
              event.preventDefault();
              updateLightbox(-1);
            }

            if (
              event.key ===
              "Escape"
            ) {
              event.preventDefault();
              closeLightbox();
            }

            return;
          }

          if (
            event.key ===
            "ArrowRight"
          ) {
            nextItem();
          }

          if (
            event.key ===
            "ArrowLeft"
          ) {
            previousItem();
          }
        }
      );

      lightbox?.addEventListener(
        "click",
        (event) => {
          if (
            event.target ===
            lightbox
          ) {
            closeLightbox();
          }
        }
      );

      showItem(0);
    </script>

  </body>
</html>


<style>
/* =========================================================
   Mismas clases base que scara.astro / robot.astro.
   ========================================================= */

.experience-bg {
  width: 100%;
  min-height: 100vh;
  margin: 0;
  padding: 3rem 0 5rem;
  background-image: url("/textures/paper-texture.png");
  background-size: cover;
  background-position: center;
  background-attachment: fixed;
  background-color: transparent;
  box-sizing: border-box;
  overflow-x: hidden;
}

.experience-shell {
  width: 100%;
  max-width: 1200px;
  margin: 1rem auto 0;
  padding: 2rem;
  background: rgba(255, 255, 255, 0.78);
  border: 1px solid rgba(0, 0, 0, 0.05);
  border-radius: 16px;
  box-shadow: 0 4px 25px rgba(0, 0, 0, 0.08);
  backdrop-filter: blur(4px);
  box-sizing: border-box;
}

.experience-shell .experience-header {
  width: 100%;
  max-width: 950px;
  margin: 0 auto 2rem;
  padding: 3rem 2.5rem;
  text-align: center;
  background: rgba(255, 255, 255, 0.9);
  border: 1px solid rgba(0, 0, 0, 0.05);
  border-radius: 12px;
  box-shadow: 0 4px 15px rgba(0, 0, 0, 0.05);
  box-sizing: border-box;
  overflow: hidden;
}

.experience-header h1 {
  margin: 0;
  color: var(--color-deep);
  font-size: clamp(2.3rem, 6.5vw, 4.6rem);
  line-height: 1.05;
  letter-spacing: -0.01em;
  overflow-wrap: break-word;
}

.experience-intro {
  width: min(700px, 100%);
  margin: 1.5rem auto 0;
  color: var(--color-text);
  font-size: 1rem;
  line-height: 1.6;
  text-align: center;
}

.experience-shell .experience-timeline {
  width: 100%;
  margin: 0 auto 2rem;
  padding: 3rem 2rem 4rem;
  background: rgba(255, 255, 255, 0.85);
  border: 1px solid rgba(0, 0, 0, 0.05);
  border-radius: 12px;
  box-shadow: 0 4px 20px rgba(0, 0, 0, 0.05);
  box-sizing: border-box;
  overflow: hidden;
}

.experience-shell .experience-timeline:last-child {
  margin-bottom: 0;
}

.experience-card {
  width: 100%;
  min-width: 0;
  max-width: 100%;
  box-sizing: border-box;
  overflow: hidden;
  background: rgba(255, 255, 255, 0.9);
  border: 1px solid rgba(0, 0, 0, 0.1);
  border-radius: 12px;
  padding: 2.5rem;
  box-shadow: 0 4px 20px rgba(0, 0, 0, 0.05);
  backdrop-filter: blur(4px);
}

/* HERO IMAGE */

.hero-section {
  padding: 0 !important;
  background: transparent !important;
  border: none !important;
  box-shadow: none !important;
  overflow: visible !important;
}

.hero-image-wrap {
  position: relative;
  width: 100%;
  aspect-ratio: 16 / 7;
  border-radius: 14px;
  overflow: hidden;
  box-shadow: 0 10px 30px rgba(0, 0, 0, 0.18);
}

.hero-image-wrap img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
  filter: saturate(1.05);
}

/* SECTIONS */

.experience-section {
  width: 100%;
  min-width: 0;
  padding: 2.75rem 0;
  border-bottom: 1px solid rgba(0, 0, 0, 0.08);
}

