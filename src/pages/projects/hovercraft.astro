---
import "../../styles/global.css";
import Navbar from "../../components/Navbar.astro";
import Footer from "../../components/Footer.astro";

const systemOverview = [
  { label: "Vision & Processing", value: "Raspberry Pi 2" },
  { label: "Flight Control", value: "Arduino + ESCs" },
  { label: "Lift Fan", value: "3D-printed ABS fan, 2212 drone motor" },
  { label: "Airflow", value: "Conical duct + skirt air outlets" },
  { label: "Propulsion", value: "Re-machined propeller (lathe)" },
];

/*
  ============================================================
  GALLERY
  Mismo componente de carrusel + lightbox que scara.astro.
  ============================================================
*/
const gallery = [
  { type: "image", src: "/projects/hovercraft/hovercraft1.jpeg", alt: "Racing Hovercraft 1" },
  { type: "image", src: "/projects/hovercraft/hovercraft2.jpeg", alt: "Racing Hovercraft 2" },
  { type: "image", src: "/projects/hovercraft/hovercraft3.jpeg", alt: "Racing Hovercraft 3" },
  { type: "image", src: "/projects/hovercraft/hovercraft4.jpeg", alt: "Racing Hovercraft 4" },
  { type: "image", src: "/projects/hovercraft/hovercraft5.jpeg", alt: "Racing Hovercraft 5" },
  { type: "image", src: "/projects/hovercraft/hovercraft6.jpeg", alt: "Racing Hovercraft 6" },
];
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />

    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0"
    />

    <meta
      name="description"
      content="Racing Hovercraft — mechanical design, propulsion and computer vision project by Mariana Calle Méndez."
    />

    <title>Racing Hovercraft — Mariana Calle</title>
  </head>

  <body>

    <Navbar />

    <main class="experience-bg">

      <div class="experience-shell">

        <!-- =====================================================
             HEADER
        ====================================================== -->

        <section class="experience-header">

          <h1>
            RACING HOVERCRAFT
          </h1>

          <p class="experience-intro">
            A high-speed racing hovercraft, combining air-cushion
            propulsion, embedded electronics and computer vision to
            navigate a track and avoid obstacles.
          </p>

        </section>


        <!-- HERO IMAGE -->

        <section class="experience-timeline hero-section">

          <div class="hero-image-wrap">

            <img
              src="/projects/hovercraft.jpeg"
              alt="Racing Hovercraft"
            />

          </div>

        </section>


        <!-- =====================================================
             MAIN CONTENT CARD
        ====================================================== -->

        <section class="experience-timeline">

          <div class="experience-card project-card">

            <!-- =================================================
                 01 · INTRODUCTION
            ================================================== -->

            <div class="experience-section">

              <p class="section-kicker">
                01 · INTRODUCTION
              </p>

              <h2>
                Project Info
              </h2>

              <div class="hardware-grid">

                <div class="hardware-item">
                  <span class="hardware-label">Project date</span>
                  <span class="hardware-value">2022</span>
                </div>

                <div class="hardware-item">
                  <span class="hardware-label">Project type</span>
                  <span class="hardware-value">Team Project</span>
                </div>

                <div class="hardware-item">
                  <span class="hardware-label">My role</span>
                  <span class="hardware-value">Mechanical Design, Manufacturing, Electronics Integration &amp; Testing</span>
                </div>

              </div>

            </div>


            <!-- =================================================
                 02 · THE CHALLENGE
            ================================================== -->

            <div class="experience-section">

              <p class="section-kicker">
                02 · THE CHALLENGE
              </p>

              <h2>
                The Idea
              </h2>

              <p>
                The goal of this project was to design and build a
                <strong>racing hovercraft</strong> capable of moving
                at high speed while maintaining stability and
                maneuverability. Beyond simply achieving lift and
                forward motion, we wanted the vehicle to navigate a
                race track and avoid obstacles using <strong>computer
                vision</strong>.
              </p>

              <p>
                This required bringing together several engineering
                disciplines. The hovercraft needed an efficient
                air-cushion system to lift its structure, a
                propulsion system capable of generating enough
                thrust, and an electronic control architecture that
                could coordinate its movements.
              </p>

              <p>
                The challenge was to make all these systems work
                together in a compact vehicle, balancing speed,
                stability and control.
              </p>

            </div>


            <!-- =================================================
                 03 · MY CONTRIBUTION
            ================================================== -->

            <div class="experience-section">

              <p class="section-kicker">
                03 · MY CONTRIBUTION
              </p>

              <h2>
                Mechanical &amp; Electronics Integration
              </h2>

              <p>
                As part of a three-person team, I worked alongside
                another teammate on the mechanical, electronic and
                control aspects of the hovercraft, while our third
                teammate focused primarily on computer vision.
              </p>

              <p>
                My contribution covered several stages of the
                project, including mechanical design, component
                modifications, manufacturing and electronic
                integration. I participated in developing the
                hovercraft's structure and airflow system, as well as
                adapting components to improve its lift, stability
                and propulsion.
              </p>

              <p>
                I was also involved in assembling and wiring the
                electronic components, particularly the <strong>Arduino</strong>,
                <strong>Raspberry Pi</strong> and <strong>electronic
                speed controllers (ESCs)</strong>. I supported their
                integration and testing, helping ensure that the
                different components worked together to control the
                lift and propulsion motors. This project gave me the
                opportunity to work across several engineering
                disciplines and understand how mechanical design,
                electronics and control come together in a
                functional vehicle.
              </p>

              <div class="tags">
                <span>Mechanical Design</span>
                <span>Arduino</span>
                <span>Raspberry Pi</span>
                <span>ESCs</span>
              </div>

            </div>


            <!-- =================================================
                 04 · FROM DESIGN TO REALITY
            ================================================== -->

            <div class="experience-section">

              <p class="section-kicker">
                04 · FROM DESIGN TO REALITY
              </p>

              <h2>
                Bringing It to Life
              </h2>

              <p>
                We began by developing the hovercraft's mechanical
                structure and propulsion layout. During construction,
                we experimented with different configurations to
                improve the way air was distributed beneath the
                vehicle.
              </p>

              <p>
                One of the key modifications was the addition of a
                <strong>conical duct</strong> to distribute the
                airflow more evenly across the skirt. We also
                designed small air outlets to control how quickly air
                escaped from the cushion, helping improve stability
                during movement and turns.
              </p>

              <p>
                We worked on adapting the propulsion components as
                well. One of the propellers was lowered and
                re-machined using a lathe, while the lift system
                incorporated a <strong>3D-printed ABS fan</strong>
                driven by a <strong>2212 drone motor</strong>.
              </p>

              <p>
                In parallel, we integrated the electronic components.
                The Raspberry Pi 2 handled image processing, while an
                Arduino received the control signals and communicated
                with the ESCs to regulate motor speed. Bringing these
                elements together required testing and adjusting the
                different subsystems until the hovercraft could
                operate as a complete vehicle.
              </p>

              <div class="tags">
                <span>Lathe Machining</span>
                <span>3D Printing</span>
                <span>Airflow Design</span>
              </div>

              <div class="hardware-grid">
                {
                  systemOverview.map((item) => (
                    <div class="hardware-item">
                      <span class="hardware-label">{item.label}</span>
                      <span class="hardware-value">{item.value}</span>
                    </div>
                  ))
                }
              </div>

            </div>


            <!-- GALLERY -->

            <div class="experience-gallery-section">

              <h3>
                Project Gallery
              </h3>

              <div class="gallery-container">

                <div class="gallery-slider">

                  {
                    gallery.map((item, i) => (
                      item.type === "video" ? (
                        <video
                          src={item.src}
                          class:list={{ active: i === 0 }}
                          muted
                          loop
                          playsinline
                          preload="metadata"
                        />
                      ) : (
                        <img
                          src={item.src}
                          alt={item.alt}
                          class:list={{ active: i === 0 }}
                          loading={i === 0 ? "eager" : "lazy"}
                        />
                      )
                    ))
                  }

                </div>


                <button
                  class="gallery-btn prev"
                  type="button"
                  aria-label="Previous item"
                >
                  ❮
                </button>


                <button
                  class="gallery-btn next"
                  type="button"
                  aria-label="Next item"
                >
                  ❯
                </button>


                <div class="gallery-counter">

                  <span id="gallery-current">
                    1
                  </span>

                  /

                  <span>
                    {gallery.length}
                  </span>

                </div>

              </div>

            </div>


            <!-- =================================================
                 05 · RESULTS
            ================================================== -->

            <div class="experience-section learning-section">

              <p class="section-kicker">
                05 · RESULTS
              </p>

              <h2>
                The Outcome
              </h2>

              <p>
                The final prototype successfully generated the air
                cushion required to lift the vehicle and demonstrated
                rapid forward movement and directional control.
              </p>

              <p>
                During testing, the hovercraft was able to respond to
                visual feedback and complete controlled runs.
                However, the Raspberry Pi 2's limited processing
                capabilities introduced delays in obstacle detection
                and decision-making, affecting how quickly the
                vehicle could react. Despite this limitation, the
                project demonstrated the integration of mechanical
                design, propulsion, embedded electronics and computer
                vision in a racing hovercraft.
              </p>

              <p>
                The project was particularly successful, and the
                university acquired the final prototype to keep it as
                a reference for students in future semesters. This
                was a meaningful recognition of our team's work and
                the engineering solutions developed throughout the
                project. For me, it was a valuable opportunity to
                work across several engineering disciplines and
                experience the challenges of bringing a complex
                mechatronic system from concept to a functional
                prototype.
              </p>

              <blockquote>
                The university acquired the final prototype to keep
                it as a reference for future students — a meaningful
                recognition of the engineering solutions behind it.
              </blockquote>

            </div>


            <!-- BACK LINK -->

            <div class="back-link-wrap">
              <a href="/projects" class="back-link-pill">
                <span>←</span>
                Back to Projects
              </a>
            </div>

          </div>

        </section>

      </div>

    </main>


    <!-- =======================================================
         LIGHTBOX
    ======================================================== -->

    <div
      id="lightbox"
      class="lightbox"
      aria-hidden="true"
    >

      <button
        class="close"
        type="button"
        aria-label="Close viewer"
      >
        &times;
      </button>


      <button
        class="lightbox-nav prev"
        type="button"
        aria-label="Previous item"
      >
        ❮
      </button>


      <img
        id="lightbox-img"
        class="lightbox-content"
        src=""
        alt=""
      />

      <video
        id="lightbox-video"
        class="lightbox-content"
        controls
        playsinline
      />


      <button
        class="lightbox-nav next"
        type="button"
        aria-label="Next item"
      >
        ❯
      </button>


      <div class="lightbox-counter">

        <span id="lightbox-current">
          1
        </span>

        /

        <span>
          {gallery.length}
        </span>

      </div>

    </div>


    <Footer />


    <!-- =======================================================
         GALLERY SCRIPT
    ======================================================== -->

    <script>
      const items =
        Array.from(
          document.querySelectorAll<HTMLImageElement | HTMLVideoElement>(
            ".gallery-slider img, .gallery-slider video"
          )
        );

      const nextBtn =
        document.querySelector<HTMLButtonElement>(
          ".gallery-btn.next"
        );

      const prevBtn =
        document.querySelector<HTMLButtonElement>(
          ".gallery-btn.prev"
        );

      const lightbox =
        document.getElementById("lightbox");

      const lightboxImg =
        document.getElementById(
          "lightbox-img"
        ) as HTMLImageElement | null;

      const lightboxVideo =
        document.getElementById(
          "lightbox-video"
        ) as HTMLVideoElement | null;

      const closeBtn =
        document.querySelector<HTMLButtonElement>(
          ".lightbox .close"
        );

      const nextLightbox =
        document.querySelector<HTMLButtonElement>(
          ".lightbox-nav.next"
        );

      const prevLightbox =
        document.querySelector<HTMLButtonElement>(
          ".lightbox-nav.prev"
        );

      const galleryCurrent =
        document.getElementById(
          "gallery-current"
        );

      const lightboxCurrent =
        document.getElementById(
          "lightbox-current"
        );

      let index = 0;

      /* =====================================================
         SHOW ITEM
      ====================================================== */

      function showItem(newIndex: number) {
        if (!items.length) {
          return;
        }

        index =
          (newIndex + items.length) %
          items.length;

        items.forEach(
          (item, i) => {
            const isActive = i === index;

            item.classList.toggle(
              "active",
              isActive
            );

            if (item.tagName === "VIDEO") {
              const video = item as HTMLVideoElement;

              if (isActive) {
                video.play().catch(() => {});
              } else {
                video.pause();
                video.currentTime = 0;
              }
            }
          }
        );

        if (galleryCurrent) {
          galleryCurrent.textContent =
            String(index + 1);
        }
      }

      /* =====================================================
         NEXT / PREVIOUS
      ====================================================== */

      function nextItem() {
        showItem(index + 1);
      }

      function previousItem() {
        showItem(index - 1);
      }

      nextBtn?.addEventListener(
        "click",
        nextItem
      );

      prevBtn?.addEventListener(
        "click",
        previousItem
      );

      /* =====================================================
         LIGHTBOX
      ====================================================== */

      function renderLightbox() {
        if (
          !lightboxImg ||
          !lightboxVideo ||
          !items[index]
        ) {
          return;
        }

        const current = items[index];

        if (current.tagName === "VIDEO") {
          lightboxVideo.src = current.getAttribute("src") ?? "";
          lightboxVideo.style.display = "block";
          lightboxVideo.play().catch(() => {});

          lightboxImg.style.display = "none";
        } else {
          lightboxImg.src = (current as HTMLImageElement).src;
          lightboxImg.alt = (current as HTMLImageElement).alt;
          lightboxImg.style.display = "block";

          lightboxVideo.pause();
          lightboxVideo.style.display = "none";
        }

        if (lightboxCurrent) {
          lightboxCurrent.textContent =
            String(index + 1);
        }
      }

      function openLightbox(itemIndex: number) {
        if (
          !lightbox ||
          !items[itemIndex]
        ) {
          return;
        }

        index = itemIndex;

        renderLightbox();

        lightbox.classList.add("open");

        lightbox.setAttribute(
          "aria-hidden",
          "false"
        );

        document.body.style.overflow =
          "hidden";
      }

      function closeLightbox() {
        if (!lightbox) {
          return;
        }

        lightboxVideo?.pause();

        lightbox.classList.remove("open");

        lightbox.setAttribute(
          "aria-hidden",
          "true"
        );

        document.body.style.overflow =
          "";
      }

      function updateLightbox(direction: number) {
        lightboxVideo?.pause();

        showItem(
          index + direction
        );

        renderLightbox();
      }

      items.forEach(
        (item, i) => {
          item.addEventListener(
            "click",
            () => {
              openLightbox(i);
            }
          );
        }
      );

      nextLightbox?.addEventListener(
        "click",
        () => {
          updateLightbox(1);
        }
      );

      prevLightbox?.addEventListener(
        "click",
        () => {
          updateLightbox(-1);
        }
      );

      closeBtn?.addEventListener(
        "click",
        closeLightbox
      );

      document.addEventListener(
        "keydown",
        (event) => {
          if (
            lightbox?.classList.contains(
              "open"
            )
          ) {
            if (
              event.key ===
              "ArrowRight"
            ) {
              event.preventDefault();
              updateLightbox(1);
            }

            if (
              event.key ===
              "ArrowLeft"
            ) {
              event.preventDefault();
              updateLightbox(-1);
            }

            if (
              event.key ===
              "Escape"
            ) {
              event.preventDefault();
              closeLightbox();
            }

            return;
          }

          if (
            event.key ===
            "ArrowRight"
          ) {
            nextItem();
          }

          if (
            event.key ===
            "ArrowLeft"
          ) {
            previousItem();
          }
        }
      );

      lightbox?.addEventListener(
        "click",
        (event) => {
          if (
            event.target ===
            lightbox
          ) {
            closeLightbox();
          }
        }
      );

      showItem(0);
    </script>

  </body>
</html>


<style>
/* =========================================================
   Mismas clases base que scara.astro / robot.astro / iot.astro
   / cattree.astro / underwater.astro.
   ========================================================= */

.experience-bg {
  width: 100%;
  min-height: 100vh;
  margin: 0;
  padding: 3rem 0 5rem;
  background-image: url("/textures/paper-texture.png");
  background-size: cover;
  background-position: center;
  background-attachment: fixed;
  background-color: transparent;
  box-sizing: border-box;
  overflow-x: hidden;
}

.experience-shell {
  width: 100%;
  max-width: 1200px;
  margin: 1rem auto 0;
  padding: 2rem;
  background: rgba(255, 255, 255, 0.78);
  border: 1px solid rgba(0, 0, 0, 0.05);
  border-radius: 16px;
  box-shadow: 0 4px 25px rgba(0, 0, 0, 0.08);
  backdrop-filter: blur(4px);
  box-sizing: border-box;
}

.experience-shell .experience-header {
  width: 100%;
  max-width: 950px;
  margin: 0 auto 2rem;
  padding: 3rem 2.5rem;
  text-align: center;
  background: rgba(255, 255, 255, 0.9);
  border: 1px solid rgba(0, 0, 0, 0.05);
  border-radius: 12px;
  box-shadow: 0 4px 15px rgba(0, 0, 0, 0.05);
  box-sizing: border-box;
  overflow: hidden;
}

.experience-header h1 {
  margin: 0;
  color: var(--color-deep);
  font-size: clamp(2.3rem, 6.5vw, 4.6rem);
  line-height: 1.05;
  letter-spacing: -0.01em;
  overflow-wrap: break-word;
}

.experience-intro {
  width: min(700px, 100%);
  margin: 1.5rem auto 0;
  color: var(--color-text);
  font-size: 1rem;
  line-height: 1.6;
  text-align: center;
}

.experience-shell .experience-timeline {
  width: 100%;
  margin: 0 auto 2rem;
  padding: 3rem 2rem 4rem;
  background: rgba(255, 255, 255, 0.85);
  border: 1px solid rgba(0, 0, 0, 0.05);
  border-radius: 12px;
  box-shadow: 0 4px 20px rgba(0, 0, 0, 0.05);
  box-sizing: border-box;
  overflow: hidden;
}

.experience-shell .experience-timeline:last-child {
  margin-bottom: 0;
}

.experience-card {
  width: 100%;
  min-width: 0;
  max-width: 100%;
  box-sizing: border-box;
  overflow: hidden;
  background: rgba(255, 255, 255, 0.9);
  border: 1px solid rgba(0, 0, 0, 0.1);
  border-radius: 12px;
  padding: 2.5rem;
  box-shadow: 0 4px 20px rgba(0, 0, 0, 0.05);
  backdrop-filter: blur(4px);
}

/* HERO IMAGE */

.hero-section {
  padding: 0 !important;
  background: transparent !important;
  border: none !important;
  box-shadow: none !important;
  overflow: visible !important;
}

.hero-image-wrap {
  position: relative;
  width: 100%;
  aspect-ratio: 16 / 7;
  border-radius: 14px;
  overflow: hidden;
  box-shadow: 0 10px 30px rgba(0, 0, 0, 0.18);
}

.hero-image-wrap img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
  filter: saturate(1.05);
}

/* SECTIONS */

.experience-section {
  width: 100%;
  min-width: 0;
  padding: 2.75rem 0;
  border-bottom: 1px solid rgba(0, 0, 0, 0.08);
}

.experience-section:last-of-type {
  border-bottom: none;
}

.section-kicker {
  margin: 0 0 0.6rem;
  color: var(--color-accent);
  font-size: 0.75rem;
  font-weight: 700;
  letter-spacing: 0.14em;
  text-transform: uppercase;
}

.experience-section h2 {
  margin: 0 0 1.2rem;
  color: var(--color-deep);
  font-size: clamp(1.4rem, 3.2vw, 2.1rem);
  font-weight: 700;
  line-height: 1.2;
  overflow-wrap: anywhere;
}

.experience-section p {
  width: 100%;
  max-width: 100%;
  min-width: 0;
  margin: 0 0 1rem;
  color: var(--color-text);
  font-size: 0.98rem;
  line-height: 1.6;
  text-align: justify;
  overflow-wrap: anywhere;
}

.experience-section p:last-of-type {
  margin-bottom: 0;
}

.learning-section blockquote {
  margin: 1.5rem 0 0;
  padding: 1.2rem 1.5rem;
  border-left: 3px solid var(--color-accent);
  background: rgba(255, 255, 255, 0.5);
  color: var(--color-deep);
  font-size: 1.05rem;
  font-style: italic;
  line-height: 1.6;
}

/* TAGS */

.tags {
  display: flex;
  flex-wrap: wrap;
  gap: 0.55rem;
  width: 100%;
  margin-top: 1.5rem;
}

.tags span {
  max-width: 100%;
  padding: 0.4rem 0.75rem;
  border: 1px solid rgba(0, 0, 0, 0.12);
  border-radius: 999px;
  background: rgba(255, 255, 255, 0.6);
  color: var(--color-deep);
  font-size: 0.75rem;
  font-weight: 600;
  overflow-wrap: anywhere;
}

/* HARDWARE / SYSTEM GRID */

.hardware-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(190px, 1fr));
  gap: 0.85rem;
  margin-top: 1.5rem;
}

.hardware-item {
  display: flex;
  flex-direction: column;
  gap: 0.3rem;
  padding: 1rem 1.1rem;
  border-radius: 10px;
  background: rgba(255, 255, 255, 0.55);
  border: 1px solid rgba(0, 0, 0, 0.08);
}

.hardware-label {
  color: var(--color-accent);
  font-size: 0.68rem;
  font-weight: 700;
  letter-spacing: 0.08em;
  text-transform: uppercase;
}

.hardware-value {
  color: var(--color-deep);
  font-size: 0.88rem;
  font-weight: 600;
  line-height: 1.35;
}

/* BACK LINK */

.back-link-wrap {
  text-align: center;
  margin-top: 2.5rem;
}

.back-link-pill {
  display: inline-flex;
  align-items: center;
  gap: 0.6rem;
  padding: 0.7rem 1.3rem;
  border: 1px solid var(--color-accent);
  border-radius: 999px;
  color: var(--color-accent);
  font-size: 0.8rem;
  font-weight: 700;
  letter-spacing: 0.04em;
  text-decoration: none;
  transition: background 0.25s ease, color 0.25s ease, transform 0.25s ease;
}

.back-link-pill:hover {
  background: var(--color-accent);
  color: var(--color-bg);
  transform: translateX(-3px);
}

/* RESPONSIVE */

@media (max-width: 900px) {
  .experience-bg {
    background-attachment: scroll;
    padding: 2rem 0 4rem;
  }

  .experience-shell {
    width: calc(100% - 1.5rem);
    padding: 1.5rem;
  }

  .experience-shell .experience-timeline {
    padding: 2.5rem 1.5rem 3rem;
  }

  .experience-card {
    padding: 1.8rem;
  }

  .hero-image-wrap {
    aspect-ratio: 16 / 9;
  }
}

@media (max-width: 700px) {
  .experience-bg {
    padding: 1rem 0 3rem;
  }

  .experience-shell {
    width: calc(100% - 1rem);
    padding: 1rem;
    border-radius: 12px;
  }

  .experience-shell .experience-header {
    width: 100%;
    margin-bottom: 1rem;
