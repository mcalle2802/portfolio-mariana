---
import "../../styles/global.css";
import Navbar from "../../components/Navbar.astro";
import Footer from "../../components/Footer.astro";

const hardware = [
  { label: "Controller", value: "Raspberry Pi Pico" },
  { label: "Driver", value: "L298N Dual H-Bridge" },
  { label: "Motors", value: "DC gearmotors (12 V, 200 RPM) with encoders" },
  { label: "Actuator", value: "Linear stage for Z-axis motion" },
  { label: "Sensors", value: "Limit switches on each joint" },
  { label: "Software", value: "Solid Edge Siemens, MATLAB, Simulink, MicroPython" },
];

/*
  ============================================================
  GALLERY
  14 fotos + 2 videos. Mismo componente de carrusel + lightbox
  que experience.astro, extendido para soportar video.
  ============================================================
*/
const gallery = [
  { type: "image", src: "/projects/scara/scara1.jpeg", alt: "SCARA 1" },
  { type: "image", src: "/projects/scara/scara2.jpeg", alt: "SCARA 2" },
  { type: "image", src: "/projects/scara/scara3.jpeg", alt: "SCARA 3" },
  { type: "image", src: "/projects/scara/scara4.jpeg", alt: "SCARA 4" },
  { type: "image", src: "/projects/scara/scara5.jpeg", alt: "SCARA 5" },
  { type: "image", src: "/projects/scara/scara6.jpeg", alt: "SCARA 6" },
  { type: "image", src: "/projects/scara/scara7.jpeg", alt: "SCARA 7" },
  { type: "image", src: "/projects/scara/scara8.jpeg", alt: "SCARA 8" },
  { type: "image", src: "/projects/scara/scara9.jpeg", alt: "SCARA 9" },
  { type: "image", src: "/projects/scara/scara10.jpeg", alt: "SCARA 10" },
  { type: "image", src: "/projects/scara/scara11.jpeg", alt: "SCARA 11" },
  { type: "image", src: "/projects/scara/scara12.jpeg", alt: "SCARA 12" },
  { type: "image", src: "/projects/scara/scara13.jpeg", alt: "SCARA 13" },
  { type: "image", src: "/projects/scara/scara14.jpeg", alt: "SCARA 14" },
  { type: "video", src: "/projects/scara/video1.mp4", alt: "SCARA video 1" },
  { type: "video", src: "/projects/scara/video2.mp4", alt: "SCARA video 2" },
];
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />

    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0"
    />

    <meta
      name="description"
      content="SCARA welding robot — mechanical design, control and kinematics project by Mariana Calle Méndez."
    />

    <title>SCARA Welding Robot — Mariana Calle</title>
  </head>

  <body>

    <Navbar />

    <main class="experience-bg">

      <div class="experience-shell">

        <!-- =====================================================
             01 · INTRODUCTION
        ====================================================== -->

        <section class="experience-header">

          <h1>
            SCARA ROBOT
          </h1>

          <p class="experience-intro">
            A 3-DOF robotic arm designed and built for a simulated
            MIG welding application.
          </p>

        </section>


        <!-- HERO IMAGE -->

        <section class="experience-timeline hero-section">

          <div class="hero-image-wrap">

            <img
              src="/projects/scara.jpeg"
              alt="SCARA Robot"
            />

          </div>

        </section>


        <!-- =====================================================
             MAIN CONTENT CARD
        ====================================================== -->

        <section class="experience-timeline">

          <div class="experience-card project-card">

            <!-- =================================================
                 01 · INTRODUCTION
            ================================================== -->

            <div class="experience-section">

              <p class="section-kicker">
                01 · INTRODUCTION
              </p>

              <h2>
                Project Info
              </h2>

              <div class="hardware-grid">

                <div class="hardware-item">
                  <span class="hardware-label">Project date</span>
                  <span class="hardware-value">2024</span>
                </div>

                <div class="hardware-item">
                  <span class="hardware-label">Project type</span>
                  <span class="hardware-value">Team project</span>
                </div>

                <div class="hardware-item">
                  <span class="hardware-label">My role</span>
                  <span class="hardware-value">Mechanical Design, Assembly &amp; Integration</span>
                </div>

              </div>

            </div>


            <!-- =================================================
                 02 · THE CHALLENGE
            ================================================== -->

            <div class="experience-section">

              <p class="section-kicker">
                02 · THE CHALLENGE
              </p>

              <h2>
                The Idea
              </h2>

              <p>
                The challenge was to design and build a SCARA
                robotic arm for a simulated <strong>MIG welding
                application</strong>. The robot had to meet specific
                height and reach requirements while incorporating
                <strong>three degrees of freedom</strong> — two
                rotational joints and one translational joint.
              </p>

              <p>
                Before starting the design, I wanted to understand
                what had worked well in previous projects and what
                challenges I should anticipate. I reached out to
                students from earlier semesters for their advice,
                and also consulted Julián, one of the university's
                laboratory technicians, to discuss possible design
                approaches. Together, we prioritized <strong>structural
                rigidity</strong> from the very beginning and
                developed a preliminary sketch that became the
                starting point for the whole design — including his
                suggestion to adapt an electric car door-lock
                mechanism for the welding end effector, an idea we
                eventually built into the prototype.
              </p>

            </div>


            <!-- =================================================
                 03 · MY CONTRIBUTION
            ================================================== -->

            <div class="experience-section">

              <p class="section-kicker">
                03 · MY CONTRIBUTION
              </p>

              <h2>
                Mechanical Design
              </h2>

              <p>
                My main responsibility was the complete mechanical
                design and assembly of the SCARA robot, which I
                developed from the ground up in <em>Solid Edge
                Siemens</em>. I defined its dimensions, geometry and
                workspace, and designed the links, joints, motor
                supports, connections and assembly mechanisms,
                always prioritizing structural stability, rigidity
                and proper integration between parts.
              </p>

              <p>
                An important part of this process was understanding
                how the robot's geometry would affect its movement:
                I worked on the <strong>forward kinematics</strong>
                calculations and used them to guide the mechanical
                design, ensuring the arm could reach the positions
                required for its intended task.
              </p>

              <div class="tags">
                <span>Solid Edge</span>
                <span>Mechanical Design</span>
                <span>Forward Kinematics</span>
              </div>

            </div>


            <!-- =================================================
                 04 · FROM DESIGN TO REALITY
            ================================================== -->

            <div class="experience-section">

              <p class="section-kicker">
                04 · FROM DESIGN TO REALITY
              </p>

              <h2>
                Manufacturing &amp; Assembly
              </h2>

              <p>
                I was directly involved in manufacturing and
                assembling the mechanical structure. I used
                <strong>CNC machining</strong> to manufacture the
                links and motor supports, a <strong>lathe</strong>
                to produce the joint components, and <strong>3D
                printing</strong> to create the limit-switch
                supports that defined the robot's workspace.
              </p>

              <p>
                The electric car door-lock mechanism we had sketched
                out earlier was adapted and incorporated into the
                welding end effector, turning an existing part into
                a practical solution for the project. Having
                carefully planned the structure and prepared each
                component beforehand made the final assembly much
                more straightforward, and the resulting prototype
                worked very well.
              </p>

              <div class="tags">
                <span>CNC Machining</span>
                <span>Lathe</span>
                <span>3D Printing</span>
              </div>

            </div>


            <!-- GALLERY — fotos del proceso -->

            <div class="experience-gallery-section">

              <h3>
                Project Gallery
              </h3>

              <div class="gallery-container">

                <div class="gallery-slider">

                  {
                    gallery.map((item, i) => (
                      item.type === "video" ? (
                        <video
                          src={item.src}
                          class:list={{ active: i === 0 }}
                          muted
                          loop
                          playsinline
                          preload="metadata"
                        />
                      ) : (
                        <img
                          src={item.src}
                          alt={item.alt}
                          class:list={{ active: i === 0 }}
                          loading={i === 0 ? "eager" : "lazy"}
                        />
                      )
                    ))
                  }

                </div>


                <button
                  class="gallery-btn prev"
                  type="button"
                  aria-label="Previous item"
                >
                  ❮
                </button>


                <button
                  class="gallery-btn next"
                  type="button"
                  aria-label="Next item"
                >
                  ❯
                </button>


                <div class="gallery-counter">

                  <span id="gallery-current">
                    1
                  </span>

                  /

                  <span>
                    {gallery.length}
                  </span>

                </div>

              </div>

            </div>


            <!-- =================================================
                 05 · SYSTEM INTEGRATION
            ================================================== -->

            <div class="experience-section">

              <p class="section-kicker">
                05 · SYSTEM INTEGRATION
              </p>

              <h2>
                Control &amp; Virtual Twin
              </h2>

              <p>
                The control of the robot was implemented using a
                <strong>Raspberry Pi Pico</strong> microcontroller.
                Two <strong>DC motors</strong> drove the rotational
                joints, while a <strong>servo motor</strong>
                controlled vertical motion along the Z-axis, and
                <strong>limit switches</strong> defined the
                workspace boundaries to keep the system safe. Each
                joint used a <strong>proportional (P) controller</strong>,
                tuned from the transfer function of its motor, to
                track the programmed welding trajectories smoothly
                and accurately.
              </p>

              <p>
                Alongside the physical prototype, forward and
                inverse kinematics were developed analytically using
                the Denavit–Hartenberg convention and validated in
                MATLAB, and a <strong>digital twin</strong> was built
                in MATLAB/Simulink to mirror the robot's behavior.
                This let us test trajectories and control gains
                virtually before running them on the physical arm,
                keeping the simulated and physical motion closely
                coordinated throughout development.
              </p>

              <div class="code-card">

                <div class="code-card-label">
                  MicroPython
                </div>

                <pre><code># Proportional Control Example
from machine import Pin, PWM
import time

pwm_motor = PWM(Pin(15))
pwm_motor.freq(1000)

kp = 0.4
target_angle = 45
current_angle = 0

while True:
    error = target_angle - current_angle
    control_signal = int(min(max(abs(kp * error), 0), 1023))
    pwm_motor.duty_u16(control_signal)
    # update simulated angle
    current_angle += 0.1 * error
    time.sleep(0.05)
</code></pre>

              </div>

              <div class="hardware-grid">
                {
                  hardware.map((item) => (
                    <div class="hardware-item">
                      <span class="hardware-label">{item.label}</span>
                      <span class="hardware-value">{item.value}</span>
                    </div>
                  ))
                }
              </div>

            </div>


            <!-- =================================================
                 06 · RESULTS
            ================================================== -->

            <div class="experience-section learning-section">

              <p class="section-kicker">
                06 · RESULTS
              </p>

              <h2>
                The Outcome
              </h2>

              <p>
                The robot successfully reached the predefined
                positions and physically followed the programmed
                trajectories required to simulate the MIG welding
                process, adjusting its Z-axis to reproduce different
                seam heights. The proportional controllers kept its
                motion smooth, and the physical performance closely
                matched the behavior predicted by the virtual twin.
              </p>

              <blockquote>
                An idea that started as a preliminary sketch became
                a fully assembled robot capable of performing its
                intended task.
              </blockquote>

            </div>


            <!-- BACK LINK -->

            <div class="back-link-wrap">
              <a href="/projects" class="back-link-pill">
                <span>←</span>
                Back to Projects
              </a>
            </div>

          </div>

        </section>

      </div>

    </main>


    <!-- =======================================================
         LIGHTBOX
    ======================================================== -->

    <div
      id="lightbox"
      class="lightbox"
      aria-hidden="true"
    >

      <button
        class="close"
        type="button"
        aria-label="Close viewer"
      >
        &times;
      </button>


      <button
        class="lightbox-nav prev"
        type="button"
        aria-label="Previous item"
      >
        ❮
      </button>


      <img
        id="lightbox-img"
        class="lightbox-content"
        src=""
        alt=""
      />

      <video
        id="lightbox-video"
        class="lightbox-content"
        controls
        playsinline
      />


      <button
        class="lightbox-nav next"
        type="button"
        aria-label="Next item"
      >
        ❯
      </button>


      <div class="lightbox-counter">

        <span id="lightbox-current">
          1
        </span>

        /

        <span>
          {gallery.length}
        </span>

      </div>

    </div>


    <Footer />


    <!-- =======================================================
         GALLERY SCRIPT
    ======================================================== -->

    <script>
      const items =
        Array.from(
          document.querySelectorAll<HTMLImageElement | HTMLVideoElement>(
            ".gallery-slider img, .gallery-slider video"
          )
        );

      const nextBtn =
        document.querySelector<HTMLButtonElement>(
          ".gallery-btn.next"
        );

      const prevBtn =
        document.querySelector<HTMLButtonElement>(
          ".gallery-btn.prev"
        );

      const lightbox =
        document.getElementById("lightbox");

      const lightboxImg =
        document.getElementById(
          "lightbox-img"
        ) as HTMLImageElement | null;

      const lightboxVideo =
        document.getElementById(
          "lightbox-video"
        ) as HTMLVideoElement | null;

      const closeBtn =
        document.querySelector<HTMLButtonElement>(
          ".lightbox .close"
        );

      const nextLightbox =
        document.querySelector<HTMLButtonElement>(
          ".lightbox-nav.next"
        );

      const prevLightbox =
        document.querySelector<HTMLButtonElement>(
          ".lightbox-nav.prev"
        );

      const galleryCurrent =
        document.getElementById(
          "gallery-current"
        );

      const lightboxCurrent =
        document.getElementById(
          "lightbox-current"
        );

      let index = 0;

      /* =====================================================
         SHOW ITEM
      ====================================================== */

      function showItem(newIndex: number) {
        if (!items.length) {
          return;
        }

        index =
          (newIndex + items.length) %
          items.length;

        items.forEach(
          (item, i) => {
            const isActive = i === index;

            item.classList.toggle(
              "active",
              isActive
            );

            if (item.tagName === "VIDEO") {
              const video = item as HTMLVideoElement;

              if (isActive) {
                video.play().catch(() => {});
              } else {
                video.pause();
                video.currentTime = 0;
              }
            }
          }
        );

        if (galleryCurrent) {
          galleryCurrent.textContent =
            String(index + 1);
        }
      }

      /* =====================================================
         NEXT / PREVIOUS
      ====================================================== */

      function nextItem() {
        showItem(index + 1);
      }

      function previousItem() {
        showItem(index - 1);
      }

      nextBtn?.addEventListener(
        "click",
        nextItem
      );

      prevBtn?.addEventListener(
        "click",
        previousItem
      );

      /* =====================================================
         LIGHTBOX
      ====================================================== */

      function renderLightbox() {
        if (
          !lightboxImg ||
          !lightboxVideo ||
          !items[index]
        ) {
          return;
        }

        const current = items[index];

        if (current.tagName === "VIDEO") {
          lightboxVideo.src = current.getAttribute("src") ?? "";
          lightboxVideo.style.display = "block";
          lightboxVideo.play().catch(() => {});

          lightboxImg.style.display = "none";
        } else {
          lightboxImg.src = (current as HTMLImageElement).src;
          lightboxImg.alt = (current as HTMLImageElement).alt;
          lightboxImg.style.display = "block";

          lightboxVideo.pause();
          lightboxVideo.style.display = "none";
        }

        if (lightboxCurrent) {
          lightboxCurrent.textContent =
            String(index + 1);
        }
      }

      function openLightbox(itemIndex: number) {
        if (
          !lightbox ||
          !items[itemIndex]
        ) {
          return;
        }

        index = itemIndex;

        renderLightbox();

        lightbox.classList.add("open");

        lightbox.setAttribute(
          "aria-hidden",
          "false"
        );

        document.body.style.overflow =
          "hidden";
      }

      function closeLightbox() {
        if (!lightbox) {
          return;
        }

        lightboxVideo?.pause();

        lightbox.classList.remove("open");

        lightbox.setAttribute(
          "aria-hidden",
          "true"
        );

        document.body.style.overflow =
          "";
      }

      function updateLightbox(direction: number) {
        lightboxVideo?.pause();

        showItem(
          index + direction
        );

        renderLightbox();
      }

      items.forEach(
        (item, i) => {
          item.addEventListener(
            "click",
            () => {
              openLightbox(i);
            }
          );
        }
      );

      nextLightbox?.addEventListener(
        "click",
        () => {
          updateLightbox(1);
        }
      );

      prevLightbox?.addEventListener(
        "click",
        () => {
          updateLightbox(-1);
        }
      );

      closeBtn?.addEventListener(
        "click",
        closeLightbox
      );

      document.addEventListener(
        "keydown",
        (event) => {
          if (
            lightbox?.classList.contains(
              "open"
            )
          ) {
            if (
              event.key ===
              "ArrowRight"
            ) {
              event.preventDefault();
              updateLightbox(1);
            }

            if (
              event.key ===
              "ArrowLeft"
            ) {
              event.preventDefault();
              updateLightbox(-1);
            }

            if (
              event.key ===
              "Escape"
            ) {
              event.preventDefault();
              closeLightbox();
            }

            return;
          }

          if (
            event.key ===
            "ArrowRight"
          ) {
            nextItem();
          }

          if (
            event.key ===
            "ArrowLeft"
          ) {
            previousItem();
          }
        }
      );

      lightbox?.addEventListener(
        "click",
        (event) => {
          if (
            event.target ===
            lightbox
          ) {
            closeLightbox();
          }
        }
      );

      showItem(0);
    </script>

  </body>
</html>


<style>
/* =========================================================
   Mismas clases base que experience.astro.
   ========================================================= */

.experience-bg {
  width: 100%;
  min-height: 100vh;
  margin: 0;
  padding: 3rem 0 5rem;
  background-image: url("/textures/paper-texture.png");
  background-size: cover;
  background-position: center;
  background-attachment: fixed;
  background-color: transparent;
  box-sizing: border-box;
  overflow-x: hidden;
}

.experience-shell {
  width: 100%;
  max-width: 1200px;
  margin: 1rem auto 0;
  padding: 2rem;
  background: rgba(255, 255, 255, 0.78);
