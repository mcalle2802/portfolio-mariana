</style>


<script define:vars={{ projects }}>
  const items = Array.from(
    document.querySelectorAll(".record-item")
  );

  const dots = Array.from(
    document.querySelectorAll(".collection-dot")
  );

  const track =
    document.querySelector(".records-track");

  const recordsWindow =
    document.querySelector(".records-window");

  const previousButton =
    document.querySelector(
      ".carousel-arrow.previous"
    );

  const nextButton =
    document.querySelector(
      ".carousel-arrow.next"
    );

  const openButton =
    document.querySelector(".open-project");

  const projectDetail =
    document.querySelector(".project-detail");

  const closeButton =
    document.querySelector(".close-detail");

  const currentNumber =
    document.getElementById(
      "current-number"
    );

  const previewTitle =
    document.getElementById(
      "preview-title"
    );

  const previewSubtitle =
    document.getElementById(
      "preview-subtitle"
    );

  const previewDescription =
    document.getElementById(
      "preview-description"
    );

  const detailTitle =
    document.getElementById(
      "detail-title"
    );

  const detailSubtitle =
    document.getElementById(
      "detail-subtitle"
    );

  const detailDescription =
    document.getElementById(
      "detail-description"
    );

  const detailImage =
    document.getElementById(
      "detail-cover-image"
    );

  const detailCoverNumber =
    document.getElementById(
      "detail-cover-number"
    );

  const detailVinylNumber =
    document.getElementById(
      "detail-vinyl-number"
    );

  const detailTechnologies =
    document.getElementById(
      "detail-technologies"
    );

  const detailLink =
    document.getElementById(
      "detail-link"
    );

  const previewViewLink =
    document.getElementById(
      "preview-view-link"
    );

  let selectedIndex = 0;


  /* =========================================================
     CENTER SELECTED RECORD
     ========================================================= */

  function centerSelectedRecord() {

    if (
      !track ||
      !recordsWindow ||
      !items[selectedIndex]
    ) {
      return;
    }

    const selected =
      items[selectedIndex];

    /*
     * We calculate the exact distance
     * between the center of the selected
     * record and the center of the window.
     *
     * This means:
     *
     * FIRST  → centered
     * MIDDLE → centered
     * LAST   → centered
     */

    const windowRect =
      recordsWindow.getBoundingClientRect();

    const selectedRect =
      selected.getBoundingClientRect();

    const windowCenter =
      windowRect.left +
      windowRect.width / 2;

    const selectedCenter =
      selectedRect.left +
      selectedRect.width / 2;

    const distance =
      selectedCenter -
      windowCenter;

    const currentTransform =
      getCurrentTranslateX();

    track.style.transform =
      `translateX(${currentTransform - distance}px)`;
  }


  function getCurrentTranslateX() {

    if (!track) {
      return 0;
    }

    const style =
      window.getComputedStyle(track);

    const matrix =
      new DOMMatrixReadOnly(
        style.transform
      );

    return matrix.m41;
  }


  /* =========================================================
     UPDATE PROJECT
     ========================================================= */

  function updateProject() {

    const project =
      projects[selectedIndex];

    if (!project) {
      return;
    }

    if (currentNumber) {
      currentNumber.textContent =
        project.number;
    }

    if (previewTitle) {
      previewTitle.textContent =
        project.title;
    }

    if (previewSubtitle) {
      previewSubtitle.textContent =
        project.subtitle;
    }

    if (previewDescription) {
      previewDescription.textContent =
        project.shortDescription;
    }

    if (previewViewLink) {
      previewViewLink.setAttribute(
        "href",
        `/projects/${project.slug}`
      );
    }

    items.forEach(
      (item, index) => {

        item.classList.toggle(
          "selected",
          index === selectedIndex
        );

      }
    );

    dots.forEach(
      (dot, index) => {

        dot.classList.toggle(
          "active",
          index === selectedIndex
        );

      }
    );


    /*
     * Wait one frame so the selected
     * record gets its new scale before
     * calculating its center.
     */

    requestAnimationFrame(
      () => {
        centerSelectedRecord();
      }
    );
  }


  /* =========================================================
     SELECT
     ========================================================= */

  function selectProject(index) {

    if (
      index < 0 ||
      index >= projects.length
    ) {
      return;
    }

    selectedIndex =
      index;

    updateProject();
  }


  function nextProject() {

    selectProject(
      (selectedIndex + 1) %
      projects.length
    );
  }


  function previousProject() {

    selectProject(
      (
        selectedIndex -
        1 +
        projects.length
      ) %
      projects.length
    );
  }


  /* =========================================================
     OPEN PROJECT
     ========================================================= */

  function openProject() {

    const project =
      projects[selectedIndex];

    if (
      !project ||
      !projectDetail
    ) {
      return;
    }

    if (detailTitle) {
      detailTitle.textContent =
        project.title;
    }

    if (detailSubtitle) {
      detailSubtitle.textContent =
        project.subtitle;
    }

    if (detailDescription) {
      detailDescription.textContent =
        project.description;
    }

    if (detailImage) {
      detailImage.src =
        project.image;

      detailImage.alt =
        project.title;
    }

    if (detailCoverNumber) {
      detailCoverNumber.textContent =
        project.number;
    }

    if (detailVinylNumber) {
      detailVinylNumber.textContent =
        project.number;
    }

    if (detailLink) {
      detailLink.setAttribute(
        "href",
        `/projects/${project.slug}`
      );
    }


    if (detailTechnologies) {

      detailTechnologies.innerHTML =
        "";

      project.technologies.forEach(
        (technology) => {

          const tag =
            document.createElement(
              "span"
            );

          tag.textContent =
            technology;

          detailTechnologies.appendChild(
            tag
          );

        }
      );

    }


    projectDetail.classList.add(
      "open"
    );

    projectDetail.setAttribute(
      "aria-hidden",
      "false"
    );

    document.body.style.overflow =
      "hidden";
  }


  /* =========================================================
     CLOSE
     ========================================================= */

  function closeProject() {

    if (!projectDetail) {
      return;
    }

    projectDetail.classList.remove(
      "open"
    );

    projectDetail.setAttribute(
      "aria-hidden",
      "true"
    );

    document.body.style.overflow =
      "";
  }


  /* =========================================================
     EVENTS
     ========================================================= */

  previousButton?.addEventListener(
    "click",
    previousProject
  );

  nextButton?.addEventListener(
    "click",
    nextProject
  );

  openButton?.addEventListener(
    "click",
    openProject
  );

  closeButton?.addEventListener(
    "click",
    closeProject
  );


  items.forEach(
    (item, index) => {

      const cover =
        item.querySelector(
          ".album-cover"
        );

      cover?.addEventListener(
        "click",
        () => {

          if (
            index !== selectedIndex
          ) {

            selectProject(index);

            return;
          }

          openProject();

        }
      );

    }
  );


  dots.forEach(
    (dot, index) => {

      dot.addEventListener(
        "click",
        () => {
          selectProject(index);
        }
      );

    }
  );


  document.addEventListener(
    "keydown",
    (event) => {

      if (
        projectDetail?.classList.contains(
          "open"
        )
      ) {

        if (
          event.key ===
          "Escape"
        ) {
          closeProject();
        }

        return;
      }


      if (
        event.key ===
        "ArrowRight"
      ) {
        nextProject();
      }


      if (
        event.key ===
        "ArrowLeft"
      ) {
        previousProject();
      }


      if (
        event.key ===
        "Enter"
      ) {
        openProject();
      }

    }
  );


  window.addEventListener(
    "resize",
    () => {

      /*
       * Reset the transform before
       * recalculating the center.
       */

      if (track) {
        track.style.transform =
          "translateX(0)";
      }

      requestAnimationFrame(
        () => {
          centerSelectedRecord();
        }
      );

    }
  );


  /*
   * Initial state
   */

  updateProject();
</script>