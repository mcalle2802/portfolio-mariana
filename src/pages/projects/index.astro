---
import "../../styles/global.css";
import Navbar from "../../components/Navbar.astro";
import Footer from "../../components/Footer.astro";

const projects = [
  {
    slug: "scara",
    title: "SCARA Robot",
    subtitle: "Built from Scratch",
    description:
      "A 3-DOF SCARA robot designed and constructed from scratch for an automated welding application, integrating mechanical design, control with Raspberry Pi Pico, and kinematic simulation in MATLAB.",
    shortDescription:
      "A SCARA robot built from scratch for automated welding, combining mechanical design, control, and kinematic simulation.",
    technologies: [
      "Raspberry Pi Pico",
      "Solid Edge",
      "Control Systems",
      "MATLAB",
    ],
    image: "/projects/scara.jpeg",
    number: "01",
    label: "BUILT FROM SCRATCH",
  },

  {
    slug: "robot",
    title: "Differential Drive Robot",
    subtitle: "Little Navigator",
    description:
      "A differential mobile robot designed and built from scratch, integrating ROS2 simulation with real-world control using a Raspberry Pi Pico, encoders, and a dual motor driver for accurate navigation between waypoints.",
    shortDescription:
      "A differential mobile robot combining ROS2 simulation with real-world control and waypoint navigation.",
    technologies: [
      "ROS2",
      "Control Systems",
      "Encoders",
      "Raspberry Pi Pico",
    ],
    image: "/projects/car.jpeg",
    number: "02",
    label: "MOBILE ROBOT",
  },

  {
    slug: "hovercraft",
    title: "Racing Hovercraft",
    subtitle: "The Flying Machine",
    description:
      "High-speed hovercraft engineered for autonomous racing. Features air-cushion propulsion, real-time vision processing with Raspberry Pi, and precise motor control via Arduino and ESCs.",
    shortDescription:
      "A high-speed hovercraft prototype combining air-cushion propulsion, computer vision, and motor control.",
    technologies: [
      "Raspberry Pi 2",
      "Arduino",
      "Computer Vision",
      "ESC",
      "3D Printing",
    ],
    image: "/projects/hovercraft.jpeg",
    number: "03",
    label: "PROTOTYPE",
  },

  {
    slug: "iot",
    title: "Smart Home IoT",
    subtitle: "Connected Systems",
    description:
      "A smart home automation project designed for real-time monitoring and control of home devices using ESP32, MQTT, and cloud integration. Combines backend (PHP, MySQL) and frontend (Grafana) for seamless visualization and automation.",
    shortDescription:
      "A connected home system combining ESP32 devices, MQTT, databases, and real-time visualization.",
    technologies: [
      "ESP32",
      "MQTT",
      "Node.js",
      "MySQL",
      "Grafana",
    ],
    image: "/projects/iot.jpeg",
    number: "04",
    label: "CONNECTED SYSTEM",
  },

  {
    slug: "underwater",
    title: "S.U.S.D.E.M",
    subtitle: "Underwater Explorer",
    description:
      "An autonomous underwater vehicle designed to monitor eutrophication indicators such as pH and turbidity. Built with ESP32 microcontrollers, waterproof electronics, and a modular PLA-PVC structure for reliable underwater operation.",
    shortDescription:
      "An underwater monitoring system designed to measure environmental indicators such as pH and turbidity.",
    technologies: [
      "ESP32",
      "Sensors",
      "I2C",
      "Environmental Monitoring",
    ],
    image: "/projects/underwater.jpeg",
    number: "05",
    label: "UNDERWATER SYSTEM",
  },

  {
    slug: "cattree",
    title: "Cat Tree & Activity Gym",
    subtitle: "The Feline Playground",
    description:
      "A custom-designed three-level cat tree created to encourage climbing, scratching, play, and exercise. Designed in Solid Edge with CNC-manufactured plywood panels, PVC tubes wrapped in rope for scratching, and reinforced screws for stability and safety.",
    shortDescription:
      "A custom three-level structure designed in Solid Edge to encourage climbing, scratching, play, and exercise.",
    technologies: [
      "Solid Edge",
      "CNC Machining",
      "Design for Pets",
      "3D Modeling",
    ],
    image: "/projects/cattree.jpeg",
    number: "06",
    label: "CUSTOM DESIGN",
  },
];

const totalProjects = projects.length;
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />

    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0"
    />

    <title>Projects — Mariana Calle</title>

    <meta
      name="description"
      content="Engineering projects by Mariana Calle Méndez."
    />
  </head>

  <body>
    <Navbar />

    <!--
      La textura de fondo, el overflow-x:hidden y el patrón
      max-width + margin auto para el "shell" son los mismos
      que en experience.astro y certifications.astro, para
      mantener la misma estética y el mismo centrado simétrico
      en todas las páginas.
    -->

    <main class="projects-bg">
      <div class="projects-shell">

        <!-- =====================================================
             HEADER CARD
             ===================================================== -->

        <section class="projects-header-card">

          <div class="header-content">

            <p class="section-label">
              ENGINEERING COLLECTION
            </p>

            <h1>PROJECTS</h1>

            <p class="header-description">
              Engineering meets creativity — prototypes,
              systems, and ideas brought into the physical world.
            </p>

          </div>

        </section>


        <!-- =====================================================
             VINYL COLLECTION CARD
             ===================================================== -->

        <section class="projects-collection-card">

          <div class="collection-heading">

            <div>
              <p class="collection-label">
                THE COLLECTION
              </p>

              <h2>
                SELECT A PROJECT
              </h2>
            </div>

            <div class="collection-counter">
              <span id="current-number">01</span>
              <span>/</span>
              <span>
                {String(totalProjects).padStart(2, "0")}
              </span>
            </div>

          </div>


          <!-- VINYL CAROUSEL -->

          <div class="vinyl-carousel">

            <button
              class="carousel-arrow previous"
              type="button"
              aria-label="Previous project"
            >
              ←
            </button>


            <div class="records-window">

              <div class="records-track">

                {
                  projects.map((project, index) => (
                    <article
                      class:list={[
                        "record-item",
                        {
                          selected: index === 0,
                        },
                      ]}
                      data-index={index}
                    >

                      <!-- VINYL -->

                      <div class="vinyl">

                        <div class="vinyl-grooves"></div>

                        <div class="vinyl-label">

                          <span>
                            MC
                          </span>

                          <small>
                            {project.number}
                          </small>

                        </div>

                        <div class="vinyl-hole"></div>

                      </div>


                      <!-- ALBUM COVER -->

                      <button
                        class="album-cover"
                        type="button"
                        aria-label={`Select ${project.title}`}
                      >

                        <div class="cover-inner">

                          <div class="cover-border"></div>


                          <div class="cover-top">

                            <span>
                              NO. {project.number}
                            </span>

                            <span>
                              MC
                            </span>

                          </div>


                          <div class="cover-title">

                            <h3>
                              {project.title}
                            </h3>

                            <p>
                              {project.subtitle}
                            </p>

                          </div>


                          <div class="cover-image">

                            <img
                              src={project.image}
                              alt={project.title}
                            />

                          </div>


                          <div class="cover-bottom">

                            <span>★</span>

                            <span>
                              {project.label}
                            </span>

                            <span>★</span>

                          </div>

                        </div>

                      </button>

                    </article>
                  ))
                }

              </div>

            </div>


            <button
              class="carousel-arrow next"
              type="button"
              aria-label="Next project"
            >
              →
            </button>

          </div>


          <!-- PROJECT PREVIEW -->

          <div class="project-preview">

            <div class="preview-heading">

              <p class="preview-label">
                SELECTED PROJECT
              </p>

              <h2 id="preview-title">
                {projects[0].title}
              </h2>

              <p id="preview-subtitle">
                {projects[0].subtitle}
              </p>

            </div>


            <p
              id="preview-description"
              class="preview-description"
            >
              {projects[0].shortDescription}
            </p>


            <div class="preview-actions">

              <button
                class="open-project"
                type="button"
              >
                <span>
                  PREVIEW PROJECT
                </span>

                <span>
                  →
                </span>
              </button>

              <a
                id="preview-view-link"
                class="open-project view-full"
                href={`/projects/${projects[0].slug}`}
              >
                <span>
                  VIEW FULL PROJECT
                </span>

                <span>
                  →
                </span>
              </a>

            </div>

          </div>


          <!-- DOTS -->

          <div class="collection-navigation">

            <div class="collection-dots">

              {
                projects.map((project, index) => (
                  <button
                    type="button"
                    class:list={[
                      "collection-dot",
                      {
                        active: index === 0,
                      },
                    ]}
                    data-index={index}
                    aria-label={`Select ${project.title}`}
                  ></button>
                ))
              }

            </div>

            <p>
              USE THE ARROWS OR SELECT A RECORD
            </p>

          </div>

        </section>

      </div>
    </main>


    <!-- =========================================================
         PROJECT DETAIL
         ========================================================= -->

    <section
      class="project-detail"
      aria-hidden="true"
    >

      <div class="detail-background"></div>

      <div class="detail-card">

        <button
          class="close-detail"
          type="button"
          aria-label="Close project"
        >
          ×
        </button>


        <div class="detail-record">

          <div class="detail-vinyl">

            <div class="detail-vinyl-grooves"></div>

            <div class="detail-vinyl-label">

              <span id="detail-vinyl-number">
                01
              </span>

              <small>
                MC
              </small>

            </div>

            <div class="detail-vinyl-hole"></div>

          </div>


          <div class="detail-cover">

            <img
              id="detail-cover-image"
              src={projects[0].image}
              alt={projects[0].title}
            />

            <div class="detail-cover-number">
              NO.
              <strong id="detail-cover-number">
                01
              </strong>
            </div>

          </div>

        </div>


        <div class="detail-content">

          <p class="detail-eyebrow">
            SELECTED PROJECT
          </p>

          <h2 id="detail-title">
            {projects[0].title}
          </h2>

          <p
            id="detail-subtitle"
            class="detail-subtitle"
          >
            {projects[0].subtitle}
          </p>


          <div class="detail-line"></div>


          <div class="detail-section">

            <h3>
              ABOUT THE PROJECT
            </h3>

            <p id="detail-description">
              {projects[0].description}
            </p>

          </div>


          <div class="detail-section">

            <h3>
              TECHNOLOGIES
            </h3>

            <div
              id="detail-technologies"
              class="technology-list"
            >
              {
                projects[0].technologies.map(
                  (technology) => (
                    <span>{technology}</span>
                  )
                )
              }
            </div>

          </div>


          <a
            id="detail-link"
            class="view-project"
            href={`/projects/${projects[0].slug}`}
          >
            VIEW PROJECT
            <span>→</span>
          </a>

        </div>

      </div>

    </section>


    <Footer />

  </body>
</html>


<style>

  /* =========================================================
     PAGE BACKGROUND + SHELL
     Mismo patrón que .experience-bg / .experience-shell:
     textura de papel, overflow-x oculto para evitar que
     cualquier elemento interno desalinee el centrado, y
     max-width + margin auto en vez de width:min(...) para
     que el recuadro quede simétrico en cualquier ancho.
     ========================================================= */

  .projects-bg {
    width: 100%;
    min-height: 100vh;
    margin: 0;
    padding: 3rem 0 5rem;
    background-image: url("/textures/paper-texture.png");
    background-size: cover;
    background-position: center;
    background-attachment: fixed;
    background-color: transparent;
    box-sizing: border-box;
    overflow-x: hidden;
  }

  .projects-shell {
    width: 100%;
    max-width: 1200px;
    margin: 1rem auto 0;
    padding: clamp(1rem, 4vw, 2rem);

    background: rgba(255, 255, 255, 0.78);
    border: 1px solid rgba(0, 0, 0, 0.05);
    border-radius: 16px;

    box-shadow: 0 4px 25px rgba(0, 0, 0, 0.08);
    backdrop-filter: blur(4px);
    box-sizing: border-box;
  }

  .projects-shell section {
    width: 100%;
    margin: 0 0 clamp(2rem, 4vw, 3rem);
    padding: clamp(1.25rem, 4vw, 2rem);

    background: rgba(255, 255, 255, 0.8);
    border: 1px solid rgba(0, 0, 0, 0.05);
    border-radius: 12px;

    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.05);
    backdrop-filter: blur(4px);
    box-sizing: border-box;
  }

  .projects-shell section:last-child {
    margin-bottom: 0;
  }


  /* =========================================================
     HEADER CARD
     Misma estructura que .experience-header: section-label,
     título centrado y ancho contenido, párrafo de intro.
     ========================================================= */

  .projects-shell .projects-header-card {
    position: relative;
    width: 100%;
    max-width: 950px;
    margin: 0 auto clamp(2rem, 4vw, 3rem);
    text-align: center;
    overflow: hidden;
  }

  .projects-header-card h1 {
    margin: 0;
  }

  .header-content {
    position: relative;
    z-index: 2;
  }

  .section-label {
    margin: 0 0 0.8rem;

    color: var(--color-accent);

    font-size: 0.75rem;
    font-weight: 700;

    letter-spacing: 0.18em;
  }

  .projects-header-card h1 {
    margin: 0;

    color: var(--color-deep);

    font-size:
      clamp(2.3rem, 6.5vw, 4.6rem);

    line-height: 1.05;
    letter-spacing: -0.01em;
    overflow-wrap: break-word;
  }

  .header-description {
    width: min(650px, 100%);

    margin: 1.25rem auto 0;

    color: var(--color-text);

    font-size: 0.95rem;
    line-height: 1.6;
  }


  /* =========================================================
     COLLECTION CARD
     ========================================================= */

  .projects-shell .projects-collection-card {
    margin-top: 0;

    padding:
      clamp(1.25rem, 4vw, 2.5rem)
      clamp(1rem, 3vw, 2rem);

    background: rgba(255, 255, 255, 0.82);

    border: 1px solid rgba(0, 0, 0, 0.05);
    border-radius: 12px;

    box-shadow:
      0 4px 20px rgba(0, 0, 0, 0.05);

    overflow: hidden;
  }


  /* =========================================================
     COLLECTION HEADER
     ========================================================= */

  .collection-heading {
    display: flex;

    justify-content: space-between;
    align-items: end;

    gap: 1rem;

    margin-bottom: 0.5rem;
  }

  .collection-label {
    margin: 0 0 0.25rem;

    color: var(--color-deep);

    font-size: 0.6rem;
    font-weight: 700;

    letter-spacing: 2px;
  }

  .collection-heading h2 {
    margin: 0;

    font-size:
      clamp(1.3rem, 3vw, 2rem);
  }

  .collection-counter {
    display: flex;

    gap: 0.25rem;

    color: var(--color-deep);

    font-family: var(--font-title);

    font-size: 0.8rem;

    letter-spacing: 1px;

    white-space: nowrap;
  }

  #current-number {
    color: var(--color-accent);
  }


  /* =========================================================
     VINYL CAROUSEL
     ========================================================= */

  .vinyl-carousel {
    display: flex;

    align-items: center;

    width: 100%;

    margin-top: 0.5rem;

    gap: clamp(0.4rem, 1.5vw, 1rem);
  }

  .records-window {
    position: relative;

    flex: 1;

    min-width: 0;

    overflow: hidden;

    /*
     * Vertical space for the vinyl.
     */
    padding:
      2.5rem 0
      2rem;
  }

  .records-track {
    display: flex;

    align-items: center;

    width: max-content;

    /*
     * This padding is crucial:
     * it allows FIRST and LAST records
     * to reach the exact center.
     */
    padding-left:
      calc(
        (100% - 100%) / 2
      );

    padding-right:
      calc(
        (100% - 100%) / 2
      );

    gap:
      clamp(1.5rem, 4vw, 3rem);

    transition:
      transform 0.7s
      cubic-bezier(0.22, 1, 0.36, 1);
  }

  .record-item {
    position: relative;

    flex:
      0 0
      clamp(210px, 25vw, 280px);

    height:
      clamp(290px, 34vw, 370px);

    display: flex;

    align-items: center;
    justify-content: center;

    transition:
      transform 0.6s ease,
      opacity 0.6s ease,
      filter 0.6s ease;
  }

  .record-item:not(.selected) {
    opacity: 0.48;

    transform: scale(0.78);

    filter: saturate(0.65);
  }

  .record-item.selected {
    z-index: 10;

    opacity: 1;

    transform: scale(1);
  }


  /* =========================================================
     VINYL
     ========================================================= */

  .vinyl {
    position: absolute;

    z-index: 1;

    /*
     * Bigger than before.
     */
    width: 96%;

    aspect-ratio: 1;

    /*
     * More of the record comes out
     * from behind the sleeve.
     */
    right: -38%;

    top: 7%;

    border-radius: 50%;

    background:
      radial-gradient(
        circle at center,
        #171717 0 7%,
        var(--color-accent) 7.5% 17%,
        #171717 17.5% 100%
      );

    box-shadow:
      0 12px 25px
      rgba(0, 0, 0, 0.25),

      inset 0 0 0 1px
      rgba(255, 255, 255, 0.08);
  }

  .vinyl::before,
  .vinyl::after {
    content: "";

    position: absolute;

    border-radius: 50%;

    border:
      1px solid
      rgba(255, 255, 255, 0.08);
  }

  .vinyl::before {
    inset: 8%;
  }

  .vinyl::after {
    inset: 20%;
  }

  .vinyl-grooves {
    position: absolute;

    inset: 11%;

    border-radius: 50%;

    background:
      repeating-radial-gradient(
        circle,

        transparent 0,
        transparent 4px,

        rgba(255, 255, 255, 0.025) 5px,

        transparent 6px
      );
  }

  .vinyl-label {
    position: absolute;

    z-index: 3;

    inset: 41%;

    display: flex;

    flex-direction: column;

    align-items: center;
    justify-content: center;

    border-radius: 50%;

    background:
      var(--color-accent);

    color:
      var(--color-paper);

    font-family:
      var(--font-title);

    line-height: 1;

    text-align: center;
  }

  .vinyl-label span {
    font-size: 0.7rem;
  }

  .vinyl-label small {
    margin-top: 0.25rem;

    font-size: 0.45rem;
  }

  .vinyl-hole {
    position: absolute;

    z-index: 4;

    top: calc(50% - 2.5px);
    left: calc(50% - 2.5px);

    width: 5px;
    height: 5px;

    border-radius: 50%;

    background: #111;
  }


  /* =========================================================
     ALBUM COVER
     ========================================================= */

  .album-cover {
    position: absolute;

    z-index: 4;

    left: 0;

    top: 2%;

    width: 74%;
    height: 92%;

    padding: 0;

    border: none;

    background: transparent;

    cursor: pointer;

    text-align: left;
  }

  .cover-inner {
    position: relative;

    width: 100%;
    height: 100%;

    padding:
      clamp(0.8rem, 1.5vw, 1.15rem);

    display: flex;

    flex-direction: column;

    justify-content: space-between;

    background:
      linear-gradient(
        145deg,
        rgba(245, 241, 235, 0.98),
        rgba(224, 207, 180, 0.98)
      );

    border:
      1px solid
      rgba(75, 46, 31, 0.35);

    box-shadow:
      5px 9px 18px
      rgba(0, 0, 0, 0.18);

    overflow: hidden;

    transition:
      transform 0.45s ease,
      box-shadow 0.45s ease;
  }

  .cover-border {
    position: absolute;

    inset: 7px;

    border:
      1px solid
      rgba(185, 60, 26, 0.45);

    pointer-events: none;
  }

  .album-cover:hover
  .cover-inner {
    transform:
      translateY(-5px)
      rotate(-1deg);

    box-shadow:
      7px 14px 22px
      rgba(0, 0, 0, 0.2);
  }

  .cover-top {
    position: relative;

    z-index: 2;

    display: flex;

    justify-content: space-between;

    color:
      var(--color-deep);

    font-family:
      var(--font-title);

    font-size: 0.5rem;

    letter-spacing: 1px;
  }

  .cover-title {
    position: relative;

    z-index: 2;

    text-align: center;

    margin:
      0.5rem 0;
  }

  .cover-title h3 {
    margin: 0;

    color:
      var(--color-accent);

    font-family:
      var(--font-title);

    font-size:
      clamp(0.85rem, 1.6vw, 1.15rem);

    line-height: 0.95;

    letter-spacing: 1px;
  }

  .cover-title p {
    margin:
      0.35rem 0 0;

    color:
      var(--color-deep);

    font-family:
      var(--font-title);

    font-size:
      clamp(0.42rem, 0.75vw, 0.58rem);

    letter-spacing: 1px;

    text-transform: uppercase;
  }

  .cover-image {
    position: relative;

    z-index: 2;

    width: 100%;

    flex: 1;

    min-height: 0;

    margin: 0.4rem 0;

    overflow: hidden;

    border:
      1px solid
      rgba(75, 46, 31, 0.35);

    background:
      var(--color-deep);
  }

  .cover-image img {
    width: 100%;
    height: 100%;

    object-fit: cover;

    filter:
      sepia(0.12)
      saturate(0.85);
  }

  .cover-bottom {
    position: relative;

    z-index: 2;

    display: flex;

    justify-content: center;
    align-items: center;

    gap: 0.4rem;

    color:
      var(--color-deep);

    font-family:
      var(--font-title);

    font-size: 0.47rem;

    letter-spacing: 0.8px;

    text-align: center;
  }


  /* =========================================================
     ARROWS
     ========================================================= */

  .carousel-arrow {
    position: relative;

    z-index: 20;

    flex:
      0 0
      clamp(34px, 4vw, 44px);

    width:
      clamp(34px, 4vw, 44px);

    height:
      clamp(34px, 4vw, 44px);

    border:
      1px solid
      rgba(185, 60, 26, 0.35);

    border-radius: 50%;

    background:
      rgba(255, 255, 255, 0.65);

    color:
      var(--color-accent);

    cursor: pointer;

    transition:
      background 0.25s ease,
      color 0.25s ease,
      transform 0.25s ease;
  }

  .carousel-arrow:hover {
    background:
      var(--color-accent);

    color:
      var(--color-bg);

    transform:
      scale(1.08);
  }


  /* =========================================================
     PREVIEW
     ========================================================= */

  .project-preview {
    width:
      min(720px, 100%);

    margin:
      0 auto;

    padding:
      0.5rem
      1rem
      1.5rem;

    text-align: center;
  }

  .preview-label {
    margin:
